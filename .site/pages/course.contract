// /course (reference app/course/page.tsx and components/landing/tabs/learn): the Reanimate.dev header, rising in
// (framer: 20 px, 400 ms, cubic-bezier(.25,.46,.45,.94)), its link, and the testimonials in balanced columns (1, 2
// from 768 px, 3 from 1024 px: web/head.css `masonry`), each a flat card that darkens under the pointer.
use md, sm from "../components/responsive.contract"

shape Testimonial
  author: string
  role: string
  content: string
  avatar: string
  url: string
  x: bool

fn testimonials(): Testimonial[] = [
  Testimonial(author="Expo", role="The platform for making universal apps", content="If you ever get a chance to see @reactiive_ speak don't miss it. He's a unique talent and a great teacher.", avatar="/assets/images/avatars/expo.jpg", url="https://x.com/expo/status/2006138768143585652", x=true),
  Testimonial(author="Infinite Red", role="Creators of ChainReactConf, Ignite, and more", content="Open sourced 'Demos'… a collection of React Native animation examples. Extremely useful!", avatar="/assets/images/avatars/infinite-red.jpg", url="https://x.com/infinite_red/status/2006100939535794348", x=true),
  Testimonial(author="Vadim Savin", role="notJust.dev", content="Shoutout to Demos by @reactiive_", avatar="/assets/images/avatars/vadim-savin.jpg", url="https://x.com/VadimNotJustDev/status/1991917929647190366", x=true),
  Testimonial(author="baam", role="Software Engineer", content="Your Demos are sick and very useful, big thanks", avatar="/assets/images/avatars/baam.jpg", url="https://x.com/TheBaamAhmed/status/1995915882074169358", x=true),
  Testimonial(author="Hirbod", role="Software Engineer", content="One of the best React Native animation resources out there—beautifully crafted, clean, and stunning. Sign up, worth every penny!", avatar="/assets/images/avatars/hirbod.jpg", url="https://x.com/hirbod_dev/status/1866936168895611088", x=true),
  Testimonial(author="Daniel Nguyen", role="Software Engineer", content="Check out this exclusive collection of React Native animations", avatar="/assets/images/avatars/daniel-nguyen.jpg", url="https://x.com/hey_thien/status/1971202721916256447", x=true),
  Testimonial(author="Rafa", role="Software Engineer", content="I use the toast component from @reactiive_ and it works fantastic", avatar="/assets/images/avatars/rafa-muttoni.jpg", url="https://x.com/rafaelmuttoni/status/1986087498389307680", x=true),
  Testimonial(author="Upendra Sahni", role="Software Engineer", content="Thanks to @reactiive_ for the fantastic tutorials… Your videos made it so much easier to learn", avatar="/assets/images/avatars/upendra-sahni.jpg", url="https://x.com/Upendra17916450/status/1797250824328073527", x=true),
  Testimonial(author="Lennart Brandt", role="Software Engineer", content="Huge thanks to @reactiive_ for the awesome YouTube explanation on layout transitions!", avatar="/assets/images/avatars/lennart-brandt.jpg", url="https://x.com/brandtnewlabs/status/1880262760174588006", x=true),
  Testimonial(author="Daniel Friyia", role="Software Engineer", content="@reactiive_ is the master of creative QRCodes", avatar="/assets/images/avatars/daniel-friyia.jpg", url="https://x.com/wa2goose/status/2005037188124418313", x=true),
  Testimonial(author="Miru", role="Software Engineer", content="Thanks to the inspiration from @reactiive_… building great user experiences has become relatively simple", avatar="/assets/images/avatars/miru.jpg", url="https://x.com/MiruDaws/status/1775548694785601884", x=true),
  Testimonial(author="Just Patrick", role="Software Engineer", content="Learn from the goats @reactiive_ and @wcandillon", avatar="/assets/images/avatars/just-patrick.jpg", url="https://x.com/PnTX10/status/1768383774344007913", x=true),
  Testimonial(author="Abinash Karmakar", role="Software Engineer", content="Inspired by @reactiive_'s video, I implemented a 3D wallet card", avatar="/assets/images/avatars/abinash-karmakar.jpg", url="https://x.com/codeAbinash/status/1814608446102381036", x=true),
  Testimonial(author="hamed", role="Software Engineer", content="Inspired me to learn skia/reanimated in-depth", avatar="/assets/images/avatars/hamed.jpg", url="https://x.com/hamedmp/status/1942336266982314423", x=true),
  Testimonial(author="mr asante", role="Software Engineer", content="Big thanks to @wcandillon and @reactiive_", avatar="/assets/images/avatars/mr-asante.jpg", url="https://x.com/k_asante10/status/1732523640590115297", x=true),
  Testimonial(author="Evan Bacon", role="Creator of Expo Router", content="Check out this beautiful Expo website for exploring Enzo's animation collection! Exciting to see web adoption pick up so much!", avatar="/assets/images/avatars/bacon.jpg", url="https://x.com/Baconbrix/status/1882963868919673320", x=true),
  Testimonial(author="Christian Falch", role="React Native Skia co-Creator", content="Amazing and inspiring.", avatar="/assets/images/avatars/christian-falch.jpg", url="https://bsky.app/profile/chrfalch.bsky.social/post/3ld4ipbmxf22k", x=false),
  Testimonial(author="Beto", role="Dev Success @Expo", content="What a great resource 👏", avatar="/assets/images/avatars/beto.jpg", url="https://bsky.app/profile/codewithbeto.dev/post/3ld4gogkii22a", x=false),
