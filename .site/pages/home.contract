// "/": the reference's app/page.tsx. Each block rises 10 px out of a 12 px blur, top to bottom (motion-blur-in, 900 ms,
// cubic-bezier(.22,1,.36,1), delays 80-650 ms: web/head.css, docs/decisions.md D11); the hand waves 4 times.
use md from "../components/responsive.contract"
use Newsletter from "../components/newsletter.contract"

style Caption
  font-size="0.875rem" line-height="1.25rem" color="var(--color-text-tertiary)"

component ProjectItem
  props
    title: string
    description: string
    tag: string
    href: string
    newPage: bool
  view
    link href=href target=(newPage ? "_blank" : "_self") display="flex" flex-direction="column" -exact-hover-effect="none"
      column padding="16px 12px" margin="0 -12px" border-radius="var(--radius-md)"
        :hover
          background-color = "rgba(30, 30, 32, 0.5)"
        row justify-content="space-between" align-items="baseline"
          text title font-weight=500 color="var(--color-text-primary)"
          text tag class=Caption
        text description class=Caption margin-top=4

component HomePage
  props
    newsletterStatus: string
    subscribe: action
  view
    column gap=24 max-width="42rem" margin-top=md(32, 96) margin-bottom=12
      row data-motion="blur-in rise" data-delay="80"
        view transform-origin="bottom" data-motion="wave"
          text "👋🏻" display="block" padding-bottom=10 font-size=32 line-height="normal" color="#000000" font-family="system-ui"
      column data-motion="blur-in rise" data-delay="170"
        text "Hey, I'm Enzo." role="heading" aria-level=1 font-size=16 line-height="1.5rem" font-weight=400 color="var(--color-text-body)"
      column data-motion="blur-in rise" data-delay="250"
        text "I have a passion for creating animations and enjoy sharing my insights along the way. That's what this blog is all about."
    column data-motion="blur-in rise" data-delay="350"
      Newsletter(showTitle=false, status=newsletterStatus, subscribe=subscribe)
    column margin-top=56
      column data-motion="blur-in rise" data-delay="470"
        text "Projects" class=Caption text-transform="uppercase" letter-spacing="0.1em" margin-bottom=16
      column data-motion="blur-in rise" data-delay="530"
        ProjectItem(title="Reanimate.dev", href="https://reanimate.dev", tag="Course", description="Designed to guide you from the basics to advanced techniques.", newPage=true)
      column data-motion="blur-in rise" data-delay="590"
        ProjectItem(title="Demos", href="/demos/", tag="Open Source", description="120+ React Native experiments and demos.", newPage=false)
      column data-motion="blur-in rise" data-delay="650"
        ProjectItem(title="YouTube", href="https://youtube.com/@Reactiive", tag="Tutorials", description="React Native tutorials and animation breakdowns.", newPage=true)
