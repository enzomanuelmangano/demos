{
  "$schema": ".exact/checkout/scripts/app.schema.json",
  "name": "Reactiive",
  "short_name": "Reactiive",
  "id": "io.reactiive.site",
  "start_url": "/",
  "display": "standalone",
  "app": {
    "id": "io.reactiive.site",
    "name": "Reactiive",
    "origin": "https://reactiive.io"
  },
  "host": {
    "web": {
      "head": [
        {
          "link": {
            "rel": "preload",
            "href": "./assets/fonts/InterVariable.woff2",
            "as": "font",
            "type": "font/woff2",
            "crossorigin": ""
          }
        },
        {
          "script": {
            "text": "(function(){var s=document.createElement('style');s.textContent=\"@font-face{font-family:Inter;src:url(/assets/fonts/InterVariable.woff2) format('woff2');font-weight:100 900;font-style:normal;font-display:swap}@font-face{font-family:'Source Code Pro';src:url(/assets/fonts/SourceCodePro_400Regular.woff2) format('woff2');font-weight:400;font-style:normal;font-display:swap}body{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility}::selection{background:#262935db;color:#ffffffdb}\";document.head.appendChild(s)})();"
          }
        }
      ]
    }
  },
  "deploy": {
    "store": {
      "web": "0"
    }
  }
}
