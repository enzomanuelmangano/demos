// An article's interactive demo, as its MDX names it: the `demo` blocks of tools/gen-content.ts (DEMOS there).
// `article` and `name` pick the export; `at` is the block's id, unique on its page, so the same export twice on a page
// (animated-spiral shows AnimatedSpiralWithSkia at its top and its end) keys two canvases, two memories; `args` is its
// props as the converter wrote them, every prop given
// (`hasBackdrop=true`, `scaleAnimationType="spring", showBorderRadiusAnimation=false`: the converter checked each
// name and value against the reference's); `boxed` puts it in the article's InteractiveBox, as the MDX does.
// Each demo draws its own frame and the space under it (docs/progress-comp-gesture.md, progress-comp-canvas.md).
// No ancestor between a demo and the page's scroller may clip: the lazy mount and the off-screen pause observe it.
use InteractiveBox as SheetBox, InitialSetup, BasicComponent, PanGesture, BorderRadius, FinalDemo from "./bottom-sheet-animation/index.contract"
use InteractiveBox as CssBox, AnimatedSquare from "./css-animations-react-native/index.contract"
use Demo as CheckboxDemo, StaticDemo as CheckboxStaticDemo from "./checkbox-interactions/index.contract"
use IntroToGesturesDemo from "./introduction-to-gestures/index.contract"
use FinalAnimatedSquareDemo, AnimatedSquareOpacityDemo, AnimatedSquareOpacityAndScaleDemo from "./introduction-to-reanimated/index.contract"
use InteractivePanGesture from "./pan-gesture-handler/index.contract"
use InteractiveSkeletonDemo, InteractiveContactItem, InteractiveJustSkeleton from "./skeleton-loader/index.contract"
use AnimatedGradientInteractive from "./animated-gradient/animated-gradient.contract"
use AnimatedLoaderSkiaInteractive from "./animated-loader-skia/animated-loader-skia.contract"
use AnimatedSpiralInteractive from "./animated-spiral/animated-spiral.contract"
use MetaballInteractive from "./metaball/metaball.contract"

component ArticleDemo
  props
    article: string
    name: string
    args: string
    at: string
  view
    if article == "bottom-sheet-animation"
      SheetBox()
        BottomSheetDemo(name=name, args=args)
    else if article == "css-animations-react-native"
      CssBox()
        AnimatedSquare(withoutRepeat=args.includes("withoutRepeat=true"), withoutPause=args.includes("withoutPause=true"))
    else if article == "checkbox-interactions"
      if name == "StaticDemo"
        CheckboxStaticDemo()
      else
        CheckboxDemo()
    else if article == "introduction-to-gestures"
      IntroToGesturesDemo()
    else if article == "introduction-to-reanimated"
      if name == "AnimatedSquareOpacityDemo"
        AnimatedSquareOpacityDemo()
      else if name == "AnimatedSquareOpacityAndScaleDemo"
        AnimatedSquareOpacityAndScaleDemo(scaleAnimationType=(args.includes("scaleAnimationType=\u0022spring") ? "spring" : "timing"), showBorderRadiusAnimation=args.includes("showBorderRadiusAnimation=true"))
      else
        FinalAnimatedSquareDemo()
    else if article == "pan-gesture-handler"
      InteractivePanGesture()
    else if article == "skeleton-loader"
      if name == "InteractiveContactItem"
        InteractiveContactItem()
      else if name == "InteractiveJustSkeleton"
        InteractiveJustSkeleton()
      else
        InteractiveSkeletonDemo()
    else if article == "animated-gradient"
      AnimatedGradientInteractive(name=name, at=at)
    else if article == "animated-loader-skia"
      AnimatedLoaderSkiaInteractive(name=name, at=at)
    else if article == "animated-spiral"
      AnimatedSpiralInteractive(name=name, at=at)
    else if article == "metaball"
      MetaballInteractive(name=name, at=at)

component BottomSheetDemo
  props
    name: string
    args: string
  view
    if name == "InitialSetup"
      InitialSetup()
    else if name == "BasicComponent"
      BasicComponent()
    else if name == "PanGesture"
      PanGesture()
    else if name == "BorderRadius"
      BorderRadius()
    else
      FinalDemo(hasBackdrop=args.includes("hasBackdrop=true"))
