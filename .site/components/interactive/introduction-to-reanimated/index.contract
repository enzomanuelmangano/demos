// introduction-to-reanimated's demos (reference: content/articles/introduction-to-reanimated/components/
// animated-square.tsx): a 100 px blue square on white, in the frame, played by its round buttons. Each Play shows the
// square's starting state at once and animates 100 ms later (the reference's reset, then setTimeout 100): here a
// fresh node per play (keyed by the count) whose animations wait 100 ms with their first frame shown.
// withTiming is Easing.inOut(Easing.quad) (CSS cubic-bezier(0.455, 0.03, 0.515, 0.955)); the withSpring legs are
// baked from the reference's integrator at 60 Hz (gesture-kit/.tools/bake.ts). The corners are
// gesture-kit's MorphSquare. As live, the final square's
// "repeat" plays one leg: the reference's bounce restarts the spring inside the finishing frame, which then clears it.
//
// Exports, as the article's MDX names them:
//   AnimatedSquareOpacityDemo()                                              opacity 0 → 1, 500 ms
//   AnimatedSquareOpacityAndScaleDemo(scaleAnimationType="timing", showBorderRadiusAnimation=false)
//                                                                           opacity 0 → 1, scale 1 → 2 (300 ms)
//   AnimatedSquareOpacityAndScaleDemo(scaleAnimationType="spring", showBorderRadiusAnimation=false|true)
//                                                                           opacity 1 → 0.5, scale spring 1 → 2,
//                                                                           corners 50 → 25 when asked
//   FinalAnimatedSquareDemo()                                                Play and Restart
use DemoFrame, BoxButton, MorphSquare from "../gesture-kit/box.contract"

keyframes irFade
  from opacity=0
  to opacity=1
keyframes irHalf
  from opacity=1
  to opacity=0.5
keyframes irDouble
  from scale=1
  to scale=2

// <baked> (gesture-kit/.tools/bake.ts writes this block)
