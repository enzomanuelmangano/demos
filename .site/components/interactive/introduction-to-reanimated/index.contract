// </baked>

fn irQuad(ms: number): string = `${ms}ms cubic-bezier(0.455, 0.03, 0.515, 0.955) 100ms both`

component AnimatedSquareOpacityDemo
  view
    IrSquare(kind="opacity")

component AnimatedSquareOpacityAndScaleDemo
  props
    scaleAnimationType: string
    showBorderRadiusAnimation: bool
  view
    IrSquare(kind=(scaleAnimationType == "spring" ? (showBorderRadiusAnimation ? "springRadius" : "spring") : "timing"))

component FinalAnimatedSquareDemo
  view
    IrSquare(kind="final")

// kind: opacity, timing, spring, springRadius, final.
component IrSquare
  props
    kind: string
  // 0 before the first Play (and after Restart): the square's starting state, still.
  state plays = 0
  derive rounded = kind == "springRadius" or kind == "final"
  derive restOpacity = kind == "opacity" or kind == "timing" ? 0 : 1
  derive restScale = kind == "final" ? 2 : 1
  derive body = (kind == "opacity" ? `irFade ${irQuad(500)}` : kind == "timing" ? `irFade ${irQuad(500)}, irDouble ${irQuad(300)}`
    : kind == "final" ? `irFinalProgress ${irFinalProgressMs()}ms linear 100ms both, irFinalScale ${irFinalScaleMs()}ms linear 100ms both`
    : `irHalf ${irQuad(500)}, irScaleUp ${irScaleUpMs()}ms linear 100ms both`)
  derive cornerPrefix = kind == "final" ? "irFinalCorner" : "irRadiusCorner"
  derive cornerTiming = kind == "final" ? `${irFinalProgressMs()}ms linear 100ms both` : irQuad(500)
  action play
    plays = plays + 1
  action restart
    plays = 0
  view
    DemoFrame()
      view flex=1 display="flex" align-items="center" justify-content="center" background-color="white"
        for p in [plays] key=p
          view width=100 height=100 flex-shrink=0 opacity=restOpacity scale=restScale rotate=(kind == "final" ? "360deg" : "0deg")
            animation=(plays == 0 ? "none" : body)
            MorphSquare(size=100, color="blue", alpha=1, rest=(rounded ? 50 : 0), rmax=50, prefix=cornerPrefix,
              timing=cornerTiming, on=(rounded and plays > 0))
      BoxButton(kind="play", index=0, label="Play", press=play)
      if kind == "final"
        BoxButton(kind="reset", index=1, label="Restart", press=restart)
