// The animated-spiral article's demos (the reference's content/articles/animated-spiral/components): 1,500 dots on a
// logarithmic spiral; Play turns it to a random angle, Restart back to π/2. The canvas mounts when the box comes
// within 300 px of the viewport (its drawing code loads then) and animates only while visible. The article's
// InlineMath / BlockMath are the content converter's (MathJax to SVG at build).
use InteractiveBox from "../_canvas/box.contract"

component AnimatedSpiral
  props
    key: string
    fixedRadius: bool
    sweep: bool
    animated: bool
  // Mounted with the page (final sweep): a canvas mounted inside a scroll cost a whole-document style pass (Exact's :has rules, ~27 ms at 4x CPU); its first paint still waits for the scroll to settle (_canvas/draws.ts).
  state near = true
  state visible = false
  state presses = 0
  state kind = "play"
  action seen(entry: IntersectionObserverEntry)
    visible = entry.isIntersecting
    if entry.isIntersecting
      near = true
  action play
    kind = "play"
    presses = presses + 1
  action reset
    kind = "reset"
    presses = presses + 1
  view
    InteractiveBox(theme="light", shape="video", withPlay=true, withReset=true, play=play, reset=reset, seen=seen)
      view flex=1 min-height=0 background-color="#0a0a0a"
        if near
          // Not told when it enters or leaves the view (final sweep): a changed argument repaints the whole spiral (20-35 ms
          // at 4x CPU) inside the scroll that moved it; it only animates for 1.5 s after a press, seen or not.
          canvas surface=articleSpiral(key, fixedRadius, sweep, animated, true, presses, kind) aria-hidden=true width="100%" height="100%" flex=1

// The MDX's names (content/articles/animated-spiral/mdx-client.tsx).
component AnimatedSpiralWithSkia
  view
    AnimatedSpiral(key="animated-spiral", fixedRadius=false, sweep=true, animated=true)

component AnimatedInteractiveSnappySpiralWhite
  view
    AnimatedSpiral(key="snappy-spiral-white", fixedRadius=true, sweep=false, animated=false)

component AnimatedInteractiveSnappySpiralGradient
  view
    AnimatedSpiral(key="snappy-spiral-gradient", fixedRadius=true, sweep=true, animated=false)

component AnimatedInteractiveAnimatedSpiralFixedRadiusGradient
  view
    AnimatedSpiral(key="spiral-fixed-radius-gradient", fixedRadius=true, sweep=true, animated=true)


// One entry for the content converter: the export named `name` (an MDX tag of this article), nothing for another.
// One call site per component (the plan's code grows with each).
component AnimatedSpiralInteractive
  props
    name: string
  view
    if name == "AnimatedSpiralWithSkia" or name == "AnimatedInteractiveSnappySpiralWhite" or name == "AnimatedInteractiveSnappySpiralGradient" or name == "AnimatedInteractiveAnimatedSpiralFixedRadiusGradient"
      AnimatedSpiral(key=name, fixedRadius=(name != "AnimatedSpiralWithSkia"), sweep=(name != "AnimatedInteractiveSnappySpiralWhite"),
        animated=(name == "AnimatedSpiralWithSkia" or name == "AnimatedInteractiveAnimatedSpiralFixedRadiusGradient"))
