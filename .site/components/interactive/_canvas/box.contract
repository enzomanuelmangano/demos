// The frame of every article demo: the reference's src/components/interactive (InteractiveBox, InteractiveButtons,
// CustomButton). A 16:9 (or square) box as wide as the column, 10 px corners, a 1 px #242424 border in the light
// theme, 16 px below; the demo fills it; its buttons sit at its bottom-right corner, 16 px in, Play (or Pause) first
// from the right, then Restart 44.8 px further left. The demo owns its state: the box only places the buttons and
// calls `play` / `reset`.

// The reference's icons (Material's replay, a play triangle, two pause bars), 18 px in a 24-unit box.
component InteractiveIcon
  props
    kind: string
    color: string
  view
    svg width=18 height=18 viewBox="0 0 24 24" fill=color aria-hidden=true
      if kind == "reset"
        path fill=color d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"
      else if kind == "pause"
        path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z" stroke=color fill=color stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"
      else
        path d="M8 5.14v14.72L19 12 8 5.14z" stroke=color fill=color stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"

// CustomButton: 36 px, 12 px corners; light #b8b8b8 (hover #E5E7EB), dark #00000033 (hover black); hover shrinks it
// to 95 % with a 1 px gray-800 ring and a small shadow; everything eases over 300 ms.
style ButtonLight
  position="absolute" right=16 bottom=16 width=36 height=36 display="flex" align-items="center" justify-content="center"
  border-radius=12 border="none" cursor="pointer" padding=0 transition="all 300ms" outline="none" appearance="none"
  background-color="#b8b8b8"
  :hover
    background-color = "#E5E7EB"
    scale = 0.95
    box-shadow = "0 0 0 1px oklch(27.8% 0.033 256.848), 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)"
  :focus-visible
    box-shadow = "var(--shadow-focus)"
style ButtonDark
  position="absolute" right=16 bottom=16 width=36 height=36 display="flex" align-items="center" justify-content="center"
  border-radius=12 border="none" cursor="pointer" padding=0 transition="all 300ms" outline="none" appearance="none"
  background-color="#00000033"
  :hover
    background-color = "#000000"
    scale = 0.95
    box-shadow = "0 0 0 1px oklch(27.8% 0.033 256.848), 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)"
  :focus-visible
    box-shadow = "var(--shadow-focus)"

component InteractiveButton
  props
    kind: string
    label: string
    theme: string
    right: number
    press: action
  view
    view position="absolute" bottom=0 right=right display="flex" flex-direction="column"
      if theme == "dark"
        button press=press aria-label=label title=label class=ButtonDark
          InteractiveIcon(kind=kind, color="#FFFFFF")
      else
        button press=press aria-label=label title=label class=ButtonLight
          InteractiveIcon(kind=kind, color="#303030")

component InteractiveBox
  props
    theme: string
    square: bool
    withPlay: bool
    withReset: bool
    play: action
    reset: action
  slot
  view
    row width="100%" aspect-ratio=(square ? "1 / 1" : "16 / 9") margin-bottom=16 justify-content="center" align-items="center"
      border-radius=10 overflow="hidden" box-sizing="border-box" border-style="solid" border-width=(theme == "dark" ? 0 : 1)
      border-color=(theme == "dark" ? "#00000000" : "#242424")
      column position="relative" flex=1 min-width=0 min-height=0 height="100%" cursor="pointer"
        children
        if withPlay
          InteractiveButton(kind="play", label="Play", theme=theme, right=0, press=play)
        if withReset
          InteractiveButton(kind="reset", label="Restart", theme=theme, right=(withPlay ? 44.8 : 0), press=reset)
