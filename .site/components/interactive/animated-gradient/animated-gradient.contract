// The animated-gradient article's demos (the reference's content/articles/animated-gradient/components): a
// full-bleed linear gradient, red to blue, in a dark-themed box. Play picks two random colours. The canvas mounts
// when the box comes within 300 px of the viewport (its drawing code loads then) and draws only while visible.
use InteractiveBox from "../_canvas/box.contract"

component AnimatedGradient
  props
    key: string
    animated: bool
    withPlay: bool
  state near = false
  state visible = false
  state presses = 0
  state kind = "play"
  action seen(entry: IntersectionObserverEntry)
    visible = entry.isIntersecting
    if entry.isIntersecting
      near = true
  action play
    kind = "play"
    presses = presses + 1
  action reset
    kind = "reset"
    presses = presses + 1
  view
    InteractiveBox(theme="dark", shape="video", withPlay=withPlay, withReset=false, play=play, reset=reset)
      view flex=1 min-height=0 intersect=seen intersect-margin="300px"
        if near
          canvas surface=gradient(key, animated, presses, kind) aria-hidden=true width="100%" height="100%" flex=1

// The MDX's names (content/articles/animated-gradient/mdx-client.tsx).
component AnimatedGradientWithSkia
  view
    AnimatedGradient(key="animated-gradient", animated=true, withPlay=true)

component GlitchedAnimatedGradientWithSkia
  view
    AnimatedGradient(key="glitched-animated-gradient", animated=false, withPlay=true)

component NonInteractiveAnimatedGradientWithSkia
  view
    AnimatedGradient(key="non-interactive-animated-gradient", animated=true, withPlay=false)

// One entry for the content converter: the export named `name` (an MDX tag of this article), nothing for another.
component AnimatedGradientInteractive
  props
    name: string
  view
    if name == "AnimatedGradientWithSkia"
      AnimatedGradientWithSkia()
    else if name == "GlitchedAnimatedGradientWithSkia"
      GlitchedAnimatedGradientWithSkia()
    else if name == "NonInteractiveAnimatedGradientWithSkia"
      NonInteractiveAnimatedGradientWithSkia()
