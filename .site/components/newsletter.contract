use ButtonPrimary from "./look.contract"
// The newsletter form (reference components/newsletter): posts to the public https://subs.reactiive.io/api/subscribe
// (no secret; app.ts's `subscribe`), then thanks the reader or says it went wrong. The request is the root's
// (App's `newsletter` mutation); this form keeps the address and shows the status it is given.
component Newsletter
  props
    showTitle: bool
    status: string
    subscribe: action
  state email = ""
  action edit(v: string)
    email = v
  action submit
    subscribe(email.trim())
  view
    column width="100%" margin-top=24
      if status == "success"
        text "Thanks for subscribing!" color="var(--color-success)"
      else
        if showTitle
          // Text variant h5 (the article pages' title): text-2xl, font-sans-medium, the heading colour.
          text "Newsletter" role="heading" aria-level=5 margin-bottom=8 font-size="1.5rem" line-height="2rem" font-weight=500 color="var(--color-text-heading)"
        text "Join 5,000+ devs getting occasional updates on React Native animations." color="var(--color-text-secondary)" margin-bottom=16
        row gap=8
          input type="email" placeholder="you@email.com" value=email input=edit submit=submit disabled=(status == "loading")
            aria-label="Email address" flex=1 min-width=0 height=40 padding="0 14px" box-sizing="border-box" font-size="0.875rem"
            line-height="1.25rem" color="var(--color-text-primary)" background-color="rgb(255 255 255 / 0.03)" border="none"
            border-radius="var(--radius-control)" box-shadow="inset 0 0 0 1px rgb(255 255 255 / 0.06)" outline="none" testId="newsletter-email"
            // fieldClassName (reference components/ui/input): a touch lighter under the pointer and while focused, the
            // inner edge lit while focused, both over 150 ms on the snappy curve.
            transition="background-color 150ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 150ms cubic-bezier(0.23, 1, 0.32, 1)"
            :hover
              background-color = "rgb(255 255 255 / 0.045)"
            :focus-visible
              background-color = "rgb(255 255 255 / 0.045)"
              box-shadow = "inset 0 0 0 1px rgb(255 255 255 / 0.18)"
            ::placeholder
              color = "var(--color-text-disabled)"
          button press=submit appearance="none" disabled=(status == "loading") height=40 padding="0 16px" border-radius="var(--radius-control)"
            class=ButtonPrimary font-size="0.875rem" line-height="1.25rem" font-weight=500 testId="newsletter-subscribe" data-motion="button press-primary focus"
            text "Subscribe"
        if status == "error"
          text "Something went wrong. Please try again." margin-top=12 font-size="0.875rem" color="var(--color-danger)"
