// A demo post's own parts (docs/decisions.md D25): the reference's `Demo` (the video, the QR code to the app, the
// libraries, the source), `ReanimatePromo`, `GitHubRepoButtons` and `SendFeedback` (src/components/demos, embeds,
// send-feedback), drawn from the blocks tools/gen-content.ts makes. What changes with the window's width is
// web/content.css's (`post-*`). The reference's modals (support, feedback) are the mail links they led to.

component PostChips
  props
    tags: string
  view
    row flex-wrap="wrap" gap=8 role="list" aria-label="Libraries"
      for t in tags.split(",") key=t
        if t != ""
          text t role="listitem" height=28 line-height="28px" max-width=200 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" padding-left=10 padding-right=10 border-radius=9999 background-color="rgb(255 255 255 / 0.06)" box-shadow="var(--shadow-control)" font-family="'Source Code Pro', 'Source Code Pro Fallback', ui-monospace, monospace" font-size=12 color="var(--color-text-secondary)"

// The demo: on a window too narrow for the phone beside the article (under 1024 px) a button first, which opens the
// app on this demo, full screen; then the reference's video with the QR code beside it (from 768 px; a line under it
// on a phone), the libraries and the source. `app` is the app's slug, '' for a post whose demo the app has not.
component PostMedia
  props
    slug: string
    app: string
    video: string
    source: string
    tags: string
  view
    column width="100%"
      if app != ""
        link href=`/demos/app/demo/${app}` display="flex" align-items="center" justify-content="center" gap=10 height=52 margin-top=4 margin-bottom=12 border-radius=9999 background-color="#f5f5f7" color="#0b0b0d" font-size=17 font-weight=600 letter-spacing="-0.01em" text-decoration-line="none" -exact-hover-effect="none" data-motion="post-launch button" testId="open-demo"
          text "Try the live demo"
          svg width=16 height=16 viewBox="0 0 16 16" fill="none" aria-hidden=true
            path d="M4 2.8v10.4L13 8Z" fill="currentColor"
      view margin-top=16 margin-bottom=24 data-motion="post-media"
        view min-width=0 position="relative" align-self="flex-start" width="100%" aspect-ratio="16 / 9" border-radius=14 overflow="hidden" background-color="var(--color-surface-code)" box-shadow="var(--shadow-control)" data-motion="post-video"
          video video autoplay=true loop=true muted=true playsinline=true width="100%" height="100%" object-fit="contain" aria-label="Demo video"
        column align-items="center" justify-content="center" gap=12 flex-shrink=0 data-motion="post-qr"
          link href=`http://app.reactiive.io/animations/${slug}` target="_blank" rel="noopener noreferrer" aria-label="Open this demo in the app" display="flex" align-items="center" justify-content="center" width=216 height=216 border-radius=28 background-color="var(--color-surface-elevated)" box-shadow="var(--shadow-control)" data-motion="post-press"
            image `/assets/content/demos/${slug}/qr.svg` alt="QR code" width=168 height=168
          column align-items="center" gap=4
            text "Scan to try on your device" font-size=12 line-height="16px" color="var(--color-text-secondary)"
            link href="/demos-app" font-size=12 line-height="16px" color="var(--color-text-link)" text-decoration-line="underline"
              text "Need the app?"
        row flex-wrap="wrap" align-items="center" gap=8 margin-top=-8 font-size=14 line-height="20px" data-motion="post-try"
          link href=`http://app.reactiive.io/animations/${slug}` target="_blank" rel="noopener noreferrer" color="var(--color-text-link)" text-decoration-line="underline"
            text "Try this demo on your device"
          text "·" color="var(--color-text-tertiary)"
          link href="/demos-app" color="var(--color-text-secondary)" text-decoration-line="underline"
            text "Need the app?"
      column align-items="flex-start" gap=16 padding-bottom=24
        PostChips(tags=tags)
        row flex-wrap="wrap" align-items="center" gap=16
          link href=source target="_blank" rel="noopener noreferrer" display="flex" align-items="center" gap=8 height=32 padding-left=14 padding-right=14 border-radius="var(--radius-control)" background-color="#ffffff" color="#000000" font-size=14 font-weight=500 text-decoration-line="none" -exact-hover-effect="none" data-motion="post-press"
            image "/assets/images/github.svg" alt="" aria-hidden=true width=16 height=16 color="#000000" data-motion="post-ink"
            text "View source"
          if app != ""
            link href=`https://github.com/enzomanuelmangano/demos/tree/main/demos/${app}` target="_blank" rel="noopener noreferrer" font-size=13 line-height="20px" color="var(--color-text-tertiary)" text-decoration-line="underline" testId="exact-source"
              text "Exact source on GitHub"

component PostPromo
  view
    link href="https://reanimate.dev" target="_blank" rel="noopener noreferrer" display="block" margin-top=40 text-decoration-line="none" -exact-hover-effect="none" data-motion="card-link"
      view position="relative" data-motion="squircle-shadow"
        view position="absolute" inset=-1 pointer-events="none" z-index=1 aria-hidden=true data-motion="squircle-rim"
        view padding=24 position="relative" overflow="hidden" background-color="var(--color-surface-elevated)" data-motion="surface squircle"
          view position="absolute" top=-128 right=-64 width=256 height=256 pointer-events="none" aria-hidden=true background-image="radial-gradient(closest-side, rgb(28 137 255 / 0.15), transparent)"
          row align-items="center" gap=20 position="relative"
            row flex-shrink=0 width=56 height=56 align-items="center" justify-content="center" border-radius=12 background-image="linear-gradient(to bottom right, #1c89ff, #00bcf6)" box-shadow="inset 0 1px 0 rgb(255 255 255 / 0.25)"
              svg width=24 height=24 viewBox="0 0 24 24" fill="#ffffff" aria-hidden=true
                path d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z"
            column flex=1 min-width=0
              h3 "Unlock the beauty of React Native animations" margin=0 margin-bottom=2 font-size=16 line-height="24px" font-weight=600 color="#ffffff"
              text "Learn Reanimated, Gesture Handler & Skia with Reanimate.dev" font-size=14 line-height="20px" color="#6a7282"
            svg width=20 height=20 viewBox="0 0 20 20" fill="#6a7282" aria-hidden=true flex-shrink=0
              path d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z"

component PostSupport
  view
    row margin-top=32
      link href="mailto:hello@reactiive.io" font-size=14 line-height="20px" color="var(--color-text-secondary)" text-decoration-line="underline"
        text "Ask for support"

component PostFeedback
  props
    title: string
  view
    view position="relative" margin-top=32 data-motion="squircle-shadow"
      view position="absolute" inset=-1 pointer-events="none" z-index=1 aria-hidden=true data-motion="squircle-rim"
      view padding=24 background-color="var(--color-surface-elevated)" data-motion="squircle"
        view data-motion="post-feedback"
          row flex=1 align-items="flex-start" gap=16
            row flex-shrink=0 width=36 height=36 align-items="center" justify-content="center" border-radius=10 background-color="rgb(255 255 255 / 0.06)" color="var(--color-text-secondary)"
              svg width=18 height=18 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
                path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
            column flex=1 min-width=0 gap=4
              h2 `Feedback on ${title}` margin=0 font-size=15 line-height="24px" font-weight=500 color="var(--color-text-primary)"
              text font-size=14 line-height="24px" color="var(--color-text-tertiary)"
                text "Ideas, bugs, or anything that felt off: I read every message. For anything else, write to "
                text "hello@reactiive.io" href="mailto:hello@reactiive.io" color="var(--color-text-secondary)" text-decoration-line="underline"
                text "."
          link href=`mailto:hello@reactiive.io?subject=Feedback%20on%20${title.replaceAll(" ", "%20")}` display="flex" align-items="center" justify-content="center" flex-shrink=0 height=32 padding-left=14 padding-right=14 border-radius="var(--radius-control)" background-color="rgb(255 255 255 / 0.06)" box-shadow="var(--shadow-control)" color="var(--color-text-primary)" font-size=14 font-weight=500 text-decoration-line="none" data-motion="post-press"
            text "Send feedback"
