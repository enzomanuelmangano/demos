diff --git a/gpu/src/haptic.rs b/gpu/src/haptic.rs
new file mode 100644
index 0000000..7ff00c1
--- /dev/null
+++ b/gpu/src/haptic.rs
@@ -0,0 +1,117 @@
+//! A surface's haptics, played by the host with no Contract commit.
+//!
+//! The surfaces post `"haptic:<kind>"` (`selection`, `impact-light`, …, the names of
+//! Contract's `haptic()`), and every `messages()` hands its list through [`host`] on the
+//! way out. There each kind becomes an `exact_gpu::haptics` pattern, a message the host
+//! consumes before the app sees it (Core Haptics on iOS, one engine for the page): no
+//! `message=` action, no logic turn, no plan applied, no `UIFeedbackGenerator` made per tick.
+//! A drag's selection ticks (25 a second in atlas-sphere and prequel-slider) used to cost
+//! a whole action commit each on the main thread, inside a 8.3 ms frame.
+//!
+//! The demos' own aliases (audio-player's `grab`/`tick`/`release`, duration-slider's
+//! `limit`) map to the kinds their Contract played; anything else (chessboard's
+//! `haptic:mate`, which the Contract counts) passes through untouched.
+//!
+//! Under `cargo test` [`host`] keeps the kinds, so each surface's tests still read
+//! `"haptic:selection"`; [`translate`] is what runs everywhere else, tested below.
+
+use exact_gpu::haptics::{Event, Haptic, Pattern};
+
+/// A surface's messages as the host should get them: each `haptic:<kind>` as its pattern.
+pub fn host(messages: Vec<String>) -> Vec<String> {
+    if cfg!(test) {
+        messages
+    } else {
+        translate(messages)
+    }
+}
+
+/// Each `haptic:<kind>` this module knows as its pattern's message; the rest as it was.
+pub fn translate(mut messages: Vec<String>) -> Vec<String> {
+    for m in messages.iter_mut() {
+        if let Some(p) = m.strip_prefix("haptic:").and_then(pattern) {
+            *m = Haptic::Pattern(p).message();
+        }
+    }
+    messages
+}
+
+/// A tap at `time` seconds.
+fn tap(time: f32, intensity: f32, sharpness: f32) -> Event {
+    Event::Transient {
+        time,
+        intensity,
+        sharpness,
+    }
+}
+
+/// The kind's pattern, close to what `UIFeedbackGenerator` plays for it: transients whose
+/// intensity follows light < medium < heavy, whose sharpness is soft's low and rigid's high,
+/// and the notifications' two and three taps.
+fn pattern(kind: &str) -> Option<Pattern> {
+    let events = match kind {
+        "selection" | "tick" => vec![tap(0.0, 0.45, 0.85)],
+        "impact-light" | "grab" => vec![tap(0.0, 0.55, 0.6)],
+        "impact-medium" | "impact" => vec![tap(0.0, 0.75, 0.6)],
+        "impact-heavy" => vec![tap(0.0, 1.0, 0.5)],
+        "impact-soft" | "release" => vec![tap(0.0, 0.6, 0.15)],
+        "impact-rigid" | "limit" => vec![tap(0.0, 0.75, 1.0)],
+        "success" => vec![tap(0.0, 0.6, 0.6), tap(0.1, 1.0, 0.7)],
+        "warning" => vec![tap(0.0, 1.0, 0.6), tap(0.15, 0.6, 0.6)],
+        "error" => vec![tap(0.0, 0.8, 0.8), tap(0.08, 0.8, 0.8), tap(0.2, 1.0, 0.6)],
+        _ => return None,
+    };
+    Some(Pattern {
+        events,
+        curves: Vec::new(),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_kind_becomes_a_pattern_the_host_consumes_and_the_rest_passes() {
+        let out = translate(vec![
+            "haptic:selection".into(),
+            "haptic:mate".into(),
+            "seek:1.5".into(),
+            "haptic:impact-soft".into(),
+        ]);
+        assert_eq!(
+            out[0],
+            r#"exact:haptics {"pattern":{"events":[{"type":"transient","time":0,"intensity":0.45,"sharpness":0.85}],"curves":[]}}"#
+        );
+        assert_eq!(out[1], "haptic:mate");
+        assert_eq!(out[2], "seek:1.5");
+        assert!(out[3].starts_with(exact_gpu::haptics::PREFIX));
+    }
+
+    #[test]
+    fn every_kind_the_demos_post_is_known() {
+        for k in [
+            "selection",
+            "impact-light",
+            "impact-medium",
+            "impact-heavy",
+            "impact-soft",
+            "impact-rigid",
+            "success",
+            "warning",
+            "error",
+            "grab",
+            "tick",
+            "release",
+            "limit",
+        ] {
+            assert!(pattern(k).is_some(), "{k}");
+        }
+        assert!(pattern("mate").is_none() && pattern("mate-stop").is_none());
+    }
+
+    #[test]
+    fn under_test_the_kinds_stay() {
+        assert_eq!(host(vec!["haptic:selection".into()]), ["haptic:selection"]);
+    }
+}
