{
  // The Bun tooling of the Exact app: tools/ (the Contract linter included), not .parity
  // (.parity/tsconfig.json). app.ts is not here: it imports app.contract.d.ts, which
  // `contract build` writes (and git ignores), so it cannot be checked on a bare checkout.
  // The React Native app in .legacy/ is its own project with its own tsconfig.json.
  // Check it with `bun x tsc -p tsconfig.json --noEmit` (or `tools/lint.sh ts`).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // The scripts are run, not imported: every file is a module, so top-level await is allowed.
    "moduleDetection": "force",
    "noFallthroughCasesInSwitch": true,
    // Node's types: tools/lint.sh ts installs typescript and @types/node into a scratch dir and
    // passes --typeRoots (the app's install has neither; .legacy/'s is never borrowed). Bun's globals
    // come from tools/types/bun-min.d.ts (swap it for the `bun-types` package when that is installed).
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["tools/**/*.ts", "tools/types/**/*.d.ts"],
  "exclude": ["**/node_modules", ".parity", ".legacy", "target"]
}
