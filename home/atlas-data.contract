// GENERATED by .parity/screen-atlas/gen-atlas-data.ts from tools/parity-queue.txt and
// the atlas's last iOS scores: do not edit by hand.

fn atlasDone(): string[] = ["animated-3d-parallax","animated-clip-box","animated-indicator-list","audio-player","blur-circles","blurred-scroll","bottom-bar-skia","circular-carousel","color-carousel","cuberto-slider","floating-modal","fluid-slider","github-contributions","loading-button","metaball","mobile-input","radar-chart","scroll-progress","scrollable-bottom-sheet","selectable-grid-list","shared-transitions","skia-color-picker","smooth-dropdown","spiral","split-button","story-list","swipe-cards","telegram-theme-switch","theme-canvas-animation","fourier-visualizer","add-to-cart","notion-qrcode","github-onboarding","airbnb-slider"]
fn atlasOpen(): string[] = ["floating-bottom-bar","sculptures-in-words"]
fn atlasClaimed(): string[] = []
fn atlasStatus(slug: string): string = atlasDone().includes(slug) ? "done" : atlasOpen().includes(slug) ? "open" : atlasClaimed().includes(slug) ? "claimed" : "unverified"

fn atlasScored(): string[] = []
fn atlasScores(): number[] = []
// Mean per-pixel difference (0-255) between the RN and Exact iOS captures; -1 when not captured.
fn atlasScore(slug: string): number = match atlasScores().at(atlasScored().indexOf(slug)) {
  case some(v) => atlasScored().includes(slug) ? v : -1,
  case none => -1
}
