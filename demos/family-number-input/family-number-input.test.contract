at "/demo/family-number-input"

// The number is drawn by the surface; "number" is its grouped text value.
test "typing groups the number with commas"
  expect tree has "family-number-input"
  expect text "number" == "0"
  tap "key-1"
  tap "key-2"
  tap "key-3"
  expect text "number" == "123"
  tap "key-4"
  expect text "number" == "1,234"
  tap "key-5"
  tap "key-6"
  tap "key-7"
  expect text "number" == "1,234,567"

test "backspace drops the last digit; the last one gone leaves 0"
  tap "key-4"
  tap "key-2"
  tap "key--2"
  expect text "number" == "4"
  tap "key--2"
  expect text "number" == "0"
  tap "key--2"
  expect text "number" == "0"

test "0 is replaced by the first digit and stays 0 under another 0"
  tap "key-0"
  expect text "number" == "0"
  tap "key-7"
  expect text "number" == "7"

test "rapid typing and deleting ends on the right number"
  tap "key-1"
  tap "key-2"
  tap "key-3"
  tap "key--2"
  tap "key--2"
  tap "key-4"
  tap "key-5"
  tap "key-6"
  tap "key-7"
  tap "key--2"
  tap "key-9"
  expect text "number" == "14,569"

test "the number stops at eleven digits"
  tap "key-9"
  tap "key-9"
  tap "key-9"
  tap "key-9"
  tap "key-9"
  tap "key-9"
  tap "key-9"
  tap "key-9"
  tap "key-9"
  tap "key-9"
  tap "key-9"
  tap "key-9"
  expect text "number" == "99,999,999,999"
