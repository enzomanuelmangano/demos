// Color Carousel: a paged strip of twenty colour cards that grow and turn in perspective as they
// near the middle, over a radial glow that eases to the centred card's colour. The canvas draws
// the cards and owns the scroll, snapping at every item.
use DemoEnv from "../env.contract"

component ColorCarousel
  props
    env: DemoEnv
  // Haptics: selection as the centred card changes, rigid when pulled past an end.
  action heard(m: string)
    if m == "haptic:selection"
      haptic("selection")
    if m == "haptic:impact-rigid"
      haptic("impact-rigid")
  view
    column position="absolute" inset=0 background-color="#111111" align-items="center"
      justify-content="center" testId="color-carousel"
      view position="relative" width=env.width height=env.width flex-shrink=0
        canvas surface=color_carousel() message=heard position="absolute" top=0 left=0 width=env.width
          height=env.width touch-action="none" aria-label="Colours" testId="color-carousel-canvas"
