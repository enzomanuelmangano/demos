// Floating Modal: a "+" button in the corner grows into a centred modal; dragging it shrinks it
// with the distance, and letting go far enough down closes it. One canvas draws the modal.
use DemoEnv from "../env.contract"

component FloatingModal
  props
    env: DemoEnv
  inject
    pressablesOnPress: action
  // A press plays pressto's selection; open and close add no haptic of their own.
  action heard(m: string)
    if m == "press"
      pressablesOnPress()
    // The drag's grab of the sheet, and the release that dismisses it.
    if m == "haptic:impact-light"
      haptic("impact-light")
    if m == "haptic:impact-medium"
      haptic("impact-medium")
  view
    canvas surface=floating_modal() message=heard position="absolute" top=0 left=0 width=env.width
      height=env.height background-color="rgba(0, 0, 0, 0.1)" touch-action="none"
      testId="floating-modal" aria-label="Floating modal: tap + to open, drag down to close"
