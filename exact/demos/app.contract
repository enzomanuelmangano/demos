// Demos on Exact: the launcher (an iOS SpringBoard of demo icons) and each demo, opened
// out of its icon. RN: app/_layout.tsx, app/index.tsx, src/navigation/home/*.
use Demo, allDemos from "./demos.contract"
use Springboard from "./home/springboard.contract"
use DemoScreen from "./home/demo-screen.contract"
use DemoEnv from "./demos/env.contract"
use startSensorInput, stopSensorInput, SensorInput from "@exact/motion"
use defaultPressablesConfig from "pressto"

routes nav
  home "/"
    demo "/demo/:slug"
    open "/open"

shape Host
  width: number
  height: number
  prefersReducedMotion: bool

// The web's `timer` surfaces: the token each live one last fired (gpu/src/timer.rs).
shape Timers
  fired: number[]

shape Time
  seed: number
  epochAtZero: number
  utcOffset: number

// Demos whose drags own the whole screen: their swipe-down close is off (the close button
// stays). RN lets a demo keep a touch it claimed (demo-screen.tsx CloseGesture); a route's
// dismissal cannot ask the canvas mid-gesture, and switching it per touch costs a commit
// that holds the canvas's first frames.
fn ownsDrags(slug: string): bool = ["metaball", "magnet-spring", "swipe-cards", "animated-3d-parallax", "record-button", "sphere-waves", "skia-bottom-sheet", "atlas-sphere", "floating-modal", "expandable-mini-player", "selectable-grid-list", "skia-color-picker", "duration-slider", "clock-time-picker", "wheel-picker", "bezier-curve-outline", "prequel-slider", "scrollable-shapes", "twodos-slide", "color-carousel", "coverflow-carousel", "circular-carousel", "fibonacci-shader-grid", "fourier-visualizer", "card-shader-reflections", "threads-holo-ticket", "light-on-painting", "gl-transitions", "imessage-stack", "qr-code-generator"].includes(slug)

// The keyboard over a demo: RN moves nothing for it unless a demo says so (KeyboardAvoidingView,
// or cherry-blossom-qrcode's input riding useKeyboardHandler's height, which a keyboard toolbar
// is here), where the host's default resizes the screen above the keys.
fn overlaysKeyboard(slug: string): bool = ["dot-sheet", "cherry-blossom-qrcode"].includes(slug)
// Demos whose GPU surface reads the gravity sensor while it shows (RN: useAnimatedSensor).
fn tilts(slug: string): bool = slug == "linear-sensors"
// Demos whose GPU surface reads the attitude (RN: useAnimatedSensor(SensorType.ROTATION)).
fn turns(slug: string): bool = slug == "threads-holo-ticket"

// A link `demos-exact://demo/<slug>` arrives as `/open?u=<the link, encoded>`: its path.
fn linkPath(u: string): string = linkRoute(u.replaceAll("%3A", ":").replaceAll("%2F", "/").split("://").slice(1).join("://"))
// `demo/x`, `/demo/x`, `///` or `` (the launcher): its non-empty segments under `/`.
fn linkRoute(rest: string): string = `/${rest.split("/").filter(p => p != "").join("/")}`

fn demoOf(slug: string): Demo = match first(allDemos().filter(d => d.slug == slug)) {
  case some(d) => d,
  case none => Demo(slug=slug, name=slug, label=slug, icon="assets/app-icons/_placeholder.png", backdrop="#000000", inspiration="", story="", actionLabel="", actionUrl="", unstable=false, ported=false)
}

component Demos
  resource host = exactViewport() as shape Host
  resource time = exactTime() as shape Time
  resource timers = exactSurface("timer") as shape Timers
  derive env = DemoEnv(width=host.width, height=host.height, safeTop=0, safeBottom=0, epoch=time.epochAtZero, utcOffset=time.utcOffset, seed=time.seed, reducedMotion=host.prefersReducedMotion, timers=timers.fired)
  // "Show Unstable" (the General tray): the work-in-progress demos are listed only with it on.
  state showUnstable = false persist
  derive demos = showUnstable ? allDemos() : allDemos().filter(d => not d.unstable)

  action open(slug: string)
    haptic("selection")
    nav = push(nav, path("demo", slug))
  mutation sensors as shape SensorInput
  // demo-screen.tsx: a close, by the button or by the drag past CLOSE_SCALE, plays
  // Presets.System.impactMedium().
  action back
    if top(nav).name == "demo"
      haptic("impact-medium")
    if top(nav).name == "demo" and tilts(top(nav).params.slug)
      send sensors = stopSensorInput(surface="linear_sensors", sensor="gravity")
    else if top(nav).name == "demo" and turns(top(nav).params.slug)
      send sensors = stopSensorInput(surface="threads_holo_ticket", sensor="relativeOrientation")
    nav = back(nav)
  // Linear Sensors' feed: the gravity sensor at 50 Hz (RN's interval 20), into its surface.
  task tilt when top(nav).name == "demo" and tilts(top(nav).params.slug) key=top(nav).id
    after(1, startTilt)
  action startTilt
    send sensors = startSensorInput(surface="linear_sensors", sensor="gravity", frequency=50)
  // Threads Holo Ticket's feed: Core Motion's attitude at 62.5 Hz (RN's interval 16 ms is
  // deviceMotionUpdateInterval 0.016 s), into its surface.
  task turn when top(nav).name == "demo" and turns(top(nav).params.slug) key=top(nav).id
    after(1, startTurn)
  action startTurn
    send sensors = startSensorInput(surface="threads_holo_ticket", sensor="relativeOrientation", frequency=62.5)
  action follow(url: string)
    let n = go(nav, url)
    nav = top(n).name == "open" ? replace(n, linkPath(searchParam(top(n), "u"))) : n
  // A cold link: the launch location is the /open route; it becomes what it names.
  task opened when top(nav).name == "open" key=top(nav).id
    after(1, redirect)
  action redirect
    nav = replace(nav, linkPath(searchParam(top(nav), "u")))

  // <PressablesConfig globalHandlers={{ onPress: () => Haptics.selectionAsync() }}> around
  // the app (app/_layout.tsx): pressto's default timing and config, and the global onPress.
  action pressablesOnPress
    haptic("selection")
  provide
    pressto = defaultPressablesConfig()
    pressablesOnPress
  view
    main testId="root" navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow
      width="100%" height="100%" background-color="#000000" color-scheme="dark" viewport-fit="cover"
      interactive-widget=(top(nav).name == "demo" and overlaysKeyboard(top(nav).params.slug) ? "overlays-content" : "resizes-content")
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0
            Springboard(demos=demos, open=open)
        if e.name == "demo"
          column navigationKey=`${e.id}` navigationBar="none" navigationPresentation="fullscreen"
            navigationSource=`icon-${e.params.slug}` position="absolute" inset=0
            background-color=demoOf(e.params.slug).backdrop closedby=(ownsDrags(e.params.slug) ? "none" : "closerequest")
            DemoScreen(demo=demoOf(e.params.slug), env=env, leave=back)
