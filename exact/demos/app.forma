forma demos

// The demos' SF Symbols with a drawing for the hosts that have none (the web): each `sf` source is what
// Apple draws, unchanged; the SVG is the Ionicons glyph the RN demo drew (@expo/vector-icons), so the web
// shows the RN original's icon where it showed nothing.
icons
  icon.airplay-audio = icon(sf "airplay.audio", svg "icons/airplay-audio.svg")
  icon.arrow-right = icon(sf "arrow.right", svg "icons/arrow-right.svg")
  icon.arrow-up = icon(sf "arrow.up", svg "icons/arrow-up.svg")
  icon.arrow-up-arrow-down = icon(sf "arrow.up.arrow.down", svg "icons/arrow-up-arrow-down.svg")
  icon.backward-fill = icon(sf "backward.fill", svg "icons/backward-fill.svg")
  icon.bell-badge = icon(sf "bell.badge", svg "icons/bell-badge.svg")
  icon.cart = icon(sf "cart", svg "icons/cart.svg")
  icon.cart-fill = icon(sf "cart.fill", svg "icons/cart-fill.svg")
  icon.checkmark = icon(sf "checkmark", svg "icons/checkmark.svg")
  icon.checkmark-circle-fill = icon(sf "checkmark.circle.fill", svg "icons/checkmark-circle-fill.svg")
  icon.chevron-backward = icon(sf "chevron.backward", svg "icons/chevron-backward.svg")
  icon.delete-left = icon(sf "delete.left", svg "icons/delete-left.svg")
  icon.delete-left-fill = icon(sf "delete.left.fill", svg "icons/delete-left-fill.svg")
  icon.dot-radiowaves-left-and-right = icon(sf "dot.radiowaves.left.and.right", svg "icons/dot-radiowaves-left-and-right.svg")
  icon.ellipsis = icon(sf "ellipsis", svg "icons/ellipsis.svg")
  icon.exclamationmark-circle = icon(sf "exclamationmark.circle", svg "icons/exclamationmark-circle.svg")
  icon.forward-fill = icon(sf "forward.fill", svg "icons/forward-fill.svg")
  icon.house-fill = icon(sf "house.fill", svg "icons/house-fill.svg")
  icon.list-bullet = icon(sf "list.bullet", svg "icons/list-bullet.svg")
  icon.magnifyingglass = icon(sf "magnifyingglass", svg "icons/magnifyingglass.svg")
  icon.moon-fill = icon(sf "moon.fill", svg "icons/moon-fill.svg")
  icon.music-note-square-stack-fill = icon(sf "music.note.square.stack.fill", svg "icons/music-note-square-stack-fill.svg")
  icon.pause-fill = icon(sf "pause.fill", svg "icons/pause-fill.svg")
