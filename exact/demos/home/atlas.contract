// The atlas: every ported demo live at once, each at iPhone Air size (420×912) scaled into a
// tile, in one process (one GPU device for all of them). Only tiles near the viewport mount
// their demo, at most `cap` at a time; the rest show the icon. A tile's title opens the demo
// through the normal demo route. Reached by `demos-exact://atlas` (and View › Demo Atlas, ⇧⌘A,
// on the Mac). The web twin is exact/parity-tools/screen-atlas.
use Demo from "../demos.contract"
use PortedDemo from "../demos/index.contract"
use DemoEnv from "../demos/env.contract"
use atlasStatus, atlasScore from "./atlas-data.contract"

// iPhone Air in points, and its safe-area insets (portrait).
fn airW(): number = 420
fn airH(): number = 912
fn airTop(): number = 62
fn airBottom(): number = 34

fn statusColor(s: string): string = s == "done" ? "#3ecf8e" : s == "open" ? "#f5a524" : s == "claimed" ? "#b48cff" : "#6b7280"
fn statusRank(s: string): number = ["done", "open", "claimed", "unverified"].indexOf(s)
fn matches(d: Demo, q: string, status: string): bool =
  (q == "" or d.name.toLowerCase().includes(q) or d.slug.includes(q)) and (status == "all" or atlasStatus(d.slug) == status)
fn sorted(ds: Demo[], by: string): Demo[] =
  by == "name" ? sortBy(ds, d => d.name) : by == "status" ? sortBy(ds, d => statusRank(atlasStatus(d.slug))) : by == "score" ? sortBy(ds, d => atlasScore(d.slug), "desc") : ds

component Atlas
  props
    demos: Demo[]
    env: DemoEnv
    // False while a demo is open over the atlas: every tile unmounts, so no surface runs twice.
    active: bool
    open: action
    leave: action
  state q = ""
  state status = "all"
  state by = "order"
  state scale = 0.4
  state cap = 12
  state paused = false
  // Slugs whose tiles intersect the scroller (with overscan), in no order.
  state inView: string[] = []
  derive shown = sorted(demos.filter(d => d.ported and matches(d, q, status)), by)
  derive live = (paused or not active) ? [] : shown.filter(d => inView.includes(d.slug)).slice(0, cap).map(d => d.slug)

  action typed(v: string)
    q = v.toLowerCase()
  action seen(slug: string, e: IntersectionObserverEntry)
    if e.isIntersecting and not inView.includes(slug)
      inView = inView.concat([slug])
    if not e.isIntersecting
      inView = inView.filter(s => s != slug)
  action pick(s: string)
    status = status == s ? "all" : s
  action sortOn(s: string)
    by = s
  action zoom(d: number)
    scale = min(0.8, max(0.2, scale + d))
  action capBy(d: number)
    cap = min(40, max(0, cap + d))
  action pause
    paused = not paused

  view
    column position="absolute" inset=0 background-color="#0e0f11" color="#e7e9ec" color-scheme="dark"
      padding-top="env(safe-area-inset-top)" testId="atlas"
      row flex-wrap="wrap" gap=8 align-items="center" padding="10px 16px" border-bottom="1px solid #2a2d32"
        button press=leave aria-label="Close atlas" testId="atlas-close"
          text "Close"
        text "Demos atlas" font-size=15 font-weight=700 margin-right=8
        input value=q input=typed placeholder="Search demos…" width=200 testId="atlas-search"
        text "Sort" color="#8b9099"
        for s in ["order", "name", "status", "score"] key=s
          button press=sortOn(s) testId=`atlas-sort-${s}`
            text (s == "score" ? "score ↓" : s) color=(by == s ? "#6ea8ff" : "#e7e9ec")
        text "Status" color="#8b9099" margin-left=8
        for s in ["done", "open", "claimed", "unverified"] key=s
          button press=pick(s) testId=`atlas-status-${s}`
            text `${s} ${demos.filter(d => d.ported and atlasStatus(d.slug) == s).length}` color=statusColor(s)
              font-weight=(status == s ? 700 : 400)
        text "Size" color="#8b9099" margin-left=8
        button press=zoom(-0.05) aria-label="Smaller tiles"
          text "−"
        button press=zoom(0.05) aria-label="Larger tiles"
          text "+"
        text `Live ${live.length}/${cap}` color="#8b9099" margin-left=8
        button press=capBy(-2) aria-label="Fewer live tiles"
          text "−"
        button press=capBy(2) aria-label="More live tiles"
          text "+"
        button press=pause testId="atlas-pause" -exact-menu="view" aria-keyshortcuts="Meta+Shift+P"
          aria-label=(paused ? "Resume Atlas" : "Pause Atlas")
          text (paused ? "Resume" : "Pause all")
        text `${shown.length} demos` color="#8b9099" margin-left="auto"
      scroll flex=1 min-height=0 overflow-y="auto" overflow-x="hidden" testId="atlas-grid"
        row flex-wrap="wrap" gap=16 padding=16 align-content="flex-start"
          for d in shown key=d.slug
            column width=(airW() * scale + 16) background-color="#17191c" border-radius=10
              border="1px solid #2a2d32" overflow="hidden"
              button appearance="none" press=open(d.slug) aria-label=`Open ${d.name}` testId=`atlas-open-${d.slug}`
                padding="6px 8px" border-width=0 background-color="transparent"
                column gap=2 align-items="flex-start"
                  text d.name font-size=12 font-weight=600 color="#e7e9ec" white-space="nowrap" overflow="hidden"
                    text-overflow="ellipsis" max-width="100%"
                  row gap=6
                    text atlasStatus(d.slug) font-size=10 color=statusColor(atlasStatus(d.slug))
                    if atlasScore(d.slug) >= 0
                      text `Δ ${atlasScore(d.slug).toFixed(1)}` font-size=10 color="#8b9099"
              view width=(airW() * scale) height=(airH() * scale) margin="0 8px 8px" position="relative"
                overflow="hidden" border-radius=(40 * scale) background-color=d.backdrop
                intersect=seen(d.slug) intersect-margin="200px"
                if live.includes(d.slug)
                  column position="absolute" width=airW() height=airH()
                    left=(0 - airW() * (1 - scale) / 2) top=(0 - airH() * (1 - scale) / 2) scale=scale
                    background-color=d.backdrop
                    PortedDemo(slug=d.slug, env=DemoEnv(env, width=airW(), height=airH(), safeTop=airTop(), safeBottom=airBottom()))
                else
                  column position="absolute" inset=0 align-items="center" justify-content="center"
                    image d.icon width=56 height=56 border-radius=12.5 corner-shape="-exact-continuous" aria-hidden=true
