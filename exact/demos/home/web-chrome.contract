// The web's stand-ins for the demo screen's native chrome: the glass close/back and info buttons
// (modules/apple/Demos.swift) and the Inspiration sheet (InspirationSheet.swift) have no web module.
// Plain shapes drawn with the same sizes and places; the iPhone never builds these (DemoScreen's `web`).

keyframes webSheetIn
  from translate="0px 100%"
keyframes webSheetOut
  to translate="0px 100%"
keyframes webScrimIn
  from opacity=0
keyframes webScrimOut
  to opacity=0

// A 48 pt circle, the glass button's size: a translucent dark disc with a white glyph.
// kind: "close", "back" or "info".
component WebRoundButton
  props
    kind: string
    label: string
    press: action
    id: string
  view
    button press=press appearance="none" aria-label=label testId=id padding=0 border-width=0
      width=48 height=48 border-radius=24 display="flex" align-items="center" justify-content="center"
      background-color="rgba(36,36,40,0.58)" backdrop-filter="blur(20px) saturate(180%)"
      box-shadow="0px 4px 14px rgba(0,0,0,0.22), inset 0px 0px 0px 0.5px rgba(255,255,255,0.22)"
      :active
        -exact-press-scale = 0.92
      svg width=20 height=20 viewBox="0 0 20 20" fill="none" aria-hidden=true
        if kind == "close"
          path d="M5 5L15 15M15 5L5 15" stroke="#ffffff" stroke-width=2.2 stroke-linecap="round"
        else if kind == "back"
          path d="M12 4L6 10L12 16" stroke="#ffffff" stroke-width=2.2 stroke-linecap="round" stroke-linejoin="round"
        else
          circle cx=10 cy=5.2 r=1.3 fill="#ffffff"
          rect x=8.9 y=8 width=2.2 height=7.4 rx=1.1 fill="#ffffff"

// A bottom sheet over the demo: a dimmed scrim (a tap dismisses), a dark panel with the demo's
// icon and its story, and the link to the inspiration.
component WebSheet
  props
    open: bool
    story: string
    icon: string
    actionLabel: string
    safeBottom: number
    dismiss: action
    follow: action
  view
    column position="absolute" inset=0 z-index=30 pointer-events=(open ? "auto" : "none") testId="web-sheet"
      if open
        button press=dismiss appearance="none" aria-label="Dismiss" padding=0 border-width=0
          position="absolute" inset=0 background-color="rgba(0,0,0,0.4)"
          animation="webScrimIn 260ms ease-out both" -exact-exit-animation="webScrimOut 200ms ease-in both"
        column position="absolute" left=0 right=0 bottom=0 background-color="#1c1c1e" border-top-left-radius=28
          border-top-right-radius=28 padding=24 gap=16 box-sizing="border-box"
          padding-bottom=max(24, safeBottom) color-scheme="dark"
          animation="webSheetIn 380ms cubic-bezier(0.32,0.72,0,1) both"
          -exact-exit-animation="webSheetOut 240ms cubic-bezier(0.5,0,0.75,0) both"
          row align-items="center" gap=14
            image icon width=44 height=44 border-radius=10 corner-shape="-exact-continuous" aria-hidden=true
            text "Inspiration" font-size=22 font-weight=700 color="#ffffff" flex=1
          text story font-size=15 line-height=1.45 color="#c7c7cc"
          if actionLabel != ""
            button press=follow appearance="none" testId="web-sheet-action" padding=0 border-width=0 height=52
              border-radius=26 background-color="#ffffff" display="flex" align-items="center" justify-content="center" gap=8
              :active
                -exact-press-scale = 0.97
              text actionLabel font-size=17 font-weight=600 color="#000000"
              image "symbol:link" width=16 height=16 aria-hidden=true
