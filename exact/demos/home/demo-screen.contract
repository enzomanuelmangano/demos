// A demo, opened out of its icon: the demo itself and the way out over it.
// RN: src/navigation/home/demo-screen.tsx, demo-close-button.tsx.
use Demo from "../demos.contract"
use PortedDemo from "../demos/index.contract"
use DemoEnv from "../demos/env.contract"

component DemoScreen
  props
    demo: Demo
    env: DemoEnv
    ownsDrags: bool
    leave: action
  // RN's demos are full screen and pad their own top: the route keeps the whole screen
  // (`-exact-safe-area="none"` in app.contract) and `demo-safe`, a box at the safe-area
  // insets, gives the demo its safeTop and safeBottom.
  state top = 0
  state bottom = 0
  // The Inspiration sheet is up.
  state inspiring = false
  action inspire
    haptic("impact-light")
    inspiring = true
  action uninspire
    inspiring = false
  action follow
    inspiring = false
    openURL(demo.actionUrl)
  action placed(w: number, h: number)
    let g = frame("demo-safe")
    if not g.unavailable
      top = g.y
      bottom = max(0, env.height - g.y - g.height)
  view
    column id="demo-route" position="absolute" inset=0 resize=placed testId=`demo-${demo.slug}`
      view id="demo-safe" position="absolute" left=0 right=0 top="env(safe-area-inset-top)"
        bottom="env(safe-area-inset-bottom)" pointer-events="none" aria-hidden=true
      column position="absolute" inset=0 background-color=demo.backdrop
        if demo.ported
          PortedDemo(slug=demo.slug, env=DemoEnv(env, safeTop=top, safeBottom=bottom))
        else
          column flex=1 align-items="center" justify-content="center" padding=32
            column align-items="center" gap=10 padding="28px 32px" border-radius=28 backgroundMaterial="regular"
              color-scheme="dark"
              image demo.icon width=96 height=96 border-radius=21.5 corner-shape="-exact-continuous" aria-hidden=true
              text demo.name font-size=22 font-weight=700 color="#ffffff" text-align="center" margin-top=4
              text "Not on Exact yet." font-size=15 color="#8e8e93" text-align="center" testId="not-ported"
        // demo-screen.tsx DemoLaunch: the card in the demo's backdrop, the demo fading in over it
        // once it has painted, and the launch around it (open, close drag, flight home, the
        // home's blur): `demo-card` (modules/apple/DemoLaunch.swift). Under the buttons.
        demo-card press=leave slug=demo.slug caption=demo.name tint=demo.backdrop owns=(ownsDrags ? "drags" : "")
          position="absolute" inset=0 pointer-events="none" aria-hidden=true
        // demo-close-button.tsx: the close role on liquid glass, 16 pt from the leading edge, at
        // the safe top. RN's is a real SwiftUI Button (@expo/ui), so is this: `glass-button`
        // (modules/apple/Demos.swift), the button at the box's top-left as Host matchContents.
        glass-button press=leave caption="Close" symbol="xmark" aria-label="Close"
          testId="close" position="absolute" top=top left=16 width=48 height=48
        // demo-inspiration.tsx: the info button mirroring the close button (16 pt from the
        // trailing edge), when the demo credits someone; it opens the Inspiration sheet.
        if demo.story != ""
          glass-button press=inspire caption="Inspiration" symbol="info" edge="trailing"
            aria-label="Inspiration" testId="inspiration" position="absolute" top=top right=16 width=48
            height=48
      // The sheet, sized to its content (BottomSheet fitToContents, dark, a grabber): title2 bold,
      // the story in body, the action as a large capsule button; inset 24. Drawn in the route, not
      // presented: a `dialog`'s showModal from the full-screen demo route never appeared on the
      // phone. A tap outside, or a drag down on the sheet, closes it.
      if demo.story != ""
        view position="absolute" inset=0 background-color="rgba(0, 0, 0, 0.3)"
          opacity=(inspiring ? 1 : 0) transition="opacity 300ms ease-out"
          pointer-events=(inspiring ? "auto" : "none") press=uninspire aria-hidden=true
          testId="inspiration-scrim"
        column position="absolute" left=8 right=8 bottom=8 color-scheme="dark"
          backgroundMaterial="regular" border-radius=40 corner-shape="-exact-continuous"
          translate=`0px ${inspiring ? 0 : env.height}px`
          transition="translate 450ms cubic-bezier(0.32, 0.72, 0, 1)"
          pointer-events=(inspiring ? "auto" : "none") aria-label="Inspiration"
          aria-hidden=(not inspiring) testId="inspiration-sheet"
          view width=36 height=5 border-radius=2.5 background-color="rgba(255, 255, 255, 0.3)"
            align-self="center" margin-top=5 aria-hidden=true
          column gap=16 padding="23px 24px 24px" align-items="stretch"
            text "Inspiration" font="-exact-title2" font-weight=700 color="#ffffff"
            text demo.story font="-exact-body" color="#ffffff"
            button press=follow buttonStyle="prominent-glass" testId="inspiration-action"
              margin-top=8
              text demo.actionLabel
