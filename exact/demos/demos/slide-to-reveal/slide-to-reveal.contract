// Slide to reveal: a dark card shows the code 112358 blurred. The finger reveals the digits under
// it, sharp and grown. Drawn in Rust (gpu/src/slide_to_reveal.rs).
use DemoEnv from "../env.contract"

component SlideToReveal
  props
    env: DemoEnv
  // Light on the touch, selection at each digit the finger reaches.
  action heard(m: string)
    if m == "haptic:impact-light"
      haptic("impact-light")
    if m == "haptic:selection"
      haptic("selection")
  view
    column position="absolute" inset=0 background-color="#000000" align-items="center"
      justify-content="center" testId="slide-to-reveal"
      canvas surface=slide_to_reveal() message=heard width=(env.width * 0.6) height=80 touch-action="none"
        testId="slide-to-reveal-canvas" aria-label="Slide to reveal the code"
