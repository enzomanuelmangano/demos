// Cuberto Slider: a thin track with a round picker; dragged, the picker grows and a balloon with
// the value trails it on a spring. The whole slider is drawn on one canvas, so it moves per frame
// without a commit.

component CubertoSlider
  // Haptics: a grab, a tick per value, and the ends.
  action buzz(m: string)
    if m == "haptic:selection"
      haptic("selection")
    if m == "haptic:impact-light"
      haptic("impact-light")
    if m == "haptic:impact-rigid"
      haptic("impact-rigid")
  view
    canvas surface=cuberto_slider() message=buzz position="absolute" top=0 left=0 width="100%" height="100%"
      background-color="#ffffff" touch-action="none" testId="cuberto-slider" aria-label="Slider"
