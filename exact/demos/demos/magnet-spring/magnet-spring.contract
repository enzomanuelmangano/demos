// Magnet Spring: a graphite piece dragged over nine aluminium magnets that swell as it nears;
// let go, it springs to the nearest. RN: src/animations/magnet-spring (index.tsx, magnet.tsx).
// The magnets, the piece, their shadows, the pan and the springs are Rust:
// gpu/src/magnet_spring.rs (on styles.container's #f5f5f5, the window's size as Dimensions).

component MagnetSpring
  view
    canvas surface=magnet_spring() position="absolute" top=0 left=0 width="100%" height="100%"
      background-color="#f5f5f5" touch-action="none" testId="magnet-canvas"
      aria-label="Magnet: drag the piece"
