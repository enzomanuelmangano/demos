// Dynamic Tab Indicator: five full-screen photos on a horizontal pager under a frosted bar of
// country tabs; a black line under the tabs slides and stretches from title to title as the
// pager scrolls, and a tab scrolls the pager to its photo.
// RN: src/animations/dynamic-tab-indicator (constants/data.tsx,
// components/dynamic-tab-indicator/index.tsx, section-tabs.tsx).
use DemoEnv, demoButtonRow from "../env.contract"
use PressablesConfig, pressNone, pressDown, pressUp, pressableOpacity, pressTransition from "pressto"

// constants/data.tsx: the titles (the photos are the surface's).
fn titles(): string[] = ["France", "Italy", "Iceland", "Norway", "Japan"]

// index.tsx INDICATOR_CONTAINER_HEIGHT 120.
fn barHeight(): number = 120
fn atOr(xs: number[], i: number): number = match xs.at(i) { case some(v) => v, case none => 0 }
fn setAt(xs: number[], i: number, v: number): number[] = range(5).map(j => j == i ? v : atOr(xs, j))
// The widest a title can be: its tab (width / 5) less paddingHorizontal 8 each side.
fn widest(w: number): number = w / 5 - 16
// The device pixel grid (3x): Yoga ceils a Text's measured size, floors its relative left.
fn ceilPx(v: number): number = ceil(v * 3 - 0.001) / 3
fn floorPx(v: number): number = floor(v * 3 + 0.001) / 3
// SF's line at 17 (hhea (1950 + 494) / 2048): what TextKit's usedRect is per point.
fn sfLine(): number = 2444 / 2048
// adjustsFontSizeToFit (NSTextStorage+FontScaling.m): a bisection of the font ratio between
// 1/128 and 128 from 1, keeping the last ratio whose line fits the Text's frame height, stopped
// when the bounds come within 0.005. s = [bottom, top, ratio, lastFit, done]; k is the largest
// ratio that fits (the frame height / the line at 17). 8 steps at any k; 16 unrolled.
fn fitStep(s: number[], k: number): number[] = atOr(s, 4) == 1 ? s : fitNext(atOr(s, 2) <= k ? atOr(s, 2) : atOr(s, 0), atOr(s, 2) <= k ? atOr(s, 1) : atOr(s, 2), atOr(s, 2) <= k ? atOr(s, 2) : atOr(s, 3))
fn fitNext(b: number, t: number, last: number): number[] = [b, t, (t + b) / 2, last, max(t - b, b - t) < 0.005 or max(t - (t + b) / 2, (t + b) / 2 - t) < 0.005 or max(b - (t + b) / 2, (t + b) / 2 - b) < 0.005 ? 1 : 0]
fn fit4(s: number[], k: number): number[] = fitStep(fitStep(fitStep(fitStep(s, k), k), k), k)
fn fitRatio(k: number): number = k >= 1 ? 1 : atOr(fit4(fit4(fit4(fit4([1 / 128, 128, 1, 0.02, 0], k), k), k), k), 3)
// The Text's frame: measured at 17 (the scaling is drawing only), its height at most the tab's.
fn textHeight(h: number): number = min(h, ceilPx(17 * sfLine()))
// Its relative left in the tab: paddingHorizontal 8, centred (alignItems), floored.
fn textLeft(w: number, tw: number): number = floorPx(8 + (widest(w) - tw) / 2)

component DynamicTabIndicator
  props
    env: DemoEnv
  inject
    pressto: PressablesConfig
    pressablesOnPress: action
  // pressto: the pressed pressable (its key) and the press parity.
  state pressing = pressNone()
  action pressIn(key: number)
    pressing = pressDown(pressing, key)
  action pressOut
    pressing = pressUp(pressing)
  // The tab pressed last and a counter that changes on each press (the surface's scrollTo).
  state target = 0
  state token = 0
  // Each title's onLayout: x within its tab plus index * width / 5 (xOutputRange), its width
  // (widthOutputRange), and the first title's y within its tab (indicatorLayout.y).
  state xs: number[] = [0, 0, 0, 0, 0]
  state ws: number[] = [0, 0, 0, 0, 0]
  state y = 0
  // Each title's frame width at 17 (ceiled), and the tabs' height (the bar less its paddings).
  state tws: number[] = [0, 0, 0, 0, 0]
  state th = 0
  action measured(i: number, w: number, h: number)
    let m = frame(`tab-measure-${i}`)
    let p = frame(`tab-${i}`)
    if not m.unavailable and not p.unavailable
      let tw = min(widest(env.width), ceilPx(m.width))
      tws = setAt(tws, i, tw)
      th = p.height
      // xOutputRange: the Text's x in its tab + index * width / 5; widthOutputRange: its width.
      xs = setAt(xs, i, i * env.width / 5 + textLeft(env.width, tw))
      ws = setAt(ws, i, tw)
      // indicatorLayout.y: the first Text's y in its tab, centred (justifyContent), floored.
      if i == 0
        y = floorPx((p.height - textHeight(p.height)) / 2)
  // handleSelectSection: scrollTo({ x: index * width, animated: true }).
  action select(i: number)
    pressablesOnPress()
    target = i
    token = token + 1
  view
    column position="absolute" inset=0 testId="dynamic-tab-indicator"
      // The paged ScrollView, its photos, the bar's white and the indicator, in Rust
      // (gpu/src/dynamic_tab_indicator.rs): UIKit's paging and animated scrollTo, the photos as RN
      // decodes them, the indicator on the scroll every frame.
      canvas surface=dynamic_tab_indicator(atOr(xs, 0), atOr(xs, 1), atOr(xs, 2), atOr(xs, 3), atOr(xs, 4),
        atOr(ws, 0), atOr(ws, 1), atOr(ws, 2), atOr(ws, 3), atOr(ws, 4), y, target, token)
        position="absolute" top=0 left=0 width=env.width height=env.height touch-action="none"
        aria-label="Photos" testId="pages"
      // SectionTabs styles.safeContainer (its white 90% is the canvas's): absolute at the top, a row; height
      // INDICATOR_CONTAINER_HEIGHT + DEMO_BUTTON_ROW_HEIGHT, padded by safeTop +
      // DEMO_BUTTON_ROW_HEIGHT at the top and the bottom inset at the bottom.
      row id="section-tabs" position="absolute" left=0 top=0 width=env.width
        height=(barHeight() + demoButtonRow()) box-sizing="border-box"
        padding-top=(env.safeTop + demoButtonRow()) padding-bottom="env(safe-area-inset-bottom)"
        z-index=1 testId="section-tabs"
        for title, i in titles() key=i
          // styles.container: flex 1, width / 5, centred, paddingHorizontal 8.
          column id=`tab-${i}` press=select(i) role="button" aria-label=title
            // pressto's PressableOpacity.
            pointerdown=pressIn(i) pointerup=pressOut opacity=pressableOpacity(pressing, i, pressto)
            transition=pressTransition("opacity", pressto)
            flex=1 width=(env.width / 5) align-items="center" justify-content="center"
            padding-left=8 padding-right=8 box-sizing="border-box" resize=measured(i) testId=`tab-${i}`
            // The title measured as Yoga measures it: at styles.title's 17 bold, one line.
            text title id=`tab-measure-${i}` position="absolute" opacity=0 resize=measured(i)
              font-size=17 font-weight=700 white-space="nowrap" aria-hidden=true pointer-events="none"
            // The Text's frame (left floored, 17's width, the tab's height): styles.title, #000,
            // bold, centred, drawn at adjustsFontSizeToFit's size.
            view position="absolute" top=(y) left=textLeft(env.width, atOr(tws, i))
              width=atOr(tws, i) height=textHeight(th) align-items="center" pointer-events="none"
              text title id=`tab-title-${i}` color="#000000" font-size=(17 * fitRatio(th / (17 * sfLine())))
                font-weight=700 text-align="center" white-space="nowrap" testId=`tab-title-${i}`
