// Airbnb Slider: a price from $0 to $4500 set by a slider; each digit rolls to its value, the
// leading zeros fade out and the number re-centres, the "$" following it. RN:
// src/animations/airbnb-slider (index.tsx, constants.ts, components/animated-count.tsx,
// animated-digit.tsx, components/animated-slider/index.liquid.tsx: the variant the
// liquid-glass resolver picks on iOS 26 and later, @expo/ui's SwiftUI Slider). The slider is
// SwiftUI's Slider through the `swift-slider` native view (as @expo/ui hosts it); the "$" and the digits, with their
// springs and fades, are gpu/src/airbnb_slider.rs, given the price.
use DemoEnv from "../env.contract"

component AirbnbSlider
  props
    env: DemoEnv
  // The slider's value (0…1): `sliderProgress`.
  state progress = 0
  // onSliderValueChange: price.set(Math.round(interpolate(value, [0, 1], [0, 4500], CLAMP))).
  action moved(v: string)
    progress = match parseNumber(v) { case some(n) => n, case none => progress }
  view
    // styles.container: Palette.background, centred.
    column position="absolute" inset=0 background-color="color(display-p3 0.8902 0.9255 0.9804)"
      align-items="center" justify-content="center" testId="airbnb-slider"
      // The price row (marginBottom 50): 36 tall, drawn across the screen's width.
      canvas surface=airbnb_slider(round(min(max(progress, 0), 1) * 4500)) width=env.width height=36
        margin-bottom=50 flex-shrink=0 testId="airbnb-slider-price" aria-label="Price"
      // The Host (width windowWidth − 90, height 60) and its SwiftUI Slider: `swift-slider`
      // (modules/apple/Demos.swift), expo-ui's Host and SliderView, the Slider at the Host's
      // top-leading corner (RN's justifyContent acts on no Yoga child).
      // The owner's call (phone feedback, 2026-11-15, "the slider isn't really centred"): RN's
      // Host puts the Slider at its top-leading corner, so the thumb sat 14 pt above the box's
      // middle and the price + slider group above the screen's centre. The Host's place stays
      // 60 tall; the Slider gets its own height (32: the iPhone's 24 pt thumb, 4 pt over and
      // under, measured on the phone's capture) centred in it, and its width in points: a
      // native view given `100%` took a narrower box on the phone (the track ended at ~55 %).
      // RN's Host: windowWidth − 90, centred (45 pt each side).
      column position="relative" width=env.width - 90 height=60 flex-shrink=0 justify-content="center"
        // The owner's call (phone feedback, 2026-11-15): the Slider's unfilled track (white at a
        // low alpha, as RN's) all but vanished on Palette.background. A neutral track sits under
        // it, where the phone's capture puts the native one (6 pt tall, its centre at 479.3 of 874
        // pt, the full width): the blue fill and the thumb cover it as RN's do. The thumb and
        // the track are centred on each other by the Slider itself (within half a point).
        view position="absolute" left=0 right=0 top=26.333 height=6 border-radius=3
          background-color="rgba(60, 60, 67, 0.18)" pointer-events="none" aria-hidden=true
        swift-slider progress="0" change=moved width=env.width - 90 height=32 flex-shrink=0
          role="slider" aria-label="Price" testId="airbnb-slider-range"
