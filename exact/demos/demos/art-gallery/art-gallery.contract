// Art Gallery: 10,000 photos in a grid that rearranges into a famous painting picked from the
// header menu. Pinch, pan and double tap zoom through it; a blurred button zooms back out.
// The mosaic, its gestures, springs and haptics are one Rust surface (gpu/src/art_gallery.rs).
// The header gradient, the title and the menu are Contract. A pick reaches the surface as
// (painting, picks).
use DemoEnv from "../env.contract"

// The menu's items, in order: `m <id> <name>` a movement, `p` a painter of the last movement,
// `t` a painting of the last painter, `|` a separator.
fn paintingItems(): string = "m renaissance Renaissance|p da-vinci Leonardo da Vinci|t mona-lisa Mona Lisa|t last-supper The Last Supper|p michelangelo Michelangelo|t creation-of-adam The Creation of Adam|p raphael Raphael|t school-of-athens The School of Athens|p botticelli Sandro Botticelli|t birth-of-venus The Birth of Venus|t primavera Primavera|m dutch-golden-age Dutch Golden Age|p vermeer Johannes Vermeer|t girl-with-pearl-earring Girl with a Pearl Earring|t the-milkmaid The Milkmaid|p rembrandt Rembrandt|t the-night-watch The Night Watch|t self-portrait-rembrandt Self Portrait|m romanticism Romanticism|p friedrich Caspar David Friedrich|t wanderer-above-sea-of-fog Wanderer Above the Sea of Fog|p delacroix Eugène Delacroix|t liberty-leading-the-people Liberty Leading the People|m impressionism Impressionism|p monet Claude Monet|t water-lilies Water Lilies|t impression-sunrise Impression, Sunrise|m post-impressionism Post-Impressionism|p van-gogh Vincent van Gogh|t starry-night The Starry Night|t sunflowers Sunflowers|t cafe-terrace Café Terrace at Night|m art-nouveau Art Nouveau|p klimt Gustav Klimt|t the-kiss The Kiss|m fauvism Fauvism|p matisse Henri Matisse|t the-dance The Dance|t the-music The Music|m expressionism Expressionism|p munch Edvard Munch|t the-scream The Scream|m surrealism Surrealism|p magritte René Magritte|t the-lovers The Lovers|p dali Salvador Dalí|t persistence-of-memory The Persistence of Memory|m american-realism American Realism|p hopper Edward Hopper|t nighthawks Nighthawks|t morning-sun Morning Sun|m ukiyo-e Ukiyo-e|p hokusai Katsushika Hokusai|t the-great-wave The Great Wave off Kanagawa"

component ArtGallery
  props
    env: DemoEnv
  state painting = ""
  state picks = 0
  action pick(id: string)
    painting = id
    picks = picks + 1
  action buzz(m: string)
    if m == "haptic:selection"
      haptic("selection")
    if m == "haptic:impact-light"
      haptic("impact-light")
    if m == "haptic:impact-medium"
      haptic("impact-medium")
  view
    column position="absolute" inset=0 background-color="#000000" testId="art-gallery"
      canvas surface=art_gallery(painting, picks) position="absolute" top=0 left=0 width=env.width
        height=env.height touch-action="none" message=buzz testId="art-gallery-canvas"
        aria-label="Mosaic: pinch or double tap to zoom, drag to move"
      // A dark fade behind the header.
      column position="absolute" top=0 left=0 right=0 height=(env.safeTop + 180) pointer-events="none"
        background-image="linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0))"
        aria-hidden=true
      row position="absolute" top=env.safeTop left=0 right=0 height=44 align-items="center"
        justify-content="center" pointer-events="none"
        text "Gallery" font-size=17 font-weight=600 color="#ffffff" testId="art-gallery-title"
      // A liquid-glass menu button: a SwiftUI menu (modules/apple/PaintingMenu.swift) with nested
      // menus of toggles, movement, then painter, then painting. A pick closes it. Its change is
      // the picked painting's id, "" for Default. The web shows an empty box.
      painting-menu change=pick selected=painting items=paintingItems() position="absolute"
        top=env.safeTop right=16 width=48 height=48 z-index=1000 aria-label="Choose a painting"
        testId="painting-menu"
