// Linear Sensors: a dark rounded square with a logo that tilts in 3D as the phone tilts, its shadow
// moving against the tilt. Drawn in Rust, reading the `gravity` sensor.
// `motion-feed` (modules/apple/MotionFeed.swift) writes Core Motion's gravity at 50 Hz (RN's interval
// 20) into the canvas while this demo is on screen; it says why @exact/motion's startSensorInput is not
// used. Without samples the square rests at rotateX π/8, rotateY 0.

component LinearSensors
  view
    canvas surface=linear_sensors() position="absolute" top=0 left=0 width="100%" height="100%"
      testId="linear-sensors-canvas" aria-label="Tilt the phone"
    motion-feed feed="linear_sensors" frequency=50 position="absolute" left=0 top=0 width=0 height=0
      aria-hidden=true testId="linear-sensors-feed"
at "/demo/linear-sensors"
