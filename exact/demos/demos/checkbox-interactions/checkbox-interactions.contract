// Checkbox Interactions: twenty "Italian" chips; a tap checks one, its check fades in and the
// chip reflows. RN: src/animations/checkbox-interactions (src/index.tsx, components/checkbox.tsx).
use PressableScale from "pressto"
use DemoEnv, demoButtonRow from "../env.contract"

// FadeIn / FadeOut 150 ms on bezier(0.895, 0.03, 0.685, 0.22).
keyframes checkIn
  from opacity=0
keyframes checkOut
  to opacity=0

component CheckboxInteractions
  props
    env: DemoEnv
  state checked: number[] = []
  action toggle(i: number)
    haptic("selection")
    checked = checked.includes(i) ? checked.filter(c => c != i) : checked.concat([i])
  view
    column position="absolute" inset=0 background-color="#0C0A0C" padding-top=(env.safeTop + demoButtonRow()) padding-left=12
      testId="checkbox-interactions"
      text "What are your favorite cuisines?" font-family="ui-rounded" font-weight=700 font-size=24
        color="#ffffff"
      row flex-wrap="wrap" gap=12 margin-top=24
        for i in range(20) key=i
          Checkbox(label="Italian", checked=checked.includes(i), press=toggle(i), testId=`cuisine-${i}`)

component Checkbox
  props
    label: string
    checked: bool
    press: action
    testId: string
  view
    button appearance="none" press=press testId=testId aria-pressed=checked class=PressableScale
      display="flex" flex-direction="row" align-items="center" justify-content="center"
      padding=(checked ? "12px 14px 12px 24px" : "12px 24px") border-radius=36 corner-shape="squircle"
      border-width=1.5 border-style="solid"
      border-color=(checked ? "rgba(239, 142, 82, 0.1)" : "rgba(179, 177, 180, 0.1)")
      background-color=(checked ? "rgba(239, 142, 82, 0.1)" : "rgba(239, 142, 82, 0)")
      // LinearTransition.springify(): mass 1, damping 30, stiffness 250.
      -exact-layout-transition="-exact-spring(250, 30, 1)"
      text label font-family="ui-rounded" font-weight=700 font-size=18
        color=(checked ? "#EF8E52" : "#B3B1B4")
      if checked
        image "symbol:sf/checkmark.circle.fill" testId=`${testId}-check` margin-left=10 font-size=20 color="#EF8E52"
          aria-hidden=true
          animation="checkIn 150ms cubic-bezier(0.895, 0.03, 0.685, 0.22) both"
          -exact-exit-animation="checkOut 150ms cubic-bezier(0.895, 0.03, 0.685, 0.22) both"
