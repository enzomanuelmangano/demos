// Scrollable shapes: 3000 glowing points spinning in perspective on black, morphing between a
// sphere, a cube, a torus and a heart as the screen is swiped sideways. Four dots show which.
// Drawn in Rust (gpu/src/scrollable_shapes.rs, gpu/src/ui_scroll.rs).

component ScrollableShapes
  // Selection as the shape changes; rigid when the scroll is pulled past an end.
  action heard(m: string)
    if m == "haptic:selection"
      haptic("selection")
    if m == "haptic:impact-rigid"
      haptic("impact-rigid")
  view
    column position="absolute" inset=0 background-color="color(display-p3 0 0 0)" testId="scrollable-shapes"
      canvas surface=scrollable_shapes() message=heard position="absolute" top=0 left=0 width="100%" height="100%"
        touch-action="none" testId="scrollable-shapes-canvas" aria-label="Swipe to morph the shape"
