// The demos' bundled faces (src/navigation/fonts.ts), declared once for every demo.
font "FiraCode-Regular" = "assets/fonts/FiraCode-Regular.ttf"
font "Honk-Regular" = "assets/fonts/Honk-Regular.otf"
font "Honk-Bold" = "assets/fonts/Honk-Bold.otf"
font "regular" = "assets/fonts/regular.ttf"
font "AddingtonCF-Light" = "assets/fonts/AddingtonCF-Light.otf"
font "SF-Pro-Rounded-Bold" = "assets/fonts/SF-Pro-Rounded-Bold.otf"

// What a demo may read of its host, handed down from the root (a child declares no resource).

// The screen in points, the status bar's inset over it (RN's `useSafeAreaInsets().top`), the
// home indicator's under it (`useSafeAreaInsets().bottom`), a
// per-launch random seed (exactTime().seed), reduced motion, and the date the demo opened on:
// `epoch` is Unix ms at the app's launch, `utcOffset` minutes east of UTC (RN's `new Date()`).
// `timers`: on the web, the token each live `timer` surface last fired (gpu/src/timer.rs; the web
// host delivers no surface message); always empty on iOS, where the timer's message runs.
shape DemoEnv
  width: number
  height: number
  safeTop: number
  safeBottom: number
  epoch: number
  utcOffset: number
  seed: number
  reducedMotion: bool
  timers: number[]

// Math.random() for a demo: `roll(seed, k, n)` is a whole number from 0 to n - 1, the k-th
// draw of the stream `seed` names (Exact's random-rolls recipe: integer-only, so every host
// rolls the same).
fn turn(x: number): number = (x % 65536) * 32768 + floor(x / 65536)
fn stir(x: number): number = turn((x * (16807 + floor(x / 65536))) % 2147483647)
fn roll(seed: number, k: number, n: number): number = floor(stir(stir(stir(1 + (stir(stir(1 + seed % 2147483646)) + k) % 2147483646))) * n / 2147483647)

// demo-close-button.tsx DEMO_BUTTON_ROW_HEIGHT: a demo with content at its top starts it this
// far below the safe area, under the close button's row.
fn demoButtonRow(): number = 56
