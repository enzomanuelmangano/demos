// The demos' bundled faces (src/navigation/fonts.ts), declared once for every demo.
font "FiraCode-Regular" = "assets/fonts/FiraCode-Regular.ttf"
font "Honk-Regular" = "assets/fonts/Honk-Regular.otf"
font "Honk-Bold" = "assets/fonts/Honk-Bold.otf"
font "regular" = "assets/fonts/regular.ttf"
font "AddingtonCF-Light" = "assets/fonts/AddingtonCF-Light.otf"
font "SF-Pro-Rounded-Bold" = "assets/fonts/SF-Pro-Rounded-Bold.otf"

// What a demo may read of its host, handed down from the root.
// Screen size in points, safe-area insets, a per-launch random seed, reduced motion, and the launch
// date: epoch is Unix ms, utcOffset is minutes east of UTC. timers holds the token each live timer
// last fired on the web; it stays empty on iOS, where the timer's message runs.
shape DemoEnv
  width: number
  height: number
  safeTop: number
  safeBottom: number
  epoch: number
  utcOffset: number
  seed: number
  reducedMotion: bool
  timers: number[]
  // Inside the Mac atlas's tiles: the demo takes no keyboard focus, which would take the window's from the atlas.
  tile: bool
  // The web host: it has no native views (glass-pane and the other modules), so a demo draws its own stand-in there.
  web: bool

// roll(seed, k, n): the k-th draw of the stream `seed`, a whole number from 0 to n - 1. Integer-only,
// so every host rolls the same.
fn turn(x: number): number = (x % 65536) * 32768 + floor(x / 65536)
fn stir(x: number): number = turn((x * (16807 + floor(x / 65536))) % 2147483647)
fn roll(seed: number, k: number, n: number): number = floor(stir(stir(stir(1 + (stir(stir(1 + seed % 2147483646)) + k) % 2147483646))) * n / 2147483647)

// Content at the top of a demo starts this far below the safe area, under the close button's row.
fn demoButtonRow(): number = 56

// Bottom UI is concentric with the display: its corner arc shares a centre with the display's
// corner arc (radius 62). A box inset i from the sides and bottom, with radius r, is concentric
// when i + r = 62. Short boxes that cannot take that radius become capsules, and their inset
// follows from their height. Use floatingInset(want, h) for the inset and concentricRadius(i, h)
// for the radius. A circle in the corner sits concentricInset(d) from the sides and bottom.
fn displayCorner(): number = 62
fn floatingWidth(screenWidth: number, inset: number): number = screenWidth - 2 * inset
fn concentricInset(height: number): number = max(displayCorner() - height / 2, 8)
fn floatingInset(inset: number, height: number): number = max(inset, concentricInset(height))
fn concentricRadius(inset: number, height: number): number = min(displayCorner() - inset, height / 2)
