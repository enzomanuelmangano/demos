// The demos' bundled faces (src/navigation/fonts.ts), declared once for every demo.
font "FiraCode-Regular" = "assets/fonts/FiraCode-Regular.ttf"
font "Honk-Regular" = "assets/fonts/Honk-Regular.otf"
font "Honk-Bold" = "assets/fonts/Honk-Bold.otf"
font "regular" = "assets/fonts/regular.ttf"
font "AddingtonCF-Light" = "assets/fonts/AddingtonCF-Light.otf"
font "SF-Pro-Rounded-Bold" = "assets/fonts/SF-Pro-Rounded-Bold.otf"

// What a demo may read of its host, handed down from the root (a child declares no resource).

// The screen in points, the status bar's inset over it (RN's `useSafeAreaInsets().top`), the
// home indicator's under it (`useSafeAreaInsets().bottom`), a
// per-launch random seed (exactTime().seed), reduced motion, and the date the demo opened on:
// `epoch` is Unix ms at the app's launch, `utcOffset` minutes east of UTC (RN's `new Date()`).
// `timers`: on the web, the token each live `timer` surface last fired (gpu/src/timer.rs; the web
// host delivers no surface message); always empty on iOS, where the timer's message runs.
shape DemoEnv
  width: number
  height: number
  safeTop: number
  safeBottom: number
  epoch: number
  utcOffset: number
  seed: number
  reducedMotion: bool
  timers: number[]
  // True inside the Mac atlas's tiles and large view (home/atlas.contract airEnv): a demo there
  // takes no keyboard focus of its own (it would take the window's from the atlas).
  tile: bool

// Math.random() for a demo: `roll(seed, k, n)` is a whole number from 0 to n - 1, the k-th
// draw of the stream `seed` names (Exact's random-rolls recipe: integer-only, so every host
// rolls the same).
fn turn(x: number): number = (x % 65536) * 32768 + floor(x / 65536)
fn stir(x: number): number = turn((x * (16807 + floor(x / 65536))) % 2147483647)
fn roll(seed: number, k: number, n: number): number = floor(stir(stir(stir(1 + (stir(stir(1 + seed % 2147483646)) + k) % 2147483646))) * n / 2147483647)

// demo-close-button.tsx DEMO_BUTTON_ROW_HEIGHT: a demo with content at its top starts it this
// far below the safe area, under the close button's row.
fn demoButtonRow(): number = 56

// Bottom floating UI is concentric with the display (the owner's rule, iOS 26's floating
// sheets and tab bars). Concentric means the box's corner arc shares its CENTRE with the
// display corner's arc: the display's corner (radius R = 62, the iPhone 17 / Air's: Exact exposes
// none, home/atlas.contract airCorner) is centred R in from the side and R up from the bottom;
// a box `inset` from the sides and the bottom of the DISPLAY (not above the home indicator) with
// radius r is centred inset + r in. Same centre ⇔ inset + r = R. Two cases:
//   - a tall box (a sheet, a card): r = R − inset fits (≤ h/2): `concentricRadius(inset, h)`.
//   - a short box whose R − inset > h/2 can't take that radius: it is a capsule (r = h/2) and
//     the INSET follows from its height: `concentricInset(h)` = R − h/2 (a 60 bar sits 32 in,
//     a 52 button 36). A min(R − inset, h/2) capsule at a small inset is NOT concentric: its
//     30 pt end sits inside the 62 pt display curve and looks off.
// `floatingInset(inset, h)` picks for you: `inset` when the box is tall enough, else
// concentricInset(h). Use: `left=i bottom=i width=floatingWidth(env.width, i)
// border-radius=concentricRadius(i, h)` with i = floatingInset(want, h), continuous corners.
// A circle in a corner: its centre on the corner arc's centre, R − d/2 + d/2 = R in → its
// edge R − d/2 from the side and the bottom (concentricInset(d)). Inner rows padded `p` in a
// concentric card are concentric with it by the same rule (card radius − p, or a capsule whose
// padding is card radius − h/2).
fn displayCorner(): number = 62
fn floatingWidth(screenWidth: number, inset: number): number = screenWidth - 2 * inset
fn concentricInset(height: number): number = max(displayCorner() - height / 2, 8)
fn floatingInset(inset: number, height: number): number = max(inset, concentricInset(height))
fn concentricRadius(inset: number, height: number): number = min(displayCorner() - inset, height / 2)
