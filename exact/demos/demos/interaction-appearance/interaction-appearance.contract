// Interaction Appearance: a movie page whose floating sun button switches the light and dark
// themes; while it is held the page shrinks, the poster's glow fades and a blur rises over it.
use DemoEnv, demoButtonRow from "../env.contract"

component InteractionAppearance
  props
    env: DemoEnv
  action buzz(m: string)
    if m == "haptic:selection"
      haptic("selection")
  view
    column position="absolute" inset=0 testId="interaction-appearance"
      // The page starts below the demo's button row, clear of the close and info buttons.
      canvas surface=interaction_appearance(env.safeTop + demoButtonRow(), env.safeBottom) position="absolute" top=0 left=0
        width=env.width height=env.height touch-action="none" message=buzz
        testId="interaction-appearance-canvas"
        aria-label="Past Lives: hold the sun button to switch the theme"
