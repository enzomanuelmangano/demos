// Fractal Glass: an orange circle dragged behind a pane of reeded (fluted) glass, each flute a
// lens that refracts and frosts it. It is dark only.

component FractalGlass
  // Haptics: a light one when a drag takes the circle, one selection as it goes behind the glass;
  // never two within 150 ms (the surface decides).
  action heard(m: string)
    if m == "haptic:impact-light"
      haptic("impact-light")
    if m == "haptic:selection"
      haptic("selection")
  view
    // The canvas draws the black background and the circle.
    column position="absolute" inset=0 testId="fractal-glass"
      canvas surface=fractal_glass(1) message=heard position="absolute" top=0 left=0 width="100%"
        height="100%" touch-action="none" testId="fractal-glass-canvas"
        aria-label="Drag the circle behind the glass"
