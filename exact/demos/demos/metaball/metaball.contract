// Metaball: two circles that melt into one, each dragged by a finger; let go, each springs back
// to the centre. Drawn, dragged and sprung in Rust (gpu/src/metaball.rs).

component Metaball
  // The surface's haptics: grab, stretch ticks, pinch-off and melt, settle.
  action buzz(m: string)
    if m == "haptic:selection"
      haptic("selection")
    if m == "haptic:impact-soft"
      haptic("impact-soft")
    if m == "haptic:impact-light"
      haptic("impact-light")
    if m == "haptic:impact-medium"
      haptic("impact-medium")
    if m == "haptic:impact-rigid"
      haptic("impact-rigid")
  view
    canvas surface=metaball() message=buzz position="absolute" top=0 left=0 width="100%" height="100%" touch-action="none"
      background-color="#0A0A0A"
      testId="metaball" aria-label="Two circles to drag apart and together"
