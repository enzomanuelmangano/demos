// iMessage Stack: ten pastel cards in a fanned stack; a horizontal swipe brings the next card to
// the front, the one leaving swinging aside. One canvas handles the swipe, one card per fling.
use DemoEnv from "../env.contract"

component ImessageStack
  props
    env: DemoEnv
  // Haptics: selection as the front card changes, rigid when pulled past an end.
  action heard(m: string)
    if m == "haptic:selection"
      haptic("selection")
    if m == "haptic:impact-rigid"
      haptic("impact-rigid")
  view
    column position="absolute" inset=0 background-color="#000" testId="imessage-stack"
      canvas surface=imessage_stack() message=heard position="absolute" top=0 left=0 width=env.width
        height=env.height touch-action="none" aria-label="Cards: swipe sideways"
        testId="imessage-scroll"
