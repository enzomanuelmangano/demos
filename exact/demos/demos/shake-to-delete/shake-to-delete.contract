// The settle: withTiming(0, { duration: 150 }) from the pose the jiggle stopped at. The box's
// own translate and rotate are that pose (shakeX / shakeR of the progress it stopped at); the
// keyframes have no `from`, so they start there and run both to 0, linear in the eased time,
// which is RN's value: p(t) = p0 (1 - inOut(quad)(t / 150)) maps to translate and rotation
// linearly (p keeps its sign, so the rotation stays on one side of its kink at 0).
keyframes settleZero
  to translate="0px 0px" rotate="0deg"

component ShakeToDelete
  props
    env: DemoEnv
  // use-is-shaking.ts isShaking, shared by every tile.
  state shaking = false
  state shakeStart = 0
  state stopAt = 0
  // The deleted tiles, each with the slot it held: it fades out there.
  state gone = []
  state goneSlot = []
  derive live = range(24).filter(id => not gone.includes(id))
  action toggle
    if shaking
      shaking = false
      stopAt = performanceNow()
    else
      shaking = true
      shakeStart = performanceNow()
  // onDelete: stopShaking(), then the tile leaves the list 150 ms later.
  action remove(id: number)
    haptic("selection")
    if shaking and not gone.includes(id)
      shaking = false
      stopAt = performanceNow()
      gone = gone.concat([id])
      goneSlot = goneSlot.concat([live.indexOf(id)])
  view
    // index.tsx: LinearGradient ['#000000', '#121212'], top to bottom, filling the screen.
    column position="absolute" inset=0 overflow="hidden"
      background-image="linear-gradient(180deg, #000000 0%, #121212 100%)" testId="shake-to-delete"
      for id in range(24) key=id
        AppItem(id=id, size=tileSize(env.width),
          left=slotLeft(env.width, gone.includes(id) ? match goneSlot.at(gone.indexOf(id)) { case some(k) => k, case none => 0 } : live.indexOf(id)),
          top=slotTop(env.width, env.safeTop, gone.includes(id) ? match goneSlot.at(gone.indexOf(id)) { case some(k) => k, case none => 0 } : live.indexOf(id)),
          shaking=shaking, elapsed=(stopAt - shakeStart), settled=(stopAt > 0), gone=gone.includes(id),
          hold=toggle, remove=remove(id))

component AppItem
  props
    id: number
    size: number
    left: number
    top: number
    shaking: bool
    elapsed: number
    settled: bool
    gone: bool
    hold: action
    remove: action
  inject
    pressto: PressablesConfig
    pressablesOnPress: action
  // pressto: the pressed pressable (its key) and the press parity.
  state pressing = pressNone()
  action pressIn(key: number)
    pressing = pressDown(pressing, key)
  action pressOut
    pressing = pressUp(pressing)
  view
    // The tile's place in the grid; LinearTransition.duration(350) when the others reflow, and
    // FadeOut when it leaves, both 150 ms after the delete.
    view position="absolute" left=left top=top width=size height=size display="flex" flex-direction="column"
      -exact-layout-transition="350ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%) 150ms"
      animation=(gone ? "tileOut 300ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%) 150ms both" : "none")
      pointer-events=(gone ? "none" : "auto") aria-hidden=gone testId=`app-${id}`
      // styles.itemContainer + rShakingStyle: padding SPACING + 6 (14), transform
      // [translateX, rotate].
      column flex=1 padding=14
        translate=(shaking or not settled ? "0px 0px" : shakeX(id, stopP(id, elapsed)))
        rotate=(shaking or not settled ? "0deg" : shakeR(id, stopP(id, elapsed)))
        animation=(shaking ? `shake${id} ${4 * legMs(id)}ms linear infinite` : (settled ? `settleZero ${settleTiming()}` : "none"))
        // The PressableOpacity: onLongPress toggles the shaking.
        view flex=1 display="flex" flex-direction="column" contextmenu=hold role="button"
          pointerdown=pressIn(0) pointerup=pressOut
          opacity=pressableOpacity(pressing, 0, pressto) transition=pressTransition("opacity", pressto)
          aria-label=`App ${id + 1}`
          testId=`app-${id}-tile`
          // styles.deleteButtonContainer: absolute at -4, -4, zIndex 1; opacity
          // withTiming(isShaking ? 1 : 0), touchable only while shaking.
          view position="absolute" left=-4 top=-4 z-index=1 opacity=(shaking ? 1 : 0)
            pointer-events=(shaking ? "auto" : "none")
            transition="opacity 300ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%)"
            // styles.deleteButton: 20 × 20, rgba(255,255,255,0.8), radius 100; Ionicons "remove"
            // 12 black.
            view display="flex" flex-direction="column" width=20 height=20 border-radius=100
              pointerdown=pressIn(1) pointerup=pressOut
              opacity=pressableOpacity(pressing, 1, pressto) transition=pressTransition("opacity", pressto)
              background-color="rgba(255, 255, 255, 0.8)" align-items="center" justify-content="center"
              press=remove role="button" aria-label="Delete" testId=`app-${id}-delete`
              // Ionicons "remove" 12: the vector-icons glyph (512 × 525 units of 512 to the em).
              svg width=12 height=12.3047 viewBox="0 0 512 525" aria-hidden=true
                path d="M108 246Q108 246 108 246Q111 246 257 246Q257 246 404 246L408 248Q416 253 416 262Q416 271 408 276Q408 276 405 278H256H107L104 276Q91 268 98 254Q101 248 108 246Z" fill="#000000"
          // styles.gradient: radius 16 continuous, flex 1, overflow hidden.
          view flex=1 border-radius=16 corner-shape="-exact-continuous" overflow="hidden"
            background-image=gradientOf(match tileColors().at(id) { case some(cs) => cs, case none => [] })
