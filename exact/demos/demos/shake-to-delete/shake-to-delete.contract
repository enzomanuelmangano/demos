// Shake to Delete: a grid of metallic app tiles; a long press makes them jiggle as on the
// iPhone's home screen, each with a minus badge that deletes its tile (the rest reflow); a
// second long press stops them. RN: src/animations/shake-to-delete (index.tsx,
// apps-list/index.tsx, app-item.tsx, constants.ts, hooks/animation-config.ts,
// hooks/use-is-shaking.ts, hooks/use-shaking-animation.ts).
use PressableOpacity from "pressto"
use DemoEnv from "../env.contract"

// constants.ts APPS_DATA = METALLIC_APPS_DATA_RAW with id = index.
fn tileColors(): string[][] = [
  ["#E8E9ED", "#B8B9BD", "#D1D2D6"], ["#FFFFFF", "#C8CBD0", "#E6E8EA"], ["#F5F5F5", "#C0C0C0", "#DEDEDE"],
  ["#FFFFFF", "#C4C4C4", "#E8E8E8"], ["#595C63", "#2A2D33", "#424548"], ["#E5E5E5", "#B0B0B0", "#CCCCCC"],
  ["#B4B7BC", "#7F8287", "#9A9DA2"], ["#FFFFFF", "#D6D6D6", "#F0F0F0"], ["#DEE3ED", "#A5AAB3", "#C2C7D0"],
  ["#9B9B9E", "#636366", "#818184"], ["#F0F2F5", "#B8BBC0", "#D6D9DD"], ["#B3B5B1", "#7D7F7B", "#989A96"],
  ["#D0D3D8", "#9CA0A5", "#B6B9BE"], ["#F2F2F2", "#BABABA", "#DADADA"], ["#D6D6D6", "#A0A0A0", "#BCBCBC"],
  ["#CDD0D4", "#959AA0", "#B3B6BA"], ["#C4C4C4", "#8F8F8F", "#ABABAB"], ["#E8E9EC", "#B5B7BA", "#CED0D3"],
  ["#A6A9AD", "#6D7074", "#8C8F93"], ["#97999C", "#5F6164", "#7D7F82"], ["#C7CBD2", "#939AA4", "#ADB1C7"],
  ["#F5F6F8", "#B4B6B8", "#DCDDDF"], ["#FFFFFF", "#C3C3C6", "#E6E6E8"], ["#E2E5E8", "#A1A4A7", "#C9CCD0"],
]
// LinearGradient start (0, 0) end (1, 1), the colours evenly spaced (a square tile: 135deg).
fn gradientOf(cs: string[]): string = `linear-gradient(135deg, ${cs.join(", ")})`

// apps-list/index.tsx: SPACING 8, NUM_COLUMNS 4; horizontalPadding 16; itemSize =
// floor((width - 16 - 8 × 3) / 4 - 2); each tile marginRight 8, marginBottom 8, padding 14,
// aspectRatio 1, in a wrapping row padded safeTop at the top and 8 at the sides.
fn tileSize(w: number): number = floor((w - 16 - 8 * 3) / 4 - 2)
fn slotLeft(w: number, k: number): number = 8 + (k % 4) * (tileSize(w) + 8)
fn slotTop(w: number, top: number, k: number): number = top + floor(k / 4) * (tileSize(w) + 8)

// use-shaking-animation.ts: generateRandom(id) (LCG 9301, 49297, 233280) returns the same draw
// on every call, so amplitude, duration, rotation amplitude and base rotation share one r.
fn draw(id: number): number = (((id * 9301 + 49297) % 233280) * 9301 + 49297) % 233280 / 233280
// animation-config.ts BASE: AMPLITUDE 1 + 0.2 r, DURATION 80 + 40 r, ROTATION_AMPLITUDE 1 + 2 r,
// ROTATION_BASE -3 + 6 r.
fn amp(id: number): number = 1 + draw(id) * 0.2
fn legMs(id: number): number = 80 + draw(id) * 40
fn rotAmp(id: number): number = 1 + draw(id) * 2
fn rotBase(id: number): number = -3 + draw(id) * 6
// translateX interpolate(progress, [-1, 0, 1], [-amplitude, 0, amplitude]); rotate
// interpolate(progress, [-1, 0, 1], [base - rotAmp, 0, base + rotAmp]) deg.
fn shakeX(id: number, p: number): string = `${amp(id) * p}px 0px`
fn rotDeg(id: number, p: number): number = p < 0 ? (0 - p) * (rotBase(id) - rotAmp(id)) : p * (rotBase(id) + rotAmp(id))
fn shakeR(id: number, p: number): string = `${rotDeg(id, p)}deg`

// progress = withRepeat(withSequence(withTiming(-1, d), withTiming(1, 2d), withTiming(0, d)),
// -1, true): the reverse flag only swaps a sequence's own toValue, which it never reads, so the
// sequence repeats as written, a 4d period. Each leg is Easing.inOut(Easing.quad): exactly an
// ease-in quad to the leg's midpoint and an ease-out quad after it (t² is the cubic-bezier
// (1/3, 0, 2/3, 1/3)), so the keyframes stop at every half leg; the rotation's kink at 0 falls
// on a stop.
fn inOutQuad(s: number): number = s < 0.5 ? 2 * s * s : 1 - 2 * (1 - s) * (1 - s)
fn phaseOf(id: number, elapsed: number): number = (elapsed - floor(elapsed / (4 * legMs(id))) * 4 * legMs(id)) / (4 * legMs(id))
fn progressAt(f: number): number = f < 0.25 ? 0 - inOutQuad(f / 0.25) : (f < 0.75 ? -1 + 2 * inOutQuad((f - 0.25) / 0.5) : 1 - inOutQuad((f - 0.75) / 0.25))

// Not shaking: withTiming(0, { duration: 150 }) from wherever the jiggle was. A hidden box
// sits at 100 px while shaking and slides to 0 over 150 ms on inOut(quad) when it stops: a drag
// timeline. Each tile's settle keyframes are its p ∈ [-1, 1] (translate and rotation linear in
// p on each side of 0); the range maps the box's 100 px to the p it stopped at and 0 px to 0.
fn stopP(id: number, elapsed: number): number = progressAt(phaseOf(id, elapsed))
fn absOf(x: number): number = x < 0 ? 0 - x : x
fn settleOf(id: number, elapsed: number): string = absOf(stopP(id, elapsed)) < 0.0001 ? "none" : `${stopP(id, elapsed) < 0 ? "settleBack" : "settle"}${id} 1s linear both`
fn settleRange(id: number, elapsed: number): string = `${0 - 100 / max(0.0001, absOf(stopP(id, elapsed)))}px ${100 / max(0.0001, absOf(stopP(id, elapsed)))}px`

// Reanimated's withTiming default curve, Easing.inOut(Easing.quad), as its cubic-bezier.
// FadeOut: 300 ms. The delete waits 150 ms (setTimeout) before the tile leaves the list: its
// fade and the others' LinearTransition.duration(350) start 150 ms after the press.
keyframes tileOut
  to opacity=0

keyframes shake0
  0% translate=shakeX(0, 0) rotate=shakeR(0, 0) animation-timing-function="cubic-bezier(0.333333, 0, 0.666667, 0.333333)"
  12.5% translate=shakeX(0, -0.5) rotate=shakeR(0, -0.5) animation-timing-function="cubic-bezier(0.333333, 0.666667, 0.666667, 1)"
  25% translate=shakeX(0, -1) rotate=shakeR(0, -1) animation-timing-function="cubic-bezier(0.333333, 0, 0.666667, 0.333333)"
  50% translate=shakeX(0, 0) rotate=shakeR(0, 0) animation-timing-function="cubic-bezier(0.333333, 0.666667, 0.666667, 1)"
  75% translate=shakeX(0, 1) rotate=shakeR(0, 1) animation-timing-function="cubic-bezier(0.333333, 0, 0.666667, 0.333333)"
  87.5% translate=shakeX(0, 0.5) rotate=shakeR(0, 0.5) animation-timing-function="cubic-bezier(0.333333, 0.666667, 0.666667, 1)"
  100% translate=shakeX(0, 0) rotate=shakeR(0, 0)
