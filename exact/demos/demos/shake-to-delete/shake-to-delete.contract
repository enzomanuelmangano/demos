  75% translate=shakeX(1, 1) rotate=shakeR(1, 1) animation-timing-function="cubic-bezier(0.333333, 0, 0.666667, 0.333333)"
  87.5% translate=shakeX(1, 0.5) rotate=shakeR(1, 0.5) animation-timing-function="cubic-bezier(0.333333, 0.666667, 0.666667, 1)"
