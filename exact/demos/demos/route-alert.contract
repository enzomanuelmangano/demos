// RN's Alert.alert (UIAlertController .alert, the app's dark appearance), drawn in the demo's own
// route. A `dialog` opened with showModal from the full-screen demo route is never presented on
// the phone (the route's owner controller already presents it; see home/demo-screen.contract's
// Inspiration sheet), so a demo that asks would not respond at all (sudoku's New Game).
//
// iOS 26's alert: a glass panel 300 wide with continuous corners, the title (17 semibold) and
// message (15) leading-aligned, the actions as capsules side by side (a cancel action first),
// a destructive action's label in systemRed. It appears scaled from 1.1 with a fade over a
// dimmed screen and leaves with a fade. A tap outside does nothing, as UIKit's alert.
//
// Above everything in the demo (z-index 1000): a full-screen canvas takes the touches under it
// on iOS whatever its pointer-events.

keyframes routeAlertIn
  from opacity=0 scale=1.1
  to opacity=1 scale=1

component RouteAlert
  props
    shown: bool
    title: string
    message: string
    // The cancel action's label ("" for none) and the other action's.
    cancel: string
    confirm: string
    destructive: bool
    // Each button closes the alert: `dismiss` for the cancel action, `accept` for the other.
    dismiss: action
    accept: action
    testId: string
  view
    view position="absolute" inset=0 z-index=1000 display="flex" flex-direction="column"
      align-items="center" justify-content="center"
      background-color=(shown ? "rgba(0, 0, 0, 0.48)" : "rgba(0, 0, 0, 0)")
      transition="background-color 250ms ease-out"
      pointer-events=(shown ? "auto" : "none") aria-hidden=(not shown) testId=testId
      if shown
        column role="alertdialog" aria-label=title width=300 color-scheme="dark"
          backgroundMaterial="regular" border-radius=34 corner-shape="-exact-continuous"
          padding="22px 18px 18px" gap=4 align-items="stretch"
          animation="routeAlertIn 300ms cubic-bezier(0.32, 0.72, 0, 1) both"
          -exact-exit-animation="routeAlertOut 150ms ease-in both"
          text title font-size=17 font-weight=600 color="#ffffff" padding="0px 6px"
          text message font-size=15 color="rgba(235, 235, 245, 0.7)" padding="0px 6px"
          row gap=10 margin-top=18
            if cancel != ""
              button appearance="none" press=dismiss flex=1 height=48 border-radius=24
                background-color="rgba(255, 255, 255, 0.12)" text-align="center"
                testId=`${testId}-cancel`
                text cancel font-size=17 font-weight=600 color="#ffffff"
            button appearance="none" press=accept flex=1 height=48 border-radius=24
              background-color="rgba(255, 255, 255, 0.12)" text-align="center"
              testId=`${testId}-confirm`
              text confirm font-size=17 font-weight=600
                color=(destructive ? "#FF4245" : "#0091FF")

keyframes routeAlertOut
  to opacity=0
