// Email Demo: a list of ten emails; the red button deletes the top one (it fades out as the list
// slides up a row and the next one is highlighted), the green one restores it, and either shakes
// when there is nothing left to do. RN: src/animations/email-demo (index.tsx, constants.ts,
// components/interactive-list, components/list-item, hooks/use-animated-shake.ts).
use PressableScale from "pressto"
use DemoEnv, demoButtonRow from "../env.contract"

shape Email
  imageUrl: string
  title: string
  subtitle: string

// constants.ts INITIAL_ITEMS (the photos are bundled with the rows' surface, as RN requests them:
// w=400&h=400, gpu/images/email-demo).
fn photo(id: string): string = `https://images.unsplash.com/photo-${id}?w=400&h=400&fit=crop&crop=faces`
fn items(): Email[] = [
  Email(imageUrl=photo("1557804506-669a67965ba0"), title="Welcome to our community", subtitle="Get started with your new account and explore amazing features."),
  Email(imageUrl=photo("1472099645785-5658abf4ff4e"), title="Security verification required", subtitle="Please verify your identity to secure your account."),
  Email(imageUrl=photo("1507003211169-0a1dd7228f2d"), title="Your order has been confirmed", subtitle="Thank you for your purchase. Order #12345 is being processed."),
  Email(imageUrl=photo("1573496359142-b8d87734a5a2"), title="Team meeting reminder", subtitle="Don't forget about today's meeting at 2:00 PM."),
  Email(imageUrl=photo("1500648767791-00dcc994a43e"), title="Payment successful", subtitle="Your payment of $29.99 has been processed successfully."),
  Email(imageUrl=photo("1438761681033-6461ffad8d80"), title="New message from Sarah", subtitle="Hey! Are we still on for lunch tomorrow?"),
  Email(imageUrl=photo("1519085360753-af0119f7cbe7"), title="Weekly newsletter", subtitle="Here are this week's top stories and updates."),
  Email(imageUrl=photo("1534528741775-53994a69daeb"), title="Password reset request", subtitle="Click here to reset your password within 24 hours."),
  Email(imageUrl=photo("1506794778202-cad84cf45f1d"), title="Event invitation", subtitle="You're invited to our annual conference next month."),
  Email(imageUrl=photo("1517841905240-472988babdf9"), title="App update available", subtitle="Version 2.1 is now available with new features."),
]

// index.tsx: ITEM_HEIGHT 100, ITEM_MARGIN 10; the list shifts by itemHeight = 110 per erased item.
fn itemHeight(): number = 100

// use-animated-shake.ts: withRepeat(withTiming(10, { duration 120, bezier(0.35, 0.7, 0.5, 0.7) }),
// 6, reverse): six legs of 120 ms, each on the same curve. Two names, so each shake restarts it.
keyframes shakeA
  0% translate="0px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  16.6667% translate="10px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  33.3333% translate="0px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  50% translate="10px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  66.6667% translate="0px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  83.3333% translate="10px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  100% translate="0px 0px"
keyframes shakeB
  0% translate="0px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  16.6667% translate="10px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  33.3333% translate="0px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  50% translate="10px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  66.6667% translate="0px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  83.3333% translate="10px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  100% translate="0px 0px"
fn shakeOf(n: number): string = n == 0 ? "none" : `${n % 2 == 1 ? "shakeA" : "shakeB"} 720ms linear both`

component EmailDemo
  props
    env: DemoEnv
  state erasedItems = 0
  state restoreShakes = 0
  state deleteShakes = 0
  action onDelete
    haptic("selection")
    if erasedItems >= 10
      deleteShakes = deleteShakes + 1
    else
      erasedItems = erasedItems + 1
  action onRestore
    haptic("selection")
    if erasedItems <= 0
      restoreShakes = restoreShakes + 1
    else
      erasedItems = erasedItems - 1
  view
    // styles.container: #f8fafc, flex 1.
    column position="absolute" inset=0 background-color="color(display-p3 0.9725 0.9804 0.9882)" testId="email-demo"
      // The FlatList: contentContainerStyle paddingTop safeTop + DEMO_BUTTON_ROW_HEIGHT,
      // paddingBottom ITEM_HEIGHT + ITEM_MARGIN.
      scroll position="absolute" top=0 left=0 width="100%" height="100%" testId="email-list"
        column padding-top=(env.safeTop + demoButtonRow()) padding-bottom=110
          for item, i in items() key=i
            EmailRow(item=item, index=i, shifted=erasedItems, rowWidth=(env.width - 24))
      // styles.topGradient: absolute, safeTop × 1.5 tall, rgba(248,250,252,1) → 0, over the list.
      view position="absolute" top=0 left=0 right=0 height=(env.safeTop * 1.5) z-index=1
        pointer-events="none"
        background-image="linear-gradient(to bottom, color(display-p3 0.9725 0.9804 0.9882), color(display-p3 0.9725 0.9804 0.9882 / 0))"
      // styles.bottomGradient: absolute, 150 tall, rgba(248,250,252,0) → 1.
      view position="absolute" bottom=0 left=0 right=0 height=150 z-index=1 pointer-events="none"
        background-image="linear-gradient(to bottom, color(display-p3 0.9725 0.9804 0.9882 / 0), color(display-p3 0.9725 0.9804 0.9882))"
      // styles.buttonsContainer: absolute, bottom safeBottom + 10, marginHorizontal 20 %, a row
      // spaced evenly, zIndex 2.
      row position="absolute" left=0 right=0 bottom="calc(env(safe-area-inset-bottom) + 10px)"
        margin-left="20%" margin-right="20%" justify-content="space-evenly" z-index=2
        view animation=shakeOf(restoreShakes) testId="restore-shake"
          // styles.floatingButton: 64, radius 32, shadow 0 4 8 rgba(0,0,0,0.15); #10b981;
          // MaterialIcons restore 24 white.
          button appearance="none" class=PressableScale press=onRestore testId="restore"
            aria-label="Restore" width=64 height=64 border-radius=32 background-color="color(display-p3 0.0627 0.7255 0.5059)"
            box-shadow="0px 4px 8px rgba(0, 0, 0, 0.15)" display="flex" align-items="center"
            justify-content="center"
            // MaterialIcons' own glyph (24 × 24 grid): an SF Symbol at 24 is a larger, other one.
            svg width=24 height=24 viewBox="0 0 24 24" aria-hidden=true
              path d="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" fill="#ffffff"
        view animation=shakeOf(deleteShakes) testId="delete-shake"
          // #ef4444; MaterialIcons delete 24 white.
          button appearance="none" class=PressableScale press=onDelete testId="delete"
            aria-label="Delete" width=64 height=64 border-radius=32 background-color="color(display-p3 0.9373 0.2667 0.2667)"
            box-shadow="0px 4px 8px rgba(0, 0, 0, 0.15)" display="flex" align-items="center"
            justify-content="center"
            svg width=24 height=24 viewBox="0 0 24 24" aria-hidden=true
              path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" fill="#ffffff"

// interactive-list AnimatedListItem + styles.listContainerItem + list-item ListItem.
//
// The row box keeps the list's motion: translateY withSpring(-shifted · 110, { damping 30,
// stiffness 180, mass 1.5 }) and opacity withSpring(index >= shifted, { damping 26, stiffness
// 190, mass 1.4 }). What it draws is a canvas (gpu/src/email_demo.rs): the row's layer (its
// background, border ring, box shadow, photo and labels) and its iOS layer shadow, which has no
// shadowPath (the animated background is not opaque), so it follows that content, blurred at a
// radius that springs (12 / 4), with its opacity (0.15 / 0), offset (6 / 1) and the background
// colour (rgba(59,130,246,0.06) / transparent) on { damping 25, stiffness 200, mass 1.2 }: a
// `filter` neither transitions nor follows a springing radius here. The canvas reaches 48 past
// the row on every side, for the shadow.
component EmailRow
  props
    item: Email
    index: number
    shifted: number
    rowWidth: number
  view
    // listContainerItem: height ITEM_HEIGHT, marginBottom ITEM_MARGIN - 2, marginHorizontal 12.
    view position="relative" height=itemHeight() margin-bottom=8 margin-left=12 margin-right=12
      translate=`0px ${0 - shifted * 110}px` opacity=(index >= shifted ? 1 : 0)
      transition="translate -exact-spring(180, 30, 1.5), opacity -exact-spring(190, 26, 1.4)"
      aria-label=`${item.title}. ${item.subtitle}` testId=`email-${index}`
      canvas surface=email_row(index, shifted) position="absolute" left=-48 top=-48
        width=(rowWidth + 96) height=(itemHeight() + 96) pointer-events="none" aria-hidden=true
