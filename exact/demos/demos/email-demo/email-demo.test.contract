at "/demo/email-demo"

test "the ten emails are listed"
  expect tree has "email-demo"
  expect text "email-title-0" == "Welcome to our community"
  expect text "email-title-9" == "App update available"

test "delete shifts the list and restore brings it back"
  tap "delete"
  clock settle
  tap "restore"
  clock settle
  expect tree has "email-demo"

test "restore with nothing erased shakes, and nothing changes"
  tap "restore"
  clock settle

test "delete past the last email shakes"
  tap "delete"
  tap "delete"
  tap "delete"
  tap "delete"
  tap "delete"
  tap "delete"
  tap "delete"
  tap "delete"
  tap "delete"
  tap "delete"
  tap "delete"
  clock settle
  expect tree has "email-demo"
