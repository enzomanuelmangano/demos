at "/demo/toast"

test "each press stacks the next toast, the front one swipeable"
  expect tree has "toast"
  expect tree has "toast-button"
  expect tree missing "toast-handle"
  tap "toast-button"
  clock settle
  expect text "toast-title-0" == "I am a simple toast"
  expect tree has "toast-handle"
  tap "toast-button"
  clock settle
  expect text "toast-title-1" == "Well, not so simple"
  expect tree has "toast-0"

test "past the fifth the spam toast, and no more than six in the list"
  // Each test starts on a fresh page: the fifth press is "And if you're lazy" (key 4).
  tap "toast-button"
  tap "toast-button"
  tap "toast-button"
  tap "toast-button"
  tap "toast-button"
  expect text "toast-title-4" == "And if you're lazy"
  tap "toast-button"
  expect text "toast-title-5" == "You can spam me!"
  tap "toast-button"
  clock settle
  expect tree missing "toast-6"

test "the fifth dismisses itself: 2.5 s, then its 300 ms slide"
  tap "toast-button"
  tap "toast-button"
  tap "toast-button"
  tap "toast-button"
  tap "toast-button"
  expect tree has "toast-4"
  clock +2000
  expect tree has "toast-4"
  clock settle
  expect tree missing "toast-4"
  expect tree has "toast-3"
