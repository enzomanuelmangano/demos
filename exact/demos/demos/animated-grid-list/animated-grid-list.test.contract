seed 3
at "/demo/animated-grid-list"

// The cards and their scroll are a GPU surface (the web host gives it no touches): the button
// switches the layout it draws.
test "the button switches grid and list"
  expect tree has "animated-grid-list"
  expect tree has "grid-scroll"
  expect tree has "toggle-square-3"
  tap "layout-toggle"
  clock settle
  expect tree missing "toggle-square-3"
  expect tree has "toggle-square-1"
  tap "layout-toggle"
  clock settle
  expect tree has "toggle-square-3"
