// Animated Grid List: ten cards that reflow between a two-column grid and a list (the floating
// button switches them, its squares becoming two bars); while the list scrolls, every card
// tilts back on X against the scroll's direction and springs flat when it stops.
// RN: src/animations/animated-grid-list (index.tsx, constants.ts, components/*). The ScrollView
// and its cards (the layout animations, which all start on the toggle's frame, the tilt spring
// and the UIScrollView) are a Rust surface, gpu/src/animated_grid_list.rs; the floating button
// is Contract, above it.
use PressablesConfig, pressNone, pressDown, pressUp, pressableScale, pressTransition from "pressto"
use DemoEnv, roll from "../env.contract"

// constants.ts getRandomQuote(): Math.random() → roll(seed, k, 13), the thirteen quotes in the surface.
// The twenty quotes' indices (title, subtitle per card), for the surface.
fn quoteIndices(seed: number): string = "12,10,6,11,5,1,7,7,10,3,4,4,11,3,4,2,10,5,6,7"

// Reanimated's withTiming default curve, Easing.inOut(Easing.quad), as its cubic-bezier: the
// curve of LinearTransition, FadeIn and FadeOut when no easing is given.
// LinearTransition (no duration): 300 ms; .duration(700) on a card; .duration(600) on the text.
style Reflow
  -exact-layout-transition="300ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%)"

// FadeIn / FadeOut: 300 ms on inOut(quad).
keyframes fadeIn
  from opacity=0
keyframes fadeOut
  to opacity=0

component AnimatedGridList
  props
    env: DemoEnv
  state isList = false
  action toggle
    isList = not isList
  view
    // styles.container: #EEEEEE, padded by the safe area top and bottom; the ScrollView and
    // its cards drawn by the surface (its frame the container less the safe area, its content
    // drawn outside it too, as RN's overflow visible).
    column position="absolute" inset=0 background-color="#EEEEEE" testId="animated-grid-list"
      canvas surface=animated_grid_list(isList, env.safeTop, env.safeBottom, quoteIndices(env.seed))
        position="absolute" top=0 left=0 width=env.width height=env.height touch-action="none"
        z-index=0 testId="grid-scroll" aria-label=(isList ? "The cards, as a list" : "The cards, as a grid")
      FloatingButton(isList=isList, press=toggle)

component FloatingButton
  props
    isList: bool
    press: action
  inject
    pressto: PressablesConfig
    pressablesOnPress: action
  // pressto: the pressed pressable (its key) and the press parity.
  state pressing = pressNone()
  action pressIn(key: number)
    pressing = pressDown(pressing, key)
  action pressOut
    pressing = pressUp(pressing)
  // PressableScale's onPress: pressto's global haptic, then the layout.
  action tap
    pressablesOnPress()
    press()
  view
    // floating-button.tsx: 70 × 70, white, radius 35, shadow 0 10 20 rgba(0,0,0,0.25),
    // bottom 50, right 16.
    button appearance="none" press=tap aria-label=(isList ? "Grid" : "List")
      pointerdown=pressIn(0) pointerup=pressOut
      scale=pressableScale(pressing, 0, pressto) transition=pressTransition("scale", pressto)
      testId="layout-toggle" position="absolute" bottom=50 right=16 z-index=1 width=70 height=70 border-radius=35
      background-color="#FFFFFF" box-shadow="0px 10px 20px rgba(0, 0, 0, 0.25)"
      display="flex" flex-direction="column" justify-content="center"
      // Grid: a wrapped row of four 17.5 squares (25% of 70, aspect 1); list: a column of two
      // bars 42 × 14 (70% of the 60 inside the padding, 20% of 70). Margin 2, #6283B1.
      view class=Reflow flex=1 display="flex" flex-direction=(isList ? "column" : "row")
        flex-wrap=(isList ? "nowrap" : "wrap") justify-content="center" align-content="center"
        padding-left=5 padding-right=5
        for i in range(isList ? 2 : 4) key=i
          view class=Reflow testId=`toggle-square-${i}` align-self="center" width=(isList ? 42 : 17.5) height=(isList ? 14 : 17.5)
            margin=2 background-color="color(display-p3 0.3843 0.5137 0.6941)" border-radius=(isList ? 4 : 2) corner-shape="-exact-continuous"
            animation="fadeIn 300ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%) both"
            -exact-exit-animation="fadeOut 300ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%) both"
