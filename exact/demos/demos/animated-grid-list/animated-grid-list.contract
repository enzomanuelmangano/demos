// Animated Grid List: ten cards that reflow between a two-column grid and a list (the floating
// button switches them, its squares becoming two bars); while the list scrolls, every card
// tilts back on X against the scroll's direction and springs flat when it stops.
// RN: src/animations/animated-grid-list (index.tsx, constants.ts, components/*).
use PressableScale from "pressto"
use DemoEnv, roll from "../env.contract"

// constants.ts getRandomQuote(): one of these thirteen, Math.random() → roll(seed, k, 13).
fn quotes(): string[] = [
  "The greatest glory in living lies not in never falling, but in rising every time we fall.",
  "The way to get started is to quit talking and begin doing.",
  "Your time is limited, so don’t waste it living someone else’s life. Don’t be trapped by dogma, which is living with the results of other people’s thinking. Don’t let the noise of others’ opinions drown out your own inner voice. And most important, have the courage to follow your heart and intuition. They somehow already know what you truly want to become. Everything else is secondary.",
  "If life were predictable it would cease to be life, and be without flavor.",
  "If you look at what you have in life, you’ll always have more. If you look at what you don’t have in life, you’ll never have enough.",
  "If you set your goals ridiculously high and it’s a failure, you will fail above everyone else’s success.",
  "Life is what happens when you’re busy making other plans.",
  "Spread love everywhere you go. Let no one ever come to you without leaving happier.",
  "When you reach the end of your rope, tie a knot in it and hang on.",
  "Always remember that you are absolutely unique. Just like everyone else.",
  "Don’t judge each day by the harvest you reap but by the seeds that you plant.",
  "The future belongs to those who believe in the beauty of their dreams.",
  "Tell me and I forget. Teach me and I remember. Involve me and I learn."
]
fn quote(seed: number, k: number): string = match quotes().at(roll(seed, k, 13)) { case some(q) => q, case none => "" }
// constants.ts data: img 'https://picsum.photos/200/300' for every item (one cached image).
fn picture(): string = "https://picsum.photos/200/300"

// Reanimated's withTiming default curve, Easing.inOut(Easing.quad), as its cubic-bezier: the
// curve of LinearTransition, FadeIn and FadeOut when no easing is given.
// LinearTransition (no duration): 300 ms; .duration(700) on a card; .duration(600) on the text.
style CardCell
  -exact-layout-transition="700ms cubic-bezier(0.455, 0.03, 0.515, 0.955)"
style Reflow
  -exact-layout-transition="300ms cubic-bezier(0.455, 0.03, 0.515, 0.955)"

// FadeIn / FadeOut: 300 ms on inOut(quad).
keyframes fadeIn
  from opacity=0
keyframes fadeOut
  to opacity=0

// animated-layout-list.tsx: MAX_ROTATE_DEG 20 while scrolling up, MIN_ROTATE_DEG -20 down,
// 0 at rest; withSpring(rotation, { dampingRatio: 1, duration: 500 }) → bun tools/spring.ts 500 1.
fn tilt(direction: number): string = direction == -1 ? "x 20deg" : direction == 1 ? "x -20deg" : "x 0deg"

component AnimatedGridList
  props
    env: DemoEnv
  state isList = false
  // Direction: -1 up, 1 down, 0 none (not scrolling). `anchor` is RN's lastOffset: the offset
  // the scroll started from (its first event). Written when a scroll starts, when its direction
  // flips and when it ends: never per frame.
  state scrolling = false
  state direction = 0
  state anchor = 0
  action toggle
    haptic("selection")
    isList = not isList
  action scrolled(x: number, y: number)
    if not scrolling
      scrolling = true
      anchor = y
    else
      if (y > anchor ? 1 : -1) != direction
        direction = y > anchor ? 1 : -1
  // onMomentumEnd, or onEndDrag with no velocity: the scroll ended.
  action ended
    scrolling = false
    direction = 0
  view
    // styles.container: #EEEEEE, padded by the safe area top and bottom.
    column position="absolute" inset=0 background-color="#EEEEEE" testId="animated-grid-list"
      // The ScrollView draws outside its bounds (overflow visible): a full-screen scroller whose
      // content starts below the safe top and ends above the home indicator looks the same.
      scroll position="absolute" top=0 left=0 width="100%" height="100%" scroll=scrolled scrollend=ended testId="grid-scroll"
        row flex-wrap="wrap" align-items="flex-start" padding-top=env.safeTop
          padding-bottom="env(safe-area-inset-bottom)"
          for i in range(10) key=i
            Card(index=i, isList=isList, direction=direction, title=quote(env.seed, 2 * i),
              subtitle=quote(env.seed, 2 * i + 1), width=env.width)
      FloatingButton(isList=isList, press=toggle)

component Card
  props
    index: number
    isList: bool
    direction: number
    title: string
    subtitle: string
    width: number
  view
    // The cell: height 100 / 90% wide in the list; in the grid 42.5% wide and square (Yoga's
    // aspectRatio 1 wins over height 120); margin-bottom 20, margin-left 5%. The perspective
    // here is RN's perspective(500) in the card's own transform (its centre).
    view class=CardCell width=(isList ? "90%" : "42.5%") height=(isList ? "100px" : "auto")
      aspect-ratio=(isList ? "auto" : "1") margin-bottom=20 margin-left="5%" perspective=500
      testId=`card-${index}`
      column class=CardCell width="100%" height="100%" background-color="#FFFFFF" border-radius=10
        corner-shape="squircle" overflow="hidden"
        rotate=tilt(direction) transition="rotate -exact-spring(1087.7, 131.9, 4)"
        // renderItem: a row in the list, a column in the grid, items centred.
        view flex=1 display="flex" align-items="center" flex-direction=(isList ? "row" : "column")
          image picture() class=Reflow width=(isList ? 64 : 200) height=(isList ? 64 : 200)
            border-radius=(isList ? 32 : 0) margin-left=(isList ? 16 : 0) margin-right=(isList ? 16 : 0)
            object-fit="cover" flex-shrink=0 aria-hidden=true
          if isList
            // Yoga sizes this column at 80% of the card's inner width (its title's maxWidth
            // against the card), then the title at 80% of the column: 0.64 × 0.9 × width.
            column flex-shrink=0 width=(0.8 * 0.9 * width) -exact-layout-transition="600ms cubic-bezier(0.455, 0.03, 0.515, 0.955)"
              animation="fadeIn 300ms cubic-bezier(0.455, 0.03, 0.515, 0.955) both"
              -exact-exit-animation="fadeOut 300ms cubic-bezier(0.455, 0.03, 0.515, 0.955) both"
              text title font-size=14 color="#000000" margin-bottom=2 max-width=(0.64 * 0.9 * width)
                white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId=`title-${index}`
              text subtitle font-size=12 color="#383838" max-width=200
                white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

component FloatingButton
  props
    isList: bool
    press: action
  view
    // floating-button.tsx: 70 × 70, white, radius 35, shadow 0 10 20 rgba(0,0,0,0.25),
    // bottom 50, right 16.
    button appearance="none" press=press class=PressableScale aria-label=(isList ? "Grid" : "List")
      testId="layout-toggle" position="absolute" bottom=50 right=16 width=70 height=70 border-radius=35
      background-color="#FFFFFF" box-shadow="0px 10px 20px rgba(0, 0, 0, 0.25)"
      display="flex" flex-direction="column" justify-content="center"
      // Grid: a wrapped row of four 17.5 squares (25% of 70, aspect 1); list: a column of two
      // bars 42 × 14 (70% of the 60 inside the padding, 20% of 70). Margin 2, #6283B1.
      view class=Reflow flex=1 display="flex" flex-direction=(isList ? "column" : "row")
        flex-wrap=(isList ? "nowrap" : "wrap") justify-content="center" align-content="center"
        padding-left=5 padding-right=5
        for i in range(isList ? 2 : 4) key=i
          view class=Reflow align-self="center" width=(isList ? 42 : 17.5) height=(isList ? 14 : 17.5)
            margin=2 background-color="#6283B1" border-radius=(isList ? 4 : 2) corner-shape="squircle"
            animation="fadeIn 300ms cubic-bezier(0.455, 0.03, 0.515, 0.955) both"
            -exact-exit-animation="fadeOut 300ms cubic-bezier(0.455, 0.03, 0.515, 0.955) both"
