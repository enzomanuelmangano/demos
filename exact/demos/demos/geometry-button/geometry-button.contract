// Geometry Button: fifty circles that fan out into a flower while pressed. One canvas draws it and
// posts a heavy haptic at an accepted touch-down.

component GeometryButton
  action buzz(m: string)
    if m == "haptic:impact-heavy"
      haptic("impact-heavy")
  view
    column position="absolute" inset=0 background-color="#000000" align-items="center"
      justify-content="center" testId="geometry-button"
      canvas surface=geometry_button() width=200 height=200 touch-action="none"
        message=buzz testId="geometry-canvas" aria-label="Press and hold"
