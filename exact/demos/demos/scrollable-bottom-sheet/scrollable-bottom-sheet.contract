// Scrollable Bottom Sheet: a gradient button opens a dark sheet holding three horizontal pages;
// paging across them springs the sheet's height to each page's (350, 500, 250), the last
// page's button closes it; a drag down or the backdrop closes it too.
// RN: src/animations/scrollable-bottom-sheet (index.tsx, components/BottomSheetPage/index.tsx,
// components/BottomSheet/{BottomSheet.tsx, ScrollableBottomSheet.tsx, Backdrop/index.tsx}).
// Every scroll event restarts the sheet's spring toward the height interpolated at the offset,
// the pages are laid out at the sheet's height each frame and clipped by their ScrollView, and
// the pan and the scroll view share one finger: the whole demo is Rust,
// gpu/src/scrollable_bottom_sheet.rs. The surface posts `haptic:selection` on a press (the
// app's PressablesConfig onPress).
use DemoEnv from "../env.contract"

component ScrollableBottomSheet
  props
    env: DemoEnv
  action heard(m: string)
    if m == "haptic:selection"
      haptic("selection")
  view
    canvas surface=scrollable_bottom_sheet() message=heard position="absolute" top=0 left=0
      width=env.width height=env.height background-color="#000" touch-action="none"
      testId="scrollable-bottom-sheet"
      aria-label="A gradient button opens a sheet of three pages; swipe the pages, drag the sheet down or tap outside it to close"
