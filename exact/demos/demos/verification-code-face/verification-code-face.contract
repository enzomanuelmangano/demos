// Verification code face: a face over four code boxes. The face tilts toward the next box as
// digits arrive. A full code checks against 1111: correct shows a smile, wrong shows a frown and
// shakes. A second later everything resets.
// The face and boxes are drawn by the canvas surface. The digits flip and the row shakes, using
// keyframes and transitions. The reset is drawn by delayed keyframes, and the state catches up at
// the next keystroke.
use DemoEnv from "../env.contract"

// The correct code. The field takes four digits.
fn correctCode(): string = "1111"
fn codeLength(): number = 4

// A digit on screen. `leaving` flips it out; `late` waits the reset's 1000 ms first.
shape Glyph
  key: number
  box: number
  digit: number
  leaving: bool
  late: bool
  leftAt: number

fn digitAt(s: string, i: number): number = "0123456789".indexOf(s.slice(i, i + 1))
fn statusOf(code: string): string = code == correctCode() ? "correct" : code.length == codeLength() ? "wrong" : "inProgress"
fn statusCode(status: string): number = status == "correct" ? 1 : status == "wrong" ? 2 : 0
// Height of one box, from the row's width.
fn cellHeight(width: number): number = (width - 20) / 4 / 0.95

// Shake: six 120 ms legs, back and forth. Two names, so each wrong code restarts it.
keyframes shakeA
  0% translate="0px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  16.6667% translate="10px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  33.3333% translate="0px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  50% translate="10px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  66.6667% translate="0px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  83.3333% translate="10px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  100% translate="0px 0px"
keyframes shakeB
  0% translate="0px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  16.6667% translate="10px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  33.3333% translate="0px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  50% translate="10px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  66.6667% translate="0px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  83.3333% translate="10px 0px" animation-timing-function="cubic-bezier(0.35, 0.7, 0.5, 0.7)"
  100% translate="0px 0px"

component VerificationCodeFace
  props
    env: DemoEnv
  // `field` is the hidden input's text. `code` is the digits shown.
  state field = ""
  state base = ""
  state code = ""
  state status = "inProgress"
  state doneAt = 0
  state glyphs: Glyph[] = []
  state nextKey = 0
  state shakes = 0
  // The keyboard is up: the content lifts 118 pt, so the boxes stay visible. On the web the lift is
  // RN's, half the keys' cover (useReanimatedKeyboardAnimation's height / 2): a desktop has no keys
  // to dodge, a phone browser's are its own height.
  state keyboard = false
  derive lift = env.web ? env.keyboardHeight / 2 : (keyboard ? 118 : 0)
  action keyboardUp
    keyboard = true
  action keyboardDown
    keyboard = false
  action focusField
    focus("code-field")
  action typed(v: string)
    let now = performanceNow()
    let finished = status != "inProgress"
    // Input within a second of a check is ignored, and cleared with the reset. `base` is the
    // text already cleared, and the code is what was typed after it.
    if finished and now < doneAt + 1000
      base = v
      field = v
    else
      let typedCode = v.startsWith(base) ? v.slice(base.length) : ""
      if not v.startsWith(base)
        base = v
      field = v
      if typedCode.length <= codeLength()
        let before = finished ? "" : code
        let next = statusOf(typedCode)
        let kept = glyphs.filter(g => not g.leaving or now < g.leftAt + (g.late ? 1000 : 0) + 500)
        let updated = kept.map(g => g.leaving ? g : g.box >= typedCode.length ? Glyph(g, leaving=true, late=false, leftAt=now) : Glyph(g, digit=digitAt(typedCode, g.box)))
        let added = range(codeLength()).filter(i => i >= before.length and i < typedCode.length).map(i => Glyph(key=nextKey + i, box=i, digit=digitAt(typedCode, i), leaving=false, late=false, leftAt=0))
        let all = updated.concat(added)
        // A checked code leaves at the reset, 1000 ms on.
        glyphs = next == "inProgress" ? all : all.map(g => g.leaving ? g : Glyph(g, leaving=true, late=true, leftAt=now))
        nextKey = nextKey + codeLength()
        code = typedCode
        status = next
        if next != "inProgress"
          doneAt = now
          base = v
        if next == "wrong"
          shakes = shakes + 1
  view
    column position="absolute" inset=0 background-color="#ffffff" align-items="center" justify-content="center"
      testId="verification-code-face"
      column width="100%" translate=`0px -${lift}px`
        transition="translate 500ms cubic-bezier(0.19, 0.91, 0.38, 1)"
        // The face. Its canvas extends 12 pt past the square, to leave room for the tilt.
        column align-items="center" justify-content="center" margin-bottom=80
          view position="relative" width=96 height=96 testId="face"
            canvas surface=verification_code_face(0, code.length, statusCode(status), doneAt, env.width, env.height)
              position="absolute" left=-12 top=-12 width=120 height=120 pointer-events="none"
              aria-label="Face"
        // The row of boxes, which shakes on a wrong code. A touch focuses the field.
        view position="relative" width="100%"
          animation=(shakes == 0 ? "none" : shakes % 2 == 1 ? "shakeA 720ms linear both" : "shakeB 720ms linear both")
          testId="code"
          // The boxes' background, shadow and borders, drawn on the canvas.
          canvas surface=verification_code_face(1, code.length, statusCode(status), doneAt, env.width, env.height)
            position="absolute" left=0 top=-8 width=env.width height=(cellHeight(env.width) + 40) pointer-events="none"
            aria-label="Code boxes"
          row position="relative" width="100%" padding-left=10 padding-right=10 box-sizing="border-box" press=focusField
            for i in range(codeLength()) key=i
              // One box per digit.
              view flex=1 aspect-ratio=0.95 display="flex" align-items="center" justify-content="center"
                // The box. Its perspective is for the digit's flip.
                view position="relative" width="80%" height="90%" box-sizing="border-box" border-width=2.1
                  border-style="solid" border-color="transparent" perspective=500 testId=`box-${i}`
                  for g in glyphs.filter(g => g.box == i) key=g.key
                    CodeDigit(digit=g.digit, leaving=g.leaving, late=g.late, testId=`digit-${i}`)
      // A hidden number field takes the typing. It sits on screen: a focused field below the
      // screen makes the host scroll the whole route.
      input id="code-field" value=field input=typed inputmode="numeric" autofocus=(not env.tile)
        autocomplete="one-time-code" focus=keyboardUp blur=keyboardDown
        aria-label="Verification code" testId="code-field" position="absolute" top=0 left=0 width=1 height=1
        padding=0 color="transparent" caret-color="transparent" background-color="transparent" border="none" outline="none"

// Exit at the reset, as keyframes: a transition's delay does not hold on iOS, an animation's
// does. Nodes that turn about x use transform-origin "left center", or iOS turns them flat.
keyframes digitLateRotate
  0% rotate=0 animation-timing-function="cubic-bezier(0.6, 0.1, 0.4, 0.8)"
  100% rotate=-90
keyframes digitLateDrop
  0% translate="0px 0px" animation-timing-function="cubic-bezier(0.6, 0.1, 0.4, 0.8)"
  100% translate="0px 52.48px"
keyframes digitLateFade
  0% opacity=1 animation-timing-function="linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%)"
  50% opacity=0
  100% opacity=0

component CodeDigit
  props
    digit: number
    leaving: bool
    late: bool
    testId: string
  // Starts folded, and unfolds on first layout.
  state shown = false
  action appear(w: number, h: number)
    shown = true
  // A digit that arrives already checked leaves only after it has arrived.
  derive goneLate = leaving and late and shown
  derive goneNow = leaving and not late and shown
  view
    // Enter: flips in from above and fades in. The digit drops by its own height (52.48).
    column position="absolute" inset=0 display="flex" align-items="center" justify-content="center"
      resize=appear perspective=500
      rotate=(shown ? "x 0deg" : "x -90deg") transform-origin="left center" opacity=(shown ? 1 : 0)
      transition="rotate 500ms cubic-bezier(0, 0.75, 0.5, 0.9), opacity 250ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%)"
      column width="100%" height="100%" display="flex" align-items="center" justify-content="center"
        translate=(shown ? "0px 0px" : "0px 52.48px") transition="translate 500ms cubic-bezier(0, 0.75, 0.5, 0.9)"
        perspective=500
        // Exit: a checked code leaves at the reset, a deleted digit at once. Each is its own
        // node, since the host takes a transition from the style before the change.
        column width="100%" height="100%" display="flex" align-items="center" justify-content="center"
          perspective=500 rotate="x 0deg" transform-origin="left center"
          animation=(goneLate ? "digitLateRotate 500ms linear 1000ms both, digitLateFade 500ms linear 1000ms both" : "none")
          column width="100%" height="100%" display="flex" align-items="center" justify-content="center"
            rotate=(goneNow ? "x -90deg" : "x 0deg") transform-origin="left center" opacity=(goneNow ? 0 : 1)
            transition="rotate 500ms cubic-bezier(0.6, 0.1, 0.4, 0.8), opacity 250ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%)"
            column display="flex" align-items="center" justify-content="center"
              animation=(goneLate ? "digitLateDrop 500ms linear 1000ms both" : "none")
              text `${digit}` color="#000000" font-family="FiraCode-Regular" font-size=40 testId=testId
                translate=(goneNow ? "0px 52.48px" : "0px 0px") transition="translate 500ms cubic-bezier(0.6, 0.1, 0.4, 0.8)"
