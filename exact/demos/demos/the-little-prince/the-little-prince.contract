// The Little Prince: a page of text whose letters fly together into a picture of the prince on
// his planet when the corner button is pressed, and back.
// A toggle within 400 ms of the last one is ignored, so a double tap counts once.
use PressableScale from "pressto"
use DemoEnv from "../env.contract"

// Ease-out cubic, 1 − (1 − t)³, written as an exact cubic Bézier. The icons' opacity and scale
// are linear in the face position, so easing the position eases them.
fn outCubic(): string = "cubic-bezier(0.3333333333333333, 1, 0.6666666666666666, 1)"

component TheLittlePrince
  props
    env: DemoEnv
  state revealed = false
  state lastToggle = -1000000
  action toggle
    let now = performanceNow()
    if now - lastToggle >= 400
      lastToggle = now
      revealed = not revealed
  action heard(m: string)
    if m == "tick"
      haptic("impact-light")
  view
    view position="absolute" top=0 left=0 width=env.width height=env.height background-color="#f7f4ec"
      testId="the-little-prince"
      canvas surface=the_little_prince(env.seed, revealed) message=heard position="absolute" top=0
        left=0 width=env.width height=env.height aria-hidden=true testId="prince-canvas"
      // Toggle button: a 48 pt disc in the corner, inside an 80 pt touch area. The photo and text
      // icons crossfade.
      view position="absolute" right=(env.width * 0.09 - 16) bottom=(env.width * 0.09 - 16) width=80
        height=80 display="flex" flex-direction="column"
        PressableScale(press=toggle)
          view width=80 height=80 padding=16 box-sizing="border-box" text-align="center"
            aria-label="Switch between the text and the picture" testId="prince-toggle"
            view position="relative" width=48 height=48 border-radius=24 corner-shape="-exact-continuous"
              background-color="#1c1a17"
              view position="absolute" inset=0 display="flex" align-items="center" justify-content="center"
                opacity=(revealed ? 0 : 1) scale=(revealed ? 0.85 : 1)
                transition=`opacity 240ms ${outCubic()}, scale 240ms ${outCubic()}`
                image "symbol:icon.photo" font-size=20 font-weight=600 color="#efe7d6" aria-hidden=true
              view position="absolute" inset=0 display="flex" align-items="center" justify-content="center"
                opacity=(revealed ? 1 : 0) scale=(revealed ? 1 : 0.85)
                transition=`opacity 240ms ${outCubic()}, scale 240ms ${outCubic()}`
                image "symbol:icon.textformat" font-size=20 font-weight=600 color="#efe7d6" aria-hidden=true
