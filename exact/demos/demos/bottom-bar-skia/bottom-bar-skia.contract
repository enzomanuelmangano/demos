// Bottom Bar: a white tab bar of three icons. A purple circle in a liquid bump of the bar springs
// to the tab tapped, and its icon rises into it and turns white. The bar is a Rust surface
// (gpu/src/bottom_bar_skia.rs), driven by the selected index held here.
use DemoEnv from "../env.contract"

// The bar is 65 pt plus half the bottom inset. The canvas adds 50 pt, and 85 pt above that for
// the shadow.
fn barHeight(): string = "calc(65px + env(safe-area-inset-bottom) / 2)"
fn canvasHeight(): string = "calc(65px + env(safe-area-inset-bottom) / 2 + 50px + 85px)"
fn tabName(i: number): string = i == 0 ? "Home" : (i == 1 ? "Search" : "User")

component BottomBarSkia
  props
    env: DemoEnv
  state index = 0
  // Selects a tab and plays a selection haptic.
  action choose(i: number)
    haptic("selection")
    index = i
  // Taps from the canvas, hit-tested at the lift point.
  action tapped(m: string)
    if m == "tab:0"
      haptic("selection")
      index = 0
    if m == "tab:1"
      haptic("selection")
      index = 1
    if m == "tab:2"
      haptic("selection")
      index = 2
  view
    column position="absolute" inset=0 background-color="rgb(242, 242, 242)" testId="bottom-bar-skia"
      view position="absolute" top=0 left=0 right=0 bottom=barHeight() background-color="rgba(0, 0, 0, 0.1)"
        aria-hidden=true
      // One box per tab, a third of the width, for accessibility and the web. On iOS the canvas
      // takes the touches instead.
      for i in range(3) key=i
        view position="absolute" bottom=0 left=(i * env.width / 3) width=(env.width / 3)
          height=barHeight() press=choose(i) role="button" aria-label=tabName(i)
          aria-pressed=(i == index) testId=`tab-${i}`
      canvas surface=bottom_bar_skia(index) position="absolute" left=0 bottom=0 width="100%"
        height=canvasHeight() touch-action="none" message=tapped aria-hidden=true
        testId="bottom-bar-canvas"
