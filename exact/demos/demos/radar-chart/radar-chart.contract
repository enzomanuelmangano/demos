// Radar Chart: two translucent polygons over a pentagon grid of five chess skills; Shuffle
// springs them to new random values. RN: src/animations/radar-chart (index.tsx,
// components/radar-chart). The chart is Skia: drawn and sprung in Rust
// (gpu/src/radar_chart.rs); the data and the button are here.
use PressableScale from "pressto"
use DemoEnv, roll from "../env.contract"

// generateRandomDataChart: (Math.random() × 100) / 100 for each of five keys, twice; the
// draw-th shuffle takes the draw-th ten rolls.
fn value(seed: number, draw: number, k: number): number = roll(seed, draw * 10 + k, 1000000) / 1000000

component RadarChart
  props
    env: DemoEnv
  state draw = 0
  action shuffle
    haptic("selection")
    draw = draw + 1
  view
    // styles.container: black, centred, paddingHorizontal 20.
    column position="absolute" inset=0 background-color="#000000" align-items="center"
      justify-content="center" padding="0px 20px" testId="radar-chart"
      // style={{ width, aspectRatio: 1 }}: the window's width, past the padding.
      canvas surface=radar_chart(value(env.seed, draw, 0), value(env.seed, draw, 1), value(env.seed, draw, 2),
        value(env.seed, draw, 3), value(env.seed, draw, 4), value(env.seed, draw, 5), value(env.seed, draw, 6),
        value(env.seed, draw, 7), value(env.seed, draw, 8), value(env.seed, draw, 9))
        width=env.width height=env.width flex-shrink=0 aria-label="Radar chart" testId="radar-canvas"
      // styles.button: 80% wide, 60 tall, white 1 border, radius 20 continuous, marginTop 50.
      button appearance="none" press=shuffle class=PressableScale width=(0.8 * (env.width - 40)) height=60
        margin-top=50 box-sizing="border-box" border="1px solid #ffffff" border-radius=20 corner-shape="squircle"
        display="flex" align-items="center" justify-content="center" testId="shuffle"
        // styles.title: white, 20, weight 800, letterSpacing 2, uppercase.
        text "Shuffle" color="#ffffff" font-size=20 font-weight=800 letter-spacing=2 text-transform="uppercase"
