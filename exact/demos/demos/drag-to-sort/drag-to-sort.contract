// Drag to Sort: nine habit rows on a scroll view; a row held 500 ms lifts and follows the finger,
// the others sliding into the order its position makes, the list scrolling near its edges.
// RN: src/animations/drag-to-sort (index.tsx, constants.ts, utils/haptics.ts,
// components/SortableList/*, components/ListItem/index.tsx). The whole demo is one Rust surface
// (gpu/src/drag_to_sort.rs): the ScrollView (ui_scroll), the long-press pan, each row's timings
// and corner radius, the rows' content (the emoji pre-rendered by TextKit) and the top gradient.
use DemoEnv from "../env.contract"

component DragToSort
  props
    env: DemoEnv
  // lightHapticFeedback: the row lifts.
  action heard(m: string)
    if m == "haptic:impact-light"
      haptic("impact-light")
  view
    canvas surface=drag_to_sort(env.safeTop) message=heard position="absolute" top=0 left=0
      width=env.width height=env.height touch-action="none" testId="drag-to-sort"
      aria-label="Habits: hold a row, then drag it to reorder"
