// Family Number Input: a keypad under a big number; each digit (and thousands comma) fades in
// from below, leaves downwards, and slides into place, while the row shrinks as it grows.
// Backspace removes the last digit, a long press on it clears. RN:
// src/animations/family-number-input (number-input.tsx, components/animated-number,
// components/buttons-grid).
use DemoEnv from "../env.contract"

// buttons-grid/index.tsx items: 1…9, an empty key, 0, backspace (-1 empty, -2 backspace).
fn keys(): number[] = [1, 2, 3, 4, 5, 6, 7, 8, 9, -1, 0, -2]

// animated-number: value.toLocaleString('en-US') split into characters, digits keyed
// `digit-<n>` and commas `comma-<n>` by their left-to-right ordinal.
shape Ch
  char: string
  key: string
fn firstGroup(n: number): number = ((n - 1) % 3) + 1
fn commaAfter(j: number, n: number): bool = j < n - 1 and j + 1 >= firstGroup(n) and (j + 1 - firstGroup(n)) % 3 == 0
fn charsOfText(s: string): Ch[] = range(s.length).map(j => commaAfter(j, s.length) ? [Ch(char=s.slice(j, j + 1), key=`digit-${j}`), Ch(char=",", key=`comma-${(j + 1 - firstGroup(s.length)) / 3}`)] : [Ch(char=s.slice(j, j + 1), key=`digit-${j}`)]).flat()
fn charsOf(value: number): Ch[] = charsOfText(value.toString())
// rContainerStyle: scale withTiming(max(1.05 - 0.05 * characters.length, 0.45)).
fn rowScale(count: number): number = max(1.05 - 0.05 * count, 0.45)

// FadeInDown / FadeOutDown: opacity and translateY 25, Reanimated's default timing (300 ms,
// Easing.inOut(Easing.quad)).
keyframes charIn
  from opacity=0 translate="0px 25px"
keyframes charOut
  to opacity=0 translate="0px 25px"

// InputButton (createAnimatedPressable): pressed, a white 10% fill and scale 0.9, radius 20.
style KeypadKey
  :active
    -exact-press-scale = 0.9
    background-color = "rgba(255, 255, 255, 0.1)"

component FamilyNumberInput
  props
    env: DemoEnv
  state input = 0
  action press(k: number)
    haptic("selection")
    if k >= 0 and (input * 10 + k).toString().length <= 11
      input = input * 10 + k
    if k == -2
      input = floor(input / 10)
  // onLongPress on backspace: onReset.
  action hold(k: number)
    if k == -2
      input = 0
  view
    // styles.container: black, padded by the safe area top and bottom.
    column position="absolute" inset=0 background-color="#000000" padding-top=env.safeTop
      padding-bottom="env(safe-area-inset-bottom)" testId="family-number-input"
      // styles.fillCenter, with the number in a second fillCenter padded 50 at its top.
      column flex=1 align-items="center" justify-content="center" position="relative"
        column flex=1 align-self="stretch" align-items="center" justify-content="center" padding-top=50
          AnimatedNumber(value=input)
        // styles.gradient: bottom 38%, ['transparent', '#000', '#000', '#000'].
        view position="absolute" left=0 right=0 bottom=0 height="38%" pointer-events="none"
          background-image="linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, #000000 33.333%, #000000 66.667%, #000000 100%)"
      // ButtonsGrid: styles.container wraps a row of keys 30% wide, 20% tall, margined
      // 7/3% left and bottom.
      row flex=1 flex-wrap="wrap" align-items="center" align-content="flex-start"
        for k, i in keys() key=i
          view display="flex" flex-direction="column" class=KeypadKey press=press(k) contextmenu=hold(k)
            width="30%" height="20%" margin-left="2.3333%" margin-bottom="2.3333%"
            align-items="center" justify-content="center" border-radius=20
            background-color="rgba(255, 255, 255, 0)" role="button"
            aria-label=(k >= 0 ? `${k}` : (k == -2 ? "Delete" : "")) testId=`key-${k}`
            if k >= 0
              // styles.number: SF-Pro-Rounded-Bold 30, white, centred.
              text `${k}` font-family="ui-rounded" font-weight=700 font-size=30 color="#ffffff"
                text-align="center"
            if k == -2
              // FontAwesome5 "backspace", 24, white.
              image "symbol:sf/delete.left.fill" font-size=24 color="#ffffff" aria-hidden=true

component AnimatedNumber
  props
    value: number
  view
    // styles.row, layout={LinearTransition} and the scale timing.
    row -exact-layout-transition="300ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%)"
      scale=rowScale(charsOf(value).length)
      transition="scale 300ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%)"
      testId="number" aria-label=`${value}`
      for c in charsOf(value) key=c.key
        // styles.character: SF-Pro-Rounded-Bold 90, white, marginHorizontal 2;
        // LinearTransition, FadeInDown, FadeOutDown.
        text c.char font-family="ui-rounded" font-weight=700 font-size=90 color="#ffffff"
          margin-left=2 margin-right=2 aria-hidden=true testId=`char-${c.key}`
          -exact-layout-transition="300ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%)"
          animation="charIn 300ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%) both"
          -exact-exit-animation="charOut 300ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%) both"
