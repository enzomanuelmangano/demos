// Circular Carousel: nine round photos on a horizontal paged strip that bends into an arc as it
// scrolls; the Scale switch springs the arc's scale effect on and off.
// RN: src/animations/circular-carousel (index.tsx, components/circular-list/index.tsx,
// components/circular-list/list-item.tsx).
use DemoEnv from "../env.contract"

// index.tsx data: the nine Unsplash photos, w=400 q=80.
fn photos(): string[] = [
  "https://images.unsplash.com/photo-1692855677202-3d106c3e8517?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80",
  "https://images.unsplash.com/photo-1692855676269-487641edd584?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80",
  "https://images.unsplash.com/photo-1692969960395-42cd03fffe82?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80",
  "https://images.unsplash.com/photo-1612638345449-e8a367b5fa9d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80",
  "https://images.unsplash.com/photo-1692969959077-7b16772805c8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80",
  "https://images.unsplash.com/photo-1692855676120-dc7096ada76d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80",
  "https://images.unsplash.com/photo-1612895680717-c4e6fb54c868?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80",
  "https://images.unsplash.com/photo-1624743043535-67f0d30c55b3?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80",
  "https://images.unsplash.com/photo-1615463204303-c3c22bac1642?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80",
]

// list-item.tsx: LIST_ITEM_WIDTH = windowWidth / 4. Each item's input range is
// [(index - 2) … (index + 2)] * LIST_ITEM_WIDTH; `a` is the scroll's distance from the item in
// items, |contentOffset / LIST_ITEM_WIDTH - index|.
fn itemWidth(w: number): number = w / 4
fn away(scroll: number, w: number, i: number): number = max(scroll / itemWidth(w) - i, i - scroll / itemWidth(w))
// translateY over [0, -W/3, -W/2, -W/3, 0], Extrapolation.EXTEND (default): past two items
// the last segment carries on, downwards.
fn arcY(a: number, w: number): number = a <= 1 ? 0 - itemWidth(w) / 2 + itemWidth(w) * a / 6 : 0 - itemWidth(w) / 3 + itemWidth(w) * (a - 1) / 3
// opacity over [0.5, 1, 1, 1, 0.5], Extrapolation.CLAMP.
fn arcOpacity(a: number): number = a <= 1 ? 1 : max(0.5, 1 - 0.5 * (a - 1))
// showScalingOutputRange [0.5, 0.9, 1.2, 0.9, 0.5], Extrapolation.CLAMP; the switch off is
// avoidScalingOutputRange, all 1.
fn arcScale(a: number, on: bool): number = on ? (a <= 1 ? 1.2 - 0.3 * a : max(0.5, 0.9 - 0.4 * (a - 1))) : 1

component CircularCarousel
  props
    env: DemoEnv
  state scroll = 0
  state scaleEnabled = false
  // The output range springs (withSpring(finalOutputRange): the default spring) when the switch
  // flips. The scale follows the scroll unsprung otherwise, so the spring is the scale's
  // transition only for the second it runs (a scroll after it turns it off): interpolate is
  // linear in its output range, so a spring of the interpolated scale from the old range's
  // value to the new one is the same curve.
  state springing = false
  state flippedAt = 0
  action scrolled(x: number, y: number)
    scroll = x
    if springing and performanceNow() - flippedAt > 1000
      springing = false
  action setScale(on: bool)
    scaleEnabled = on
    springing = true
    flippedAt = performanceNow()
  view
    // index.tsx container: centred; the backdrop (#f4f4f6) shows through.
    column position="absolute" inset=0 align-items="center" justify-content="center"
      testId="circular-carousel"
      // styles.label: fontSize 18, bold, letterSpacing 1, marginBottom 8, uppercase.
      text "Scale" font-size=18 font-weight=700 letter-spacing=1 margin-bottom=8
        text-transform="uppercase" color="#000000"
      view
        // trackColor { false: '#ccc', true: '#111' }.
        input type="checkbox" switch checked=scaleEnabled change=setScale accent-color="#111111"
          aria-label="Scale" testId="scale-switch"
      // circular-list styles.list: absolute, bottom 0, height LIST_ITEM_WIDTH * 3; paged by
      // snapToInterval LIST_ITEM_WIDTH; listContent centred, paddingRight LIST_ITEM_WIDTH * 3.
      scroll position="absolute" left=0 right=0 bottom=0 height=(itemWidth(env.width) * 3)
        overflow-x="scroll" overflow-y="hidden" scrollbar-width="none" scroll-snap-type="x mandatory"
        scroll=scrolled testId="circular-list"
        row width=(itemWidth(env.width) * 12) height=(itemWidth(env.width) * 3) align-items="center"
          for uri, i in photos() key=i
            // styles.container: aspectRatio 1, width LIST_ITEM_WIDTH; translateX
            // LIST_ITEM_WIDTH / 2 + LIST_ITEM_WIDTH, then translateY, then scale.
            view width=itemWidth(env.width) height=itemWidth(env.width) flex-shrink=0
              scroll-snap-align="start" testId=`photo-${i}`
              translate=`${itemWidth(env.width) * 1.5}px ${arcY(away(scroll, env.width, i), env.width)}px`
              scale=arcScale(away(scroll, env.width, i), scaleEnabled)
              opacity=arcOpacity(away(scroll, env.width, i))
              transition=(springing ? "scale -exact-spring(900, 120, 4)" : "none")
              // styles.imageContainer: margin 8, radius 100 continuous, boxShadow 0 0 10 10% black.
              view flex=1 margin=8 border-radius=100 corner-shape="squircle"
                box-shadow="0px 0px 10px rgba(0, 0, 0, 0.1)"
                // styles.image: white 2 pt border, radius 100 continuous; expo-image covers.
                image uri flex=1 border-radius=100 corner-shape="squircle" border-width=2
                  border-style="solid" border-color="#ffffff" object-fit="cover" aria-hidden=true
          // paddingRight LIST_ITEM_WIDTH * 3.
          view width=(itemWidth(env.width) * 3) height=1 flex-shrink=0
