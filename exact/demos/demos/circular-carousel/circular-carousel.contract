// Circular Carousel: nine round photos on a paged strip that bends into an arc as it scrolls.
// The Scale switch turns the arc's scale effect on and off. The strip, arc, shadows and photos
// are a Rust surface (gpu/src/circular_carousel.rs). The label and the switch are Contract.
use DemoEnv from "../env.contract"

// An item is a quarter of the window wide.
fn itemWidth(w: number): number = w / 4

component CircularCarousel
  props
    env: DemoEnv
  state scaleEnabled = false
  action setScale(on: bool)
    scaleEnabled = on
  // Haptics: selection as the photo at the crown changes, rigid when the strip is pulled past an end.
  action heard(m: string)
    if m == "haptic:selection"
      haptic("selection")
    if m == "haptic:impact-rigid"
      haptic("impact-rigid")
  view
    column position="absolute" inset=0 align-items="center" justify-content="center"
      testId="circular-carousel"
      // The line height and the nudge put the glyphs on the same pixels as the host's text.
      text "Scale" font-size=18 font-weight=700 letter-spacing=1 margin-bottom=8
        text-transform="uppercase" color="#000000" height="21.666667px"
        line-height="21.48046875px" position="relative" left="-0.3333px"
      // The host's switch sits a device pixel high, so it is nudged down.
      view width=65 align-items="flex-start"
        // Grey track when off, near-black when on.
        input type="checkbox" switch checked=scaleEnabled change=setScale accent-color="#111111"
          aria-label="Scale" testId="scale-switch" position="relative" left=1 top="0.1666px"
      // The strip is three item-widths tall, along the bottom.
      canvas surface=circular_carousel(scaleEnabled) message=heard position="absolute" left=0 bottom=0
        width=env.width height=(itemWidth(env.width) * 3) touch-action="none"
        testId="circular-list" aria-label="Photos: drag sideways"
