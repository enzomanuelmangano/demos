at "/demo/staggered-card-number"

test "the eye hides the first twelve digits and shows them again"
  expect tree has "card"
  expect text "digit-0" == "2"
  expect text "digit-15" == "1"
  expect tree has "icon-eye-off"
  tap "toggle"
  clock settle
  expect tree has "icon-eye"
  expect tree missing "icon-eye-off"
  tap "toggle"
  clock settle
  expect tree has "icon-eye-off"
  expect text "digit-11" == "0"
