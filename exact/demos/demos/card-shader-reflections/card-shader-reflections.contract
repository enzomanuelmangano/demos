// Card Shader Reflections: four metal cards (Metal, Silver, Gold, Platinum) in a horizontal
// carousel that snaps card by card. Each card tilts 18° and turns about its vertical axis as it
// leaves the centre, and its brushed-metal shader is lit by a light that follows the turn.
// Everything is Rust: gpu/src/card_shader_reflections.rs, and the shader in
// gpu/shaders/card_shader_reflections.wgsl.

component CardShaderReflections
  // Haptics: light when a finger lands on the list, soft when it lifts.
  action heard(m: string)
    if m == "haptic:impact-light"
      haptic("impact-light")
    if m == "haptic:impact-soft"
      haptic("impact-soft")
  view
    column position="absolute" inset=0 background-color="color(display-p3 0.066667 0.066667 0.066667)" testId="card-shader-reflections"
      canvas surface=card_shader_reflections() message=heard position="absolute" top=0 left=0 width="100%" height="100%"
        touch-action="none" testId="card-shader-reflections-canvas" aria-label="Swipe the cards sideways"
