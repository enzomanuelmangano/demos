// Fibonacci Shader: XorDev's sphere of glowing points, turning; the slider sets how many
// (5 to 350), the button a new spiral. RN: src/animations/fibonacci-shader (index.tsx,
// components/animated-slider). The canvas (the shader, and on an older build its blurred circle
// mask, its slider and its drag) is Rust: gpu/src/fibonacci_shader.rs.
//
// The owner's redesign (phone feedback, 2026-11-15: "the slider fights the navigation and should
// be native"; "the wand, and the whole layout, is embarrassing"): the sphere runs full-bleed and
// the controls are one floating glass bar, concentric with the display (10 from its edges): the
// count, SwiftUI's Slider (`swift-slider`, 5 to 350) and a glass `sparkles` button for a new
// spiral. The surface says `native` once it takes N from the slider (a build with the second
// input); until then this keeps RN's layout: the drawn slider and the round 🪄 button.
use PressableScale from "pressto"
use DemoEnv, roll, floatingWidth, concentricRadius from "../env.contract"

// The bar: 10 from the display's edges, 64 tall (a capsule: concentricRadius(10, 64) = 32); the
// button 48 round, 8 inside it (concentric: concentricRadius(18, 48) = 24).
fn fibInset(): number = 10
fn fibBarH(): number = 64
fn fibButton(): number = 48
// The slider's 0…1 as N, RN's [5, 350] CLAMP.
fn fibN(p: number): number = 5 + min(max(p, 0), 1) * 345

component FibonacciShader
  props
    env: DemoEnv
  // magicalMul: 2.4 first, then Math.random() * 100 at each press.
  state magic = 2.4
  state presses = 0
  // The native slider's value (0…1): N = 5 at mount, as RN's.
  state progress = 0
  // The surface took N (it said `native`).
  state native = false
  action wand
    magic = roll(env.seed, presses, 1000000) / 10000
    presses = presses + 1
  action sparkle
    haptic("selection")
    magic = roll(env.seed, presses, 1000000) / 10000
    presses = presses + 1
  action moved(v: string)
    progress = match parseNumber(v) { case some(n) => n, case none => progress }
  // The drawn slider's haptics (gpu/src/fibonacci_shader.rs, past RN): light on the grab, rigid
  // at an end of the track.
  action heard(m: string)
    if m == "native"
      native = true
    if m == "haptic:impact-light"
      haptic("impact-light")
    if m == "haptic:impact-rigid"
      haptic("impact-rigid")
  view
    // styles.container: black.
    column position="absolute" inset=0 background-color="#000000" color-scheme="dark"
      testId="fibonacci-shader"
      canvas surface=fibonacci_shader(magic, fibN(progress)) message=heard position="absolute" top=0 left=0
        width="100%" height="100%" touch-action="none" pointer-events=(native ? "none" : "auto")
        aria-label="Fibonacci sphere" testId="fibonacci-canvas"
      if native
        // The bar: liquid glass, concentric with the display.
        row position="absolute" left=fibInset() bottom=fibInset() width=floatingWidth(env.width, fibInset())
          height=fibBarH() border-radius=concentricRadius(fibInset(), fibBarH())
          corner-shape="-exact-continuous" backgroundMaterial="glass"
          -exact-glass-tint="rgba(255, 255, 255, 0.04)" align-items="center"
          padding-left=22 padding-right=(fibBarH() - fibButton()) / 2 gap=14 testId="fibonacci-bar"
          // The count, quiet: the sphere is the subject.
          text `${round(fibN(progress))}` width=34 font-size=15 font-weight=600
            font-variant-numeric="tabular-nums" color="rgba(255, 255, 255, 0.6)"
            aria-hidden=true testId="fibonacci-count"
          swift-slider progress="0" change=moved flex=1 height=32 min-width=0
            role="slider" aria-label="Points" testId="fibonacci-slider"
          button buttonStyle="glass" press=sparkle width=fibButton() height=fibButton()
            flex-shrink=0 aria-label="New spiral" testId="wand"
            image "symbol:sparkles" font-size=19
      else
        // styles.floatingButton: 64 round, #232323, 120 from the bottom, 60 from the right.
        view position="absolute" bottom=120 right=60 width=64 height=64 display="flex" flex-direction="column"
          PressableScale(press=wand)
            row flex-grow=1 border-radius=32 background-color="#232323" text-align="center"
              align-items="center" justify-content="center" aria-label="New spiral" testId="wand"
              // styles.floatingContent: fontSize 32.
              text "🪄" font-size=32
