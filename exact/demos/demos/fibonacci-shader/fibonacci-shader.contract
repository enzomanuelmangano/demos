// Fibonacci Shader: XorDev's sphere of glowing points, turning; the slider sets how many
// (5 to 350), the 🪄 button a new spiral. RN: src/animations/fibonacci-shader (index.tsx,
// components/animated-slider). The canvas (the shader, its blurred circle mask, the slider and
// its drag) is Rust: gpu/src/fibonacci_shader.rs; the button is here.
use PressableScale from "pressto"
use DemoEnv, roll from "../env.contract"

component FibonacciShader
  props
    env: DemoEnv
  // magicalMul: 2.4 first, then Math.random() * 100 at each press.
  state magic = 2.4
  state presses = 0
  action wand
    haptic("selection")
    magic = roll(env.seed, presses, 1000000) / 10000
    presses = presses + 1
  view
    // styles.container: black.
    column position="absolute" inset=0 background-color="#000000" testId="fibonacci-shader"
      canvas surface=fibonacci_shader(magic) position="absolute" top=0 left=0 width="100%" height="100%"
        touch-action="none" aria-label="Fibonacci sphere and its slider" testId="fibonacci-canvas"
      // styles.floatingButton: 64 round, #232323, 120 from the bottom, 60 from the right.
      button appearance="none" press=wand class=PressableScale position="absolute" bottom=120 right=60
        width=64 height=64 border-radius=32 border="none" background-color="#232323" display="flex"
        align-items="center" justify-content="center" aria-label="New spiral" testId="wand"
        // styles.floatingContent: fontSize 32.
        text "🪄" font-size=32
