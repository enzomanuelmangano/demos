// Sphere waves: 2000 dots on a Fibonacci sphere, breathing in waves of depth, with the gradient's
// hues turning over time. A tap on the right picks a new pattern; on the left, it goes back one.
// A pinch moves the eye nearer or farther. Drawn in Rust (gpu/src/sphere_waves.rs), which posts
// selection at the end of a tap and heavy impacts while the pinch is under 0.3, debounced to 500 ms.

component SphereWaves
  action buzz(m: string)
    if m == "haptic:selection"
      haptic("selection")
    if m == "haptic:impact-heavy"
      haptic("impact-heavy")
  view
    column position="absolute" inset=0 background-color="#000000" testId="sphere-waves"
      canvas surface=sphere_waves() position="absolute" top=0 left=0 width="100%" height="100%"
        touch-action="none" message=buzz testId="sphere-waves-canvas"
        aria-label="Tap right for a new pattern, left to go back; pinch to zoom"
