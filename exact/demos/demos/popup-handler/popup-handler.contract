// Popup Handler: a white circle over a photo, dragged anywhere; a tap blurs the screen (dark) and
// opens a four-row menu beside it (above or below, left or right, by where it is); a row closes
// the menu and, 800 ms later, springs the circle to that corner.
// RN: src/animations/popup-handler (index.tsx, BlurredPopup/{BlurredPopupProvider.tsx,
// TouchablePopupHandler.tsx}).
use PressablesConfig, pressNone, pressDown, pressUp, pressableOpacity, pressTransition from "pressto"
use DemoEnv, demoButtonRow from "../env.contract"

// index.tsx: size 64, internalPadding size / 2; the angles, their labels (capitalized words) and
// the arrow's rotation (getRotationByAngle).
fn popupLabel(a: number): string = match ["Top Left", "Top Right", "Bottom Left", "Bottom Right"].at(a) { case some(t) => t, case none => "" }
fn popupTurn(a: number): number = match [270, 0, 180, 90].at(a) { case some(t) => t, case none => 0 }
fn popupRight(a: number): bool = a == 1 or a == 3
fn popupBottom(a: number): bool = a == 2 or a == 3
// FontAwesome "location-arrow", the vector-icons font's glyph: 1792 units to the em, 1408 wide.
fn popupArrowPath(): string = "M1401 349 761 1629Q744 1664 704 1664Q699 1664 689 1662Q667 1657 653.5 1639.5Q640 1622 640 1600V1024H64Q42 1024 24.5 1010.5Q7 997 2 975Q-3 953 6 933Q15 913 35 903L1315 263Q1328 256 1344 256Q1371 256 1389 275Q1404 289 1407.5 309.5Q1411 330 1401 349Z"

// The corner's withSpring() (Reanimated 4's default: stiffness 900, damping 120, mass 4, so
// ω = 15/s and ζ = 1): critically damped, from rest, its progress 1 − (1 + 15t)·e^(−15t). The
// samples (t in ms, progress) keep straight segments within 2e-4 of it (0.15 px over the longest
// corner-to-corner path); it is within 5e-6 of 1 at 1000 ms.
fn popupSpringTimes(): number[] = [0, 2.7, 5.5, 8.4, 11.5, 14.7, 18.1, 21.7, 25.6, 29.8, 34.5, 39.7, 45.8, 53.4, 66, 80.5, 90, 98.4, 106.2, 113.7, 121, 128.2, 135.4, 142.6, 149.9, 157.2, 164.6, 172.2, 179.9, 187.8, 196, 204.4, 213.1, 222.1, 231.5, 241.3, 251.6, 262.4, 273.8, 285.9, 298.8, 312.7, 327.7, 344.1, 362.2, 382.5, 405.5, 432.3, 464.4, 504.5, 558.5, 642.1, 839.6, 1000]
fn popupSpringValues(): number[] = [0, 0.000798, 0.003222, 0.007302, 0.013273, 0.021015, 0.030818, 0.042769, 0.057314, 0.07458, 0.095557, 0.120422, 0.151299, 0.191567, 0.260562, 0.340082, 0.390785, 0.43411, 0.472805, 0.508461, 0.541611, 0.572752, 0.60232, 0.630312, 0.657097, 0.682302, 0.706282, 0.729315, 0.751067, 0.771801, 0.791709, 0.810495, 0.828342, 0.845195, 0.861177, 0.876216, 0.890389, 0.903619, 0.915954, 0.927413, 0.937994, 0.947749, 0.956627, 0.964676, 0.971888, 0.978286, 0.983834, 0.988572, 0.992485, 0.995571, 0.997843, 0.999302, 0.999954, 1]
fn popupSpringAt(i: number): number = match popupSpringValues().at(i) { case some(v) => v, case none => 1 }
fn popupSpringTime(i: number): number = match popupSpringTimes().at(i) { case some(v) => v, case none => 1000 }
// The spring's progress t ms after it starts (0 before), on the samples' segments.
fn popupSpringProgress(t: number): number = t <= 0 ? 0 : (t >= 1000 ? 1 : popupSpringSegment(t, match range(54).filter(i => popupSpringTime(i) <= t).at(-1) { case some(i) => i, case none => 0 }))
fn popupSpringSegment(t: number, i: number): number = popupSpringAt(i) + (popupSpringAt(i + 1) - popupSpringAt(i)) * (t - popupSpringTime(i)) / (popupSpringTime(i + 1) - popupSpringTime(i))
// The option's setTimeout(800), then the spring, begun by the row's press (a commit the timer's
// message made 800 ms on played its first frame at the end, and a transform drag's target takes
// only a spring transition: see port-demo Traps). The circle's box is moved to the corner at the
// press, and a wrapper the size of the way back (|dx| × |dy|) plays it from the old place: its
// translate from ∓100 % (the quadrant picks the signs) to 0 on the spring's curve, after the hold;
// `backwards` holds the start through the delay and leaves nothing on the wrapper once it ends
// (a transform still on it would keep the drag from binding). Two names a quadrant, so the next
// press restarts it.
keyframes popupCorner00
  from translate="-100% -100%"
  to translate="0% 0%"
keyframes popupCorner01
  from translate="-100% -100%"
  to translate="0% 0%"
keyframes popupCorner10
  from translate="100% -100%"
  to translate="0% 0%"
keyframes popupCorner11
  from translate="100% -100%"
  to translate="0% 0%"
keyframes popupCorner20
  from translate="-100% 100%"
  to translate="0% 0%"
keyframes popupCorner21
  from translate="-100% 100%"
  to translate="0% 0%"
keyframes popupCorner30
  from translate="100% 100%"
  to translate="0% 0%"
keyframes popupCorner31
  from translate="100% 100%"
  to translate="0% 0%"
fn popupSpringCurve(): string = `linear(0 0%, ${range(53).map(i => `${popupSpringAt(i + 1)} ${popupSpringTime(i + 1) / 10}%`).join(", ")})`
fn popupCornerAnimation(dx: number, dy: number, token: number, hold: number): string = token == 0 ? "none" : `popupCorner${(dx < 0 ? 1 : 0) + (dy < 0 ? 2 : 0)}${token % 2} 1000ms ${popupSpringCurve()} ${hold}ms backwards`
// RN's setTimeout before the option sets selectedAngle.
fn popupDelay(): number = 800

// The menu's withTiming 200 ms and the blur's 300 ms (Reanimated's default inOut(quad)).
fn popupEase(): string = "linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%)"

keyframes blurIn
  from opacity=0
  to opacity=1
keyframes blurOut
  from opacity=1
  to opacity=0

component PopupHandler
  props
    env: DemoEnv
  inject
    pressto: PressablesConfig
    pressablesOnPress: action
  // pressto: the pressed pressable (its key) and the press parity.
  state pressing = pressNone()
  action pressIn(key: number)
    pressing = pressDown(pressing, key)
  action pressOut
    pressing = pressUp(pressing)
  // translateX / translateY (the circle's place), starting at (size / 2, topY).
  state px = 32
  // (env is not read at state creation, so py is only used once the circle has moved: until
  // then its y is topY.)
  state py = 0
  state placed = false
  // selectedAngle (0 top-left … 3 bottom-right), as it will be once the last option's timeout has
  // fired: its reaction runs only when it changes.
  state angle = 0
  // The corner spring the row's press begins (popupCornerAnimation): where it starts (fromX/Y,
  // the circle's place at the press), the hold before it moves, when on the runner's clock
  // (performanceNow) the spring itself starts, and a token that restarts it. px/py hold its target
  // from the press.
  state fromX = 32
  state fromY = 0
  state hold = 0
  state springAt = -100000
  state springToken = 0
  // menuVisible, and the measured layout of the circle when it opened (params).
  state open = false
  state shown = false
  state pageX = 0
  state pageY = 0
  derive w = env.width
  derive h = env.height
  derive topY = env.safeTop + demoButtonRow()
  derive cy = placed ? py : topY
  // BlurredPopupProvider popupStyle: listItemHeight 54 × 4 options; above when it would end
  // under 100 px from the bottom, right-aligned when under 200 px from the right (its `right`
  // is the node's width, 64, as RN writes it); 5 px apart.
  derive above = h - pageY - 216 < 100
  derive alignLeft = w - pageX > 200
  derive menuTop = (above ? pageY - 216 : pageY + 64) + (above ? -5 : 5)

  action began(bw: number, bh: number, pw: number, ph: number)
    placed = placed
  // Pan onUpdate: translate = context + translation; the circle stays where it is let go.
  action released(x: number, y: number, scale: number, vx: number, vy: number, vscale: number)
    px = x
    py = y
    placed = true
  // TouchablePopupHandler's Tap (onTouchesUp): measure (the circle where it is drawn now, the
  // spring's progress included), showPopup, a selection haptic.
  action openPopup
    haptic("selection")
    let p = popupSpringProgress(performanceNow() - springAt)
    pageX = fromX + (px - fromX) * p
    pageY = fromY + (cy - fromY) * p
    open = true
    shown = true
  // close(): the menu fades (200 ms), the blur 100 ms later (300 ms).
  action close
    open = false
  // A row (PressableOpacity): close(), then 800 ms later selectedAngle; its reaction springs
  // the circle to the corner when the angle changes. The spring is begun here, held 800 ms.
  action pick(a: number)
    pressablesOnPress()
    open = false
    if a != angle
      let now = performanceNow()
      let p = popupSpringProgress(now - springAt)
      fromX = fromX + (px - fromX) * p
      fromY = fromY + (cy - fromY) * p
      angle = a
      px = popupRight(a) ? w - 64 - 32 : 32
      py = popupBottom(a) ? h - 64 - 64 : topY
      placed = true
      hold = popupDelay()
      springAt = now + popupDelay()
      springToken = springToken + 1
  view
    // The root View: #111, flex 1; an expo-image absoluteFill (cover).
    column position="absolute" inset=0 background-color="#111111" overflow="hidden"
      testId="popup-handler"
      image "assets/demos/popup-handler/background.jpg" position="absolute" inset=0
        width="100%" height="100%" object-fit="cover" aria-hidden=true
      // The GestureDetector's Animated.View (64 × 64, translated): the transform drag's target
      // is a layer the size of the screen, under an untransformed, clipping parent.
      column position="absolute" inset=0 overflow="hidden" pointer-events="none"
        column id="popup-drag" width="100%" height="100%" box-sizing="border-box"
          position="relative" translate=`${px}px ${cy}px`
          // The corner spring's way back from the box's new place (popupCornerAnimation).
          view position="absolute" left=0 top=0 width=max(px - fromX, fromX - px)
            height=max(cy - fromY, fromY - cy) pointer-events="none"
            animation=popupCornerAnimation(px - fromX, cy - fromY, springToken, hold)
            // The white circle (radius size / 2, continuous).
            view position="absolute" left=0 top=0 width=64 height=64 border-radius=32 corner-shape="-exact-continuous"
              background-color="#ffffff" pointer-events="auto" touch-action="none"
              transformDragFor="popup-drag" transformgeometry=began transformrelease=released
              press=openPopup role="button" aria-label="Show the menu" testId="popup-circle"
      // The BlurView (intensity maxBlur × 20, tint dark): opacity withTiming(1, 300) on show,
      // to 0 100 ms after close; a touch on it closes.
      // (Keyframes: the host ignores a transition's delay, an animation's holds.)
      view position="absolute" inset=0 backgroundMaterial="dark" opacity=0
        animation=(shown ? (open ? `blurIn 300ms ${popupEase()} both` : `blurOut 300ms ${popupEase()} 100ms both`) : "none")
        pointer-events=(open ? "auto" : "none") press=close aria-label="Close the menu"
        testId="popup-blur"
      // mainPopupContainerView (absoluteFill, zIndex 500): the node copy, the touch catcher,
      // the menu.
      if shown
        // (RN keeps it touchable until the blur has faded; here it stops at the close.)
        column position="absolute" inset=0 pointer-events="none"
          // The node at its measured place, with the menu's opacity and scale.
          view position="absolute" left=pageX top=pageY width=64 height=64 border-radius=32 corner-shape="-exact-continuous"
            background-color="#ffffff" pointer-events="none" opacity=(open ? 1 : 0)
            scale=(open ? 1 : 0.95)
            transition=`opacity 200ms ${popupEase()}, scale 200ms ${popupEase()}`
            aria-hidden=true
          view position="absolute" inset=0 press=close aria-label="Close the menu"
            pointer-events=(open ? "auto" : "none") testId="popup-background"
          // styles.popup: radius 12 continuous, boxShadow 0 8 16 25 % black, clipped.
          column position="absolute" top=menuTop height=216 left=(alignLeft ? pageX : "auto")
            right=(alignLeft ? "auto" : 64) border-radius=12 corner-shape="-exact-continuous"
            overflow="hidden" box-shadow="0px 8px 16px rgba(0, 0, 0, 0.25)"
            pointer-events=(open ? "auto" : "none") opacity=(open ? 1 : 0) scale=(open ? 1 : 0.95)
            transition=`opacity 200ms ${popupEase()}, scale 200ms ${popupEase()}`
            testId="popup-menu"
            for a in range(4) key=a
              // A row: 54 tall, rgba(255,255,255,0.95), paddingHorizontal 16, a 0.5 px
              // rgba(0,0,0,0.08) rule under it (none under the last).
              row press=pick(a) role="button" aria-label=popupLabel(a)
                pointerdown=pressIn(a) pointerup=pressOut
                opacity=pressableOpacity(pressing, a, pressto) transition=pressTransition("opacity", pressto)
                height=54 align-items="center" padding-left=16 padding-right=16
                background-color="rgba(255, 255, 255, 0.95)"
                border-bottom-width=(a == 3 ? 0 : 0.5) border-bottom-style="solid"
                border-bottom-color="rgba(0, 0, 0, 0.08)" testId=`popup-option-${a}`
                // styles.title: #1a1a1a, 16, 500, letterSpacing 0.3.
                text popupLabel(a) color="#1a1a1a" font-size=16 font-weight=500 letter-spacing=0.3
                view flex=1
                // trailingContainer: marginLeft 8; FontAwesome location-arrow 14 gray, rotated.
                view margin-left=8
                  svg width=11 height=14 viewBox="0 0 1408 1792" rotate=`${popupTurn(a)}deg`
                    aria-hidden=true
                    path d=popupArrowPath() fill="#808080"
