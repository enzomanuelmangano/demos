// Animated Count Text: a number whose digits roll to their new value; the shuffle button picks
// a random number of one to six digits. RN: src/animations/animated-count-text.
use PressableScale from "pressto"
use DemoEnv, roll from "../env.contract"

// animated-count.tsx: TEXT_DIGIT_HEIGHT 55, TEXT_DIGIT_WIDTH 40, FONT_SIZE 50.
fn digitsOf(n: number): number[] = n.toString().split("").map(c => "0123456789".indexOf(c))
fn tenTo(d: number): number = match [1, 10, 100, 1000, 10000, 100000, 1000000].at(d) { case some(v) => v, case none => 1 }
// index.tsx getRandomNumber(digits): uniform in [10^(digits-1), 10^digits - 1].
fn randomNumber(seed: number, k: number): number = randomOf(seed, k, 1 + roll(seed, 2 * k, 6))
fn randomOf(seed: number, k: number, d: number): number = tenTo(d - 1) + roll(seed, 2 * k + 1, tenTo(d) - tenTo(d - 1))

// FadeIn / FadeOut 250 ms for a digit that comes or goes.
keyframes digitIn
  from opacity=0
keyframes digitOut
  to opacity=0

component AnimatedCountText
  props
    env: DemoEnv
  state value = 1
  state shuffles = 0
  action shuffle
    haptic("selection")
    value = randomNumber(env.seed, shuffles)
    shuffles = shuffles + 1
  view
    column position="absolute" inset=0 background-color="#000000" align-items="center" justify-content="center"
      testId="animated-count-text"
      // The row resizes on LinearTransition.springify(): Reanimated 4's default spring.
      row -exact-layout-transition="-exact-spring(900, 120, 4)" testId="count" aria-label=`${value}`
        for d, i in digitsOf(value) key=i
          // Each place: a 40 x 55 window over the column 0…9, rolled to its digit by a spring
          // (withSpring duration 1000, dampingRatio 0.9: bun tools/spring.ts 1000 0.9), resized
          // over 800 ms.
          column width=40 height=55 overflow="hidden" -exact-layout-transition="800ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%)"
            animation="digitIn 250ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%) both"
            -exact-exit-animation="digitOut 250ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%) both"
            column translate=`0px ${0 - 55 * d}px` transition="translate -exact-spring(333, 65.7, 4)"
              for n in range(10) key=n
                text `${n}` width=40 height=55 line-height="55px" text-align="center"
                  font-size=50 font-weight=700 color="#ffffff" aria-hidden=true
      button appearance="none" press=shuffle aria-label="Shuffle" testId="shuffle" class=PressableScale
        position="absolute" right=30 bottom=80 width=64 height=64 border-radius=32 background-color="#ffffff"
        display="flex" align-items="center" justify-content="center"
        image "symbol:sf/shuffle" font-size=24 color="#000000"
