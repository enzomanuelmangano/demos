// Everybody Can Cook: "Everybody" / "can cook." in Honk on black; a tap anywhere sends a wave
// through the letters, each one replaced by a copy that rises and stands up into its place.
// RN: src/animations/everybody-can-cook (index.tsx, components/staggered-text.tsx,
// components/staggered-digit.tsx).

// fonts.ts 'Honk-Regular' is declared once in ../env.contract.

// The motion is the owner's call (phone feedback, 2026-11-15: "super elegant and professional",
// after Vercel's text transitions), not RN's 1.4 s spring flip. A tap is a wave: each letter's
// new copy rises 22 pt into place while it stands up from 50° tipped back about its baseline
// and fades in, 560 ms on a strong ease-out (cubic-bezier(0.22, 1, 0.36, 1): fast to respond,
// long to settle, no overshoot on text); the copy it replaces leaves faster, 320 ms up 16 pt,
// tipping 40° away about its middle, fading out. Letters follow each other by 22 ms, the second
// line 120 ms behind the first, so a word reads as one gesture rather than a queue. Under a
// perspective of 600 the turns stay subtle. The references: Vercel/Geist-style blur-in and
// rotating-word components (letter split, y offset, opacity, 20–60 ms stagger); the host
// animates no `filter`, so the blur they use is left out and the tip stands in for it.
fn enter(delay: number): string = `arrive 560ms cubic-bezier(0.22, 1, 0.36, 1) ${delay}ms both`
fn exit(delay: number): string = `leave 320ms cubic-bezier(0.23, 1, 0.32, 1) ${delay}ms both`

// Keyframes animate the angle; the axis (x) is each node's own `rotate`. The iOS host lowers a
// box's rotate keyframes to Core Animation's `transform.rotation.z` whatever the axis (exact2
// host/apple/src/svg_lower.rs `specs_in`; exact/parity-tools/exact-issues/rotate-axis.md): the
// letters turned flat in the screen's plane. A transform-origin off the centre makes the host
// sample the node instead, through its 3D axis (left bottom: the baseline the copy stands up
// from; left center: the middle the old copy tips about).
//
// A press never cuts a run short (the owner's call: RN's reset() restarted every letter, a
// visible jump on a second tap). Each tap is a run of its own, keyed by its number: its copy of
// each letter arrives and, once a later tap comes, its box leaves from wherever the copy inside
// has got to, so quick taps layer waves and nothing restarts. A run stays mounted until its last
// letter has left: the next tap plus that letter's delay (up to 296 ms) plus the leave (320 ms).
// Ten runs cover 8 taps a second with room.
keyframes leave
  from opacity=1 translate="0px 0px" rotate=0
  to opacity=0 translate="0px -16px" rotate=40
keyframes arrive
  from opacity=0 translate="0px 22px" rotate=-50
  to opacity=1 translate="0px 0px" rotate=0

// The runs on screen: the last ten press numbers (0 = the letters at rest before any press).
fn runs(plays: number): number[] = range(10).map(k => plays - 9 + k).filter(k => k >= 0)

component EverybodyCanCook
  // How many taps: 0 = never animated (progress 0, the top copies shown).
  state plays = 0
  // PressableWithoutFeedback onPress (reset() and animate() both texts), the owner's way: every
  // tap is a new wave the moment the finger lands (a press waits for the lift, and quick taps
  // read as one), each with a light impact (phone feedback, 2026-11-15; RN's PressablesConfig
  // plays the selection haptic on each press).
  action play
    haptic("impact-light")
    plays = plays + 1
  view
    // styles.fill: black.
    column position="absolute" inset=0 background-color="#000000" testId="everybody-can-cook"
      // styles.container (the PressableWithoutFeedback): flex 1, centred vertically,
      // paddingHorizontal 42.
      column flex=1 justify-content="center" padding="0px 42px" pointerdown=play testId="cook"
        aria-label="Everybody can cook."
        StaggeredText(text="Everybody", delay=0, plays=plays, testId="everybody")
        // The second line 120 ms behind (RN: delay={280} on its 40 ms stagger).
        StaggeredText(text="can cook.", delay=120, plays=plays, testId="can-cook")

// staggered-text.tsx: styles.container row, flexWrap wrap; one StaggeredDigit per character.
component StaggeredText
  props
    text: string
    delay: number
    plays: number
    testId: string
  view
    row flex-wrap="wrap" testId=testId aria-hidden=true
      for c, i in text.split("") key=i
        // StaggeredDigit styles.container: centred. The letter in flow, unseen, holds the cell's
        // size (styles.digit: white; fontSize 50; textStyle Honk-Regular); the runs sit over it.
        column position="relative" align-items="center" justify-content="center" testId=`${testId}-${i}`
          text c font-family="Honk-Regular" font-size=50 color="#ffffff" white-space="pre"
            visibility="hidden"
          for k in runs(plays) key=k
            // The perspective the turns are seen under: Exact's `perspective` (CSS's) acts on a
            // box's children, so it sits on a box the size of the cell, its vanishing point the
            // cell's centre.
            view position="absolute" left=0 top=0 right=0 bottom=0 perspective=600
              // The run's box: it leaves once a later tap comes, whatever the copy inside is doing.
              view position="absolute" left=0 top=0 right=0 bottom=0 rotate="x 0deg"
                transform-origin="left center" perspective=600
                animation=(k < plays ? exit(i * 22 + delay) : "none")
                // The run's copy: it arrives with the tap (at rest for run 0).
                text c position="absolute" left=0 top=0 font-family="Honk-Regular" font-size=50
                  color="#ffffff" white-space="pre" rotate="x 0deg" transform-origin="left bottom"
                  animation=(k == 0 ? "none" : enter(i * 22 + delay))
