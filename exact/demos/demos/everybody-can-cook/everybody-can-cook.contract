// Everybody Can Cook: "Everybody" / "can cook." in Honk on black; a tap anywhere flips every
// letter over on X, one after another (each letter's copy rotates down and fades as a second copy
// rotates up into its place). RN: src/animations/everybody-can-cook (index.tsx,
// components/staggered-text.tsx, components/staggered-digit.tsx).

// fonts.ts 'Honk-Regular' is declared once in ../env.contract.

// staggered-text.tsx: each letter's progress is withDelay(index * 40 + delay,
// withSpring(1, { duration: 350, dampingRatio: 2.8 })), mass 4 (GentleSpringConfigWithDuration).
// bun tools/spring.ts 350 2.8 → stiffness 319.6. Reanimated runs a duration spring with
// dampingRatio ≥ 1 critically damped at ω0 = √(k / m) = 8.9387 rad/s
// (springUtils.ts criticallyDampedSpringCalculations), p(t) = 1 - e^(-ω0 t)(1 + ω0 t), until its
// energy falls to 6e-9 of the start: 1384 ms. An `animation` takes no spring, so that curve is
// sampled into `linear()` (60 steps). Every style below is linear in p, so the keyframes ride it
// exactly.
fn flip(): string = "1384ms linear(0, 0.0185, 0.0649, 0.128, 0.2, 0.2755, 0.3506, 0.4229, 0.4908, 0.5534, 0.6103, 0.6616, 0.7072, 0.7476, 0.7831, 0.8142, 0.8412, 0.8646, 0.8847, 0.9021, 0.917, 0.9297, 0.9406, 0.9499, 0.9578, 0.9644, 0.9701, 0.9749, 0.9789, 0.9823, 0.9852, 0.9876, 0.9896, 0.9913, 0.9928, 0.994, 0.995, 0.9958, 0.9965, 0.9971, 0.9976, 0.998, 0.9983, 0.9986, 0.9988, 0.999, 0.9992, 0.9993, 0.9995, 0.9995, 0.9996, 0.9997, 0.9997, 0.9998, 0.9998, 0.9999, 0.9999, 0.9999, 0.9999, 0.9999, 1)"

// staggered-digit.tsx (DefaultFontSize 50, DefaultFontHeight 55):
// top copy: opacity 1 - p, perspective(1000) translateY(-p · 55 / 2) rotateX(p · 90deg);
// bottom copy: opacity p, translateY(interpolate p → [27.5, 0]) rotateX(interpolate p → [-90, 0]).
// Keyframes animate the angle; the axis (x) is each copy's own `rotate`. Two names for each:
// a tap swaps them, which restarts the animation from p = 0 (RN's reset() then animate()).
keyframes topA
  from opacity=1 translate="0px 0px" rotate=0
  to opacity=0 translate="0px -27.5px" rotate=90
keyframes topB
  from opacity=1 translate="0px 0px" rotate=0
  to opacity=0 translate="0px -27.5px" rotate=90
keyframes bottomA
  from opacity=0 translate="0px 27.5px" rotate=-90
  to opacity=1 translate="0px 0px" rotate=0
keyframes bottomB
  from opacity=0 translate="0px 27.5px" rotate=-90
  to opacity=1 translate="0px 0px" rotate=0

fn flipOf(name: string, plays: number, wait: number): string = plays == 0 ? "none" : `${name}${plays % 2 == 1 ? "A" : "B"} ${flip()} ${wait}ms both`

component EverybodyCanCook
  // How many taps: 0 = never animated (progress 0, the top copies shown).
  state plays = 0
  // PressableWithoutFeedback onPress: reset() and animate() both texts. The app's
  // PressablesConfig plays the selection haptic on every pressto press.
  action play
    haptic("selection")
    plays = plays + 1
  view
    // styles.fill: black.
    column position="absolute" inset=0 background-color="#000000" testId="everybody-can-cook"
      // styles.container (the PressableWithoutFeedback): flex 1, centred vertically,
      // paddingHorizontal 42.
      column flex=1 justify-content="center" padding="0px 42px" press=play testId="cook"
        aria-label="Everybody can cook."
        StaggeredText(text="Everybody", delay=0, plays=plays, testId="everybody")
        // delay={280}
        StaggeredText(text="can cook.", delay=280, plays=plays, testId="can-cook")

// staggered-text.tsx: styles.container row, flexWrap wrap; one StaggeredDigit per character.
component StaggeredText
  props
    text: string
    delay: number
    plays: number
    testId: string
  view
    row flex-wrap="wrap" testId=testId aria-hidden=true
      for c, i in text.split("") key=i
        // StaggeredDigit styles.container: centred.
        column position="relative" align-items="center" justify-content="center" testId=`${testId}-${i}`
          // styles.digit: white; fontSize 50; textStyle Honk-Regular. perspective(1000) leads
          // its transform.
          text c font-family="Honk-Regular" font-size=50 color="#ffffff" white-space="pre"
            perspective=1000 rotate="x 0deg" animation=flipOf("top", plays, i * 40 + delay)
          // The second copy, absolute over the first, at p = 0 before the first tap.
          text c position="absolute" left=0 top=0 font-family="Honk-Regular" font-size=50
            color="#ffffff" white-space="pre" opacity=0 translate="0px 27.5px" rotate="x -90deg"
            animation=flipOf("bottom", plays, i * 40 + delay)
