// Verification Code: five boxes over a hidden number field; each digit typed flips into its box.
// The fifth digit checks the code (11111): green, or red with a shake; a second later the code
// clears, its digits flipping out. RN: src/animations/verification-code (screens/verification-code,
// components/verification-code/*, and email-demo/hooks/use-animated-shake.ts).
//
// A demo is not the app's root, so it has no timer (`task`): RN's setTimeout(reset, 1000) is
// drawn by delayed transitions and keyframes (the digits leave and the borders return at
// 1000 ms on the host), and the state catches up at the next keystroke.

// The app's FiraCode-Regular (assets/fonts in the RN repo), under a family name of this demo's own
// (two files may not declare one family).

// index.tsx: correctCode 11111, so maxCodeLength 5.
fn correctCode(): string = "11111"

// A digit on screen. `leaving` flips it out; `late` waits the reset's 1000 ms first.
shape Glyph
  key: number
  box: number
  digit: number
  leaving: bool
  late: bool
  leftAt: number

fn digitAt(s: string, i: number): number = "0123456789".indexOf(s.slice(i, i + 1))
fn statusOf(code: string): string = code == correctCode() ? "correct" : code.length == 5 ? "wrong" : "inProgress"

// animated-code-number.tsx getColorByStatus: highlighted (the next box) white first, then
// green when correct, red when wrong, else #2E2B2E.
fn liveColor(code: string, status: string, i: number): string = i == code.length ? "#FFFFFF" : status == "correct" ? "color(display-p3 0.1333 0.7333 0.2)" : status == "wrong" ? "color(display-p3 0.7333 0.1294 0.1412)" : "color(display-p3 0.1804 0.1686 0.1804)"
// After the reset: no code, so the first box is highlighted.
fn resetColor(i: number): string = i == 0 ? "#FFFFFF" : "color(display-p3 0.1804 0.1686 0.1804)"
// The finished code's borders: from the colours at four digits (the last box highlighted) to the
// status colour over 300 ms, held, then at 1000 ms to the reset colours over 300 ms.
fn finishKeyframes(status: string, i: number): string = `${status == "correct" ? "correct" : "wrong"}${i == 0 ? "First" : i == 4 ? "Last" : "Middle"} 1300ms linear both`

// borderColor: withTiming(colour): 300 ms on inOut(quad) (Reanimated's default curve, as its
// cubic-bezier). 300 / 1300 = 23.0769%, 1000 / 1300 = 76.9231%.
keyframes wrongFirst
  0% border-color="#2f2b2e" animation-timing-function="linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%)"
