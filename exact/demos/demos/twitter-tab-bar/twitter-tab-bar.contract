// Twitter Tab Bar: a dark feed of 50 empty rows over a four-tab bar with a floating compose
// button; scrolling down hides the bar (and shrinks the button away), scrolling up brings it
// back; the Message tab spins the button into a message icon. RN: src/animations/twitter-tab-bar
// (index.tsx, constants/palette.ts, constants/screens.ts, screens/home/index.tsx,
// components/bottom-tab-bar/index.tsx, floating-button.tsx, active-tab-bar-provider.tsx).
// The direction is read on every scroll event and drives springs that restart from rest on each
// flip, and the button's three animated styles overwrite one transform: the feed (its
// UIScrollView), the bar and the button are Rust, gpu/src/twitter_tab_bar.rs. The surface posts
// `haptic:selection` on a tab press (the app's PressablesConfig onPress).
use DemoEnv from "../env.contract"

component TwitterTabBar
  props
    env: DemoEnv
  action heard(m: string)
    if m == "haptic:selection"
      haptic("selection")
  view
    // The bar's paddingBottom and the button's bottom read safeBottom / 2.
    canvas surface=twitter_tab_bar(env.safeBottom) message=heard position="absolute" top=0 left=0
      width=env.width height=env.height background-color="color(display-p3 0.0902 0.1255 0.1647)"
      touch-action="none" testId="twitter-tab-bar"
      aria-label="Feed: scroll to hide the tab bar; tabs at the bottom, a compose button above"
