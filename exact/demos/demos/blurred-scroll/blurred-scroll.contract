// Blurred Scroll: ten violet cards in a vertical list on black; the card leaving the centre
// upward shrinks, tilts and blurs out. RN: src/animations/blurred-scroll (index.tsx,
// components/BlurredItem.tsx). The Animated.FlatList (its UIScrollView: gpu/src/ui_scroll.rs)
// and the cards (blur, tilt and scale per scroll offset) are drawn in Rust:
// gpu/src/blurred_scroll.rs. No commit per scroll frame.
use DemoEnv from "../env.contract"

// Reanimated's FadeIn on the FlatList: 300 ms on withTiming's default curve, Easing.inOut(Easing.quad).
keyframes listFadeIn
  from opacity=0
  to opacity=1

component BlurredScroll
  props
    env: DemoEnv
  view
    // styles.container: black, flex 1.
    column position="absolute" inset=0 background-color="#000000" testId="blurred-scroll"
      canvas surface=blurred_scroll() position="absolute" top=0 left=0 width=env.width
        height=env.height touch-action="none" testId="blurred-scroll-canvas"
        aria-label="Ten violet cards: scroll to blur and tilt them"
        animation="listFadeIn 300ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%) both"
