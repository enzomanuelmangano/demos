// Blurred Scroll: ten violet cards in a vertical list on black; the card leaving the centre
// upward shrinks, tilts and blurs out. RN: src/animations/blurred-scroll (index.tsx,
// components/BlurredItem.tsx). The cards (their blur, tilt and scale per scroll offset) are
// drawn in Rust: gpu/src/blurred_scroll.rs; the FlatList's scroll is native, here, its offset
// the surface's one input.
use DemoEnv from "../env.contract"

// blurredItemContainerHeight = windowHeight × 0.45.
fn itemHeight(h: number): number = h * 0.45
// The content: paddingTop and paddingBottom windowHeight / 2 − itemHeight / 2 around ten items.
fn contentHeight(h: number): number = 10 * itemHeight(h) + 2 * (h / 2 - itemHeight(h) / 2)
// Reanimated's FadeIn: 300 ms on withTiming's default curve, Easing.inOut(Easing.quad).
keyframes listFadeIn
  from opacity=0
  to opacity=1

component BlurredScroll
  props
    env: DemoEnv
  // contentOffsetY: the one value written per scroll frame, read only by the canvas.
  state scroll = 0
  action scrolled(x: number, y: number)
    scroll = y
  view
    // styles.container: black, flex 1.
    column position="absolute" inset=0 background-color="#000000" testId="blurred-scroll"
      canvas surface=blurred_scroll(scroll) position="absolute" top=0 left=0 width=env.width
        height=env.height aria-hidden=true testId="blurred-scroll-canvas"
        animation="listFadeIn 300ms cubic-bezier(0.455, 0.03, 0.515, 0.955) both"
      // The Animated.FlatList (showsVerticalScrollIndicator false): its content is drawn by the
      // canvas under it; the scroller holds only the content's height.
      scroll position="absolute" top=0 left=0 width="100%" height="100%" scrollbar-width="none"
        scroll=scrolled testId="blurred-scroll-list"
        view height=contentHeight(env.height) flex-shrink=0
