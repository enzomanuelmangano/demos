use VerificationCode from "./verification-code/verification-code.contract"

component PortedDemo
  props
    slug: string
    env: DemoEnv
  view
    column position="absolute" inset=0
      if slug == "alert-drawer"
        AlertDrawer(env=env)
      if slug == "animated-clip-box"
        AnimatedClipBox(env=env)
      if slug == "animated-count-text"
        AnimatedCountText(env=env)
      if slug == "animated-grid-list"
        AnimatedGridList(env=env)
      if slug == "animated-indicator-list"
        AnimatedIndicatorList(env=env)
      if slug == "blur-circles"
        BlurCircles()
      if slug == "bottom-bar-skia"
        BottomBarSkia(env=env)
      if slug == "checkbox-interactions"
        CheckboxInteractions(env=env)
      if slug == "circular-carousel"
        CircularCarousel(env=env)
      if slug == "composable-text"
        ComposableText()
      if slug == "coverflow-carousel"
        CoverflowCarousel(env=env)
      if slug == "cuberto-slider"
        CubertoSlider()
      if slug == "dynamic-tab-indicator"
        DynamicTabIndicator(env=env)
      if slug == "email-demo"
        EmailDemo(env=env)
      if slug == "everybody-can-cook"
        EverybodyCanCook()
      if slug == "family-number-input"
        FamilyNumberInput(env=env)
      if slug == "floating-bottom-bar"
        FloatingBottomBar(env=env)
      if slug == "fluid-slider"
        FluidSlider(env=env)
      if slug == "geometry-button"
        GeometryButton()
      if slug == "github-contributions"
        GithubContributions(env=env)
      if slug == "imessage-stack"
        ImessageStack(env=env)
      if slug == "metaball"
        Metaball()
      if slug == "miles-bar-chart"
        MilesBarChart(env=env)
      if slug == "online-offline"
        OnlineOffline(env=env)
      if slug == "radar-chart"
        RadarChart(env=env)
      if slug == "scroll-progress"
        ScrollProgress(env=env)
      if slug == "shake-to-delete"
        ShakeToDelete(env=env)
      if slug == "shared-transitions"
        SharedTransitions(env=env)
      if slug == "smooth-dropdown"
        SmoothDropdown()
      if slug == "spiral"
        Spiral()
      if slug == "split-button"
        SplitButton()
      if slug == "stacked-carousel"
        StackedCarousel(env=env)
      if slug == "stacked-list"
        StackedList(env=env)
      if slug == "stacked-modals"
        StackedModals(env=env)
      if slug == "steps"
        Steps(env=env)
      if slug == "story-list"
        StoryList(env=env)
      if slug == "tab-navigation"
        TabNavigation(env=env)
      if slug == "verification-code"
        VerificationCode()
