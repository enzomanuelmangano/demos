// Story list: a deck of eight story cards. Scrolling sideways throws the front card off to the
// left while the ones behind step forward and grow.
use DemoEnv from "../env.contract"

component StoryList
  props
    env: DemoEnv
  // Haptics: selection as the front card changes, rigid when pulled past an end.
  action heard(m: string)
    if m == "haptic:selection"
      haptic("selection")
    if m == "haptic:impact-rigid"
      haptic("impact-rigid")
  view
    column position="absolute" inset=0 background-color="color(display-p3 0.1765 0.1882 0.2706)"
      testId="story-list"
      canvas surface=story_list() message=heard position="absolute" top=0 left=0 width=env.width height=env.height
        touch-action="none" aria-label="Stories" testId="story-list-scroll"
