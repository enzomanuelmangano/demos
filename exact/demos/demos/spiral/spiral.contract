// Spiral: about 1640 glowing circles on a logarithmic spiral. A tap anywhere springs them to a new
// angle. Drawn and sprung in Rust (gpu/src/spiral.rs).

component Spiral
  // The surface posts the selection haptic on each tap.
  action heard(m: string)
    if m == "haptic:selection"
      haptic("selection")
  view
    canvas surface=spiral() message=heard position="absolute" top=0 left=0 width="100%" height="100%"
      background-color="#010101" testId="spiral" aria-label="Tap to turn the spiral"
