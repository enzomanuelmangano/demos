at "/demo/chessboard"

// The web host gives a surface no touches, so the rules, the drag, the clocks and the review card
// are checked by the Rust tests (gpu/src/chessboard.rs, gpu/src/chessboard/chess.rs). Here only
// the screen is checked.
test "the canvas fills the screen"
  expect tree has "chessboard"
  expect tree has "chessboard-canvas"

// No control is drawn over the board.
test "no dock over the board"
  expect tree missing "puzzle-bar"
