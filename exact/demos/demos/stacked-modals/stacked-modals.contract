// Stacked Modals: a black + button opens a card; Confirm or Dismiss stacks the next card in
// front, the older ones shrinking and rising behind it (three visible); the seventh's Dismiss
// removes it, and a tap on the backdrop clears them all, each falling away in turn.
// RN: src/animations/stacked-modals (index.tsx, hook.tsx, hooks/use-modal.tsx,
// stacked-modal-manager/{constants.ts, hooks.ts, stacked-modal-provider.tsx, stacked-modal.tsx,
// backdrop/index.tsx}).
use PressablesConfig, pressNone, pressDown, pressUp, pressableScale, animatedPressableColor, pressTransition from "pressto"
use DemoEnv from "../env.contract"

// hook.tsx onPress: the seven modals.
fn titleOf(i: number): string = match ["Modals are fun!", "Stacked Modals are really fun!", "Wait what?", "Are you sure?", "Ok, you win.", "...the past is always with you.", "You can dismiss me"].at(i) { case some(t) => t, case none => "" }
fn messageOf(i: number): string = match ["They're versatile, attention-grabbing, and when used appropriately, can significantly enhance the user experience.", "Yep, they are slightly tricky to get right.\n\nBy confirming you'll find the source code at reactiive.io/demos", "You might want to reconsider don't you?", "You might regret this for the rest of your life.", "You can go now, but remember...", "Just like the shadow that follows you everywhere.", "But you can also dismiss all the modals by tapping the backdrop"].at(i) { case some(t) => t, case none => "" }

// A modal on the stack: serial × 10 + its index in the list (the serial keys it, so the
// seventh shown again is a new card). The stack is newest first: its place is its id.
fn modalOf(entry: number): number = entry % 10

// constants.ts: MODAL_HEIGHT 200, MAX_VISIBLE_MODALS 3. hooks.ts bottomHeight =
// min(id, MAX_VISIBLE_MODALS - 1) + 15 × id.
fn bottomHeight(id: number): number = min(id, 2) + 15 * id

// withCustomSpring: { mass 2.5, damping 100, stiffness 740 }.
// ζ 1.16 ≥ 1: Reanimated runs it critically damped, so damping 2√(k·m) = 86.02.
fn modalSpring(): string = "-exact-spring(740, 86.0233, 2.5)"

// On mount `bottom` springs from (windowHeight - 200) / 2 - 110 (bottomOffset) to its place
// and baseOpacity from 0 to 1, on that spring (overdamped, ζ 1.16): its curve from rest,
// 1 - (r₂e^{r₁t} - r₁e^{r₂t}) / (r₂ - r₁) with r = -9.80, -30.20, sampled every 25 ms over 1 s
// (8e-5 of the travel left).
keyframes modalIn
  from translate="0px 110px" opacity=0
  to translate="0px 0px" opacity=1
fn modalInTiming(): string = "1000ms linear(0, 0.0671, 0.1992, 0.3401, 0.4679, 0.5762, 0.6649, 0.7361, 0.7927, 0.8374, 0.8726, 0.9002, 0.9218, 0.9388, 0.9521, 0.9625, 0.9706, 0.977, 0.982, 0.9859, 0.989, 0.9914, 0.9933, 0.9947, 0.9959, 0.9968, 0.9975, 0.998, 0.9984, 0.9988, 0.999, 0.9993, 0.9994, 0.9995, 0.9996, 0.9997, 0.9998, 0.9998, 0.9999, 0.9999, 1) both"

// FadeOutDown.delay(60 × id): opacity to 0 and translateY 25, 300 ms on Reanimated's default
// curve, Easing.inOut(Easing.quad), as its cubic-bezier.
keyframes modalOut
  to opacity=0 translate="0px 25px"

// rContentStyle: opacity = isActiveStackedModalProgress ** 1.5, the progress springing to 1
// for the front modal. A hidden box translated by progress × 100 px on the same spring is a
// drag timeline these stops follow (host-driven, no commit per frame).
// FadeOutDown, for a modal removed alone (clearModal: the front one, delay 60 × 0). The backdrop
// clears them all with each one's delay 60 × id: an exit animation is one literal, so those stay
// mounted (`leaving`, ids frozen) and play modalOut with their delay (an animation delay holds on
// iOS), and a timer surface unmounts them when the last is done.
fn modalOutOf(id: number): string = `modalOut 300ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%) ${60 * id}ms both`
style ModalOut
  -exact-exit-animation="modalOut 300ms linear(0 0%, 0.00151 2.74878%, 0.00604 5.49756%, 0.0136 8.24634%, 0.02418 10.99512%, 0.03778 13.7439%, 0.0544 16.49267%, 0.07405 19.24145%, 0.09671 21.99023%, 0.1224 24.73901%, 0.15112 27.48779%, 0.18285 30.23657%, 0.21761 32.98535%, 0.25539 35.73413%, 0.29619 38.48291%, 0.34001 41.23169%, 0.38686 43.98047%, 0.43672 46.72924%, 0.48961 49.47802%, 0.54354 52.2268%, 0.59235 54.85316%, 0.64645 57.95563%, 0.69338 60.8449%, 0.73407 63.53561%, 0.77779 66.66788%, 0.81433 69.53109%, 0.84486 72.14835%, 0.87639 75.1389%, 0.90151 77.80834%, 0.92617 80.78685%, 0.94466 83.3656%, 0.96167 86.15639%, 0.97606 89.0596%, 0.98697 91.92756%, 0.99411 94.57274%, 0.9986 97.3515%, 1 100%) both"

keyframes contentPow
  0% opacity=0
  5% opacity=0.0112
  10% opacity=0.0316
  15% opacity=0.0581
  20% opacity=0.0894
  25% opacity=0.125
  30% opacity=0.1643
  35% opacity=0.2071
  40% opacity=0.253
  45% opacity=0.3019
  50% opacity=0.3536
  55% opacity=0.4079
  60% opacity=0.4648
  65% opacity=0.524
  70% opacity=0.5857
  75% opacity=0.6495
  80% opacity=0.7155
  85% opacity=0.7837
  90% opacity=0.8538
  95% opacity=0.9259
  100% opacity=1

// Backdrop: opacity withTiming(any modal ? 1 : 0), 300 ms on Reanimated's default
// Easing.inOut(Easing.quad), from wherever it is. In RN the cards' exits (FadeOutDown) start at
// the Fabric mount, but the backdrop's withTiming only when its useAnimatedStyle mapper re-runs
// after the JS effect: the front card is visibly on its way before the screen clears (RN's
// recording: the card ~20 ms ahead). Here a `transition` started a frame BEFORE the cards'
// exit animations (their translate ~28 ms behind, measured), so all of it read as one fade.
// The backdrop is an `animation` too (in step with the cards' modalIn on open), and its fade out
// waits backdropLagMs() (28 + 20). One 0 → 1 keyframe pair (two names, so a retarget restarts
// it) whose `linear()` outputs are RN's opacities from the current value.
fn backdropLagMs(): number = 48
fn quadStops(): number[] = [0, 0.00151, 0.00604, 0.0136, 0.02418, 0.03778, 0.0544, 0.07405, 0.09671, 0.1224, 0.15112, 0.18285, 0.21761, 0.25539, 0.29619, 0.34001, 0.38686, 0.43672, 0.48961, 0.54354, 0.59235, 0.64645, 0.69338, 0.73407, 0.77779, 0.81433, 0.84486, 0.87639, 0.90151, 0.92617, 0.94466, 0.96167, 0.97606, 0.98697, 0.99411, 0.9986, 1]
fn quadAt(): number[] = [0, 2.74878, 5.49756, 8.24634, 10.99512, 13.7439, 16.49267, 19.24145, 21.99023, 24.73901, 27.48779, 30.23657, 32.98535, 35.73413, 38.48291, 41.23169, 43.98047, 46.72924, 49.47802, 52.2268, 54.85316, 57.95563, 60.8449, 63.53561, 66.66788, 69.53109, 72.14835, 75.1389, 77.80834, 80.78685, 83.3656, 86.15639, 89.0596, 91.92756, 94.57274, 97.3515, 100]
fn inOutQuad(t: number): number = t < 0.5 ? 2 * t * t : 1 - (2 - 2 * t) * (2 - 2 * t) / 2
fn backdropAt(from: number, to: number, start: number, now: number): number = from + (to - from) * inOutQuad(min(1, max(0, (now - start) / 300)))
fn backdropCurve(from: number, to: number): string = `linear(${range(quadStops().length).map(i => `${from + (to - from) * (match quadStops().at(i) { case some(v) => v, case none => 0 })} ${match quadAt().at(i) { case some(v) => v, case none => 0 }}%`).join(", ")})`
keyframes backdropA
  from opacity=0
  to opacity=1
keyframes backdropB
  from opacity=0
  to opacity=1

// use-modal.tsx: createAnimatedPressable buttons, pressed: Dismiss from #d5534a00 to
// #e14f4482, Confirm from #50505000 to #bababa9b; radius 8 continuous; on pressto's progress.

component StackedModals
  props
    env: DemoEnv
  inject
    pressto: PressablesConfig
    pressablesOnPress: action
  // pressto: the pressed pressable (its key) and the press parity.
  state pressing = pressNone()
  action pressIn(key: number)
    pressing = pressDown(pressing, key)
  action pressOut
    pressing = pressUp(pressing)
  state stack = []
  state serial = 0
  // The backdrop's fade: from, to, its start (performanceNow) and a play count (0: none yet).
  state bdFrom = 0
  state bdTo = 0
  state bdStart = 0
  state bdPlay = 0
  state bdDelay = 0
  action fadeBackdrop(to: number, delay: number)
    let now = performanceNow()
    bdFrom = backdropAt(bdFrom, bdTo, bdStart, now)
    bdTo = to
    bdStart = now + delay
    bdDelay = delay
    bdPlay = bdPlay + 1
  // The + button: showNextModal(modals) from the first.
  action open
    pressablesOnPress()
    if stack.length == 0
      fadeBackdrop(1, 0)
    stack = [serial * 10].concat(stack)
    serial = serial + 1
  // Confirm and Dismiss both show the next modal (none after the seventh); the seventh's
  // Dismiss first clears it (clearModal('modal7')).
  action answer(entry: number, dismiss: bool)
    haptic("selection")
    let kept = (dismiss and modalOf(entry) == 6) ? stack.filter(e => modalOf(e) != 6) : stack
    if modalOf(entry) + 1 < 7
      stack = [serial * 10 + modalOf(entry) + 1].concat(kept)
      serial = serial + 1
    else
      stack = kept
      if kept.length == 0
        fadeBackdrop(0, backdropLagMs())
  // Backdrop onTouchEnd: clearAllStackedModals. Each leaves with FadeOutDown.delay(60 × id).
  state leaving = []
  state leaveEnd = 0
  state leaveToken = 0
  state leaveMs = 0
  // On the web the timer publishes its token instead of posting `cleared` (gpu/src/timer.rs):
  // the leaving modals are gone once env.timers holds leaveToken. (Always false on iOS.)
  derive leftWeb = leaveToken != 0 and env.timers.includes(leaveToken)
  derive shownLeaving = leftWeb ? [] : leaving
  action clearAll
    let now = performanceNow()
    let end = max(leftWeb ? 0 : leaveEnd, now + 300 + 60 * max(0, stack.length - 1))
    leaving = shownLeaving.concat(stack.map((e, i) => [e, i]))
    if stack.length > 0
      fadeBackdrop(0, backdropLagMs())
    stack = []
    leaveEnd = end
    leaveMs = end - now
    leaveToken = leaveToken + 1
  action cleared(m: string)
    leaving = []
    leaveEnd = 0
  view
    // index.tsx styles.container: #fefefe, flex 1.
    column position="absolute" inset=0 background-color="#fefefe" overflow="hidden"
      testId="stacked-modals"
      // styles.button: PressableScale, 64 × 64, black, radius 32, absolute at bottom 48,
      // right 20 with marginHorizontal 20; Ionicons "add" 28 white.
      view display="flex" flex-direction="column" position="absolute" bottom=48 right=20 margin-left=20 margin-right=20
        pointerdown=pressIn(0) pointerup=pressOut
        scale=pressableScale(pressing, 0, pressto) transition=pressTransition("scale", pressto)
        width=64 height=64 border-radius=32 background-color="#000000" align-items="center"
        justify-content="center" press=open role="button" aria-label="Show a modal" testId="add"
        // Ionicons "add" 28: the vector-icons glyph (512 × 525 units of 512 to the em).
        svg width=28 height=28.7109 viewBox="0 0 512 525" aria-hidden=true
          path d="M248 105Q248 105 248 105Q253 101 259.5 102.5Q266 104 270 110Q270 110 272 113V179V246H338H404L408 248Q416 253 416 262Q416 271 408 276Q408 276 405 278H339H272V345V411L270 414Q265 422 256 422Q247 422 242 414Q242 414 240 411V345V278H173H107L104 276Q96 271 96 262Q96 253 103 249Q103 249 107 246H173H240V179V113L242 110Q244 107 248 105Z" fill="#ffffff"
      canvas surface=timer(leaveToken, leaveMs) message=cleared width=1 height=1 position="absolute"
        left=0 top=0 aria-hidden=true pointer-events="none"
      // One list, so a modal that starts leaving keeps its instance (no remount).
      for pair in stack.map((e, i) => [e, i, 0]).concat(shownLeaving.map(p => [leaveEntry(p), leaveId(p), 1])) key=(leaveEntry(pair) - modalOf(leaveEntry(pair))) / 10
        Modal(entry=leaveEntry(pair), id=leaveId(pair), width=env.width, height=env.height,
          leaving=(leaveFlag(pair) == 1), confirm=answer(leaveEntry(pair), false),
          dismiss=answer(leaveEntry(pair), true))
      // Backdrop: absoluteFill, #0000006f, opacity withTiming(any modal ? 1 : 0), touchable only
      // then.
      view position="absolute" inset=0 background-color="rgba(0, 0, 0, 0.4353)"
        opacity=(stack.length > 0 ? 1 : 0) pointer-events=(stack.length > 0 ? "auto" : "none")
        animation=(bdPlay == 0 ? "none" : `${bdPlay % 2 == 0 ? "backdropA" : "backdropB"} 300ms ${backdropCurve(bdFrom, bdTo)} ${bdDelay}ms both`)
        press=clearAll
        aria-label="Close all" testId="backdrop"

fn leaveEntry(pair: number[]): number = match pair.at(0) { case some(v) => v, case none => 0 }
fn leaveId(pair: number[]): number = match pair.at(1) { case some(v) => v, case none => 0 }
fn leaveFlag(pair: number[]): number = match pair.at(2) { case some(v) => v, case none => 0 }

component Modal
  props
    entry: number
    id: number
    leaving: bool
    width: number
    height: number
    confirm: action
    dismiss: action
  view
    // stacked-modal.tsx: absolute, windowWidth × 0.8 at left × 0.1, radius 35 continuous,
    // boxShadow 0 0 10px rgba(0,0,0,0.03), zIndex 100 - id; bottom at (windowHeight -
    // MODAL_HEIGHT) / 2 + bottomHeight (the rise below).
    column position="absolute" left=(width * 0.1) width=(width * 0.8)
      bottom=((height - 200) / 2) z-index=(100 - id) class=ModalOut
      pointer-events=(leaving ? "none" : "auto") testId=`modal-${modalOf(entry)}`
      // The clear-all fade (modalOutOf) runs on this inner box, which also carries the visible
      // part (the shadow): when the leaving modal unmounts, the outer box's literal exit replays
      // over nothing.
      column border-radius=35 corner-shape="-exact-continuous"
        box-shadow="0px 0px 10px rgba(0, 0, 0, 0.03)" timeline-scope="--active"
        animation=(leaving ? modalOutOf(id) : "none")
        view position="absolute" left=0 top=0 width=0 height=0 pointer-events="none" aria-hidden=true
          translate=`${id == 0 ? 100 : 0}px 0px` transition=`translate ${modalSpring()}`
          -exact-drag-timeline="--active x"
        // bottom: withCustomSpring(… + bottomHeight) as the id changes.
        column translate=`0px ${0 - bottomHeight(id)}px` transition=`translate ${modalSpring()}`
          // The mount: bottomOffset 110 and baseOpacity.
          column animation=`modalIn ${modalInTiming()}`
            // rVisibleContainerStyle: opacity withCustomSpring(id < 3 ? 1 : 0), translateY
            // withCustomSpring(-id × 5), scale withCustomSpring(1 - id × 0.05); 0.8 w × 200,
            // radius 10 continuous, white. rStackedModalStyle's layer shadow (RN's default
            // shadowOffset 0, -3 and black) springs to radius max(10 - id, 2) (CSS blur twice
            // that) and opacity id > 3 ? 0.1 - id × 0.01 : 0.08; it is the card's.
            column width=(width * 0.8) height=200 border-radius=10 corner-shape="-exact-continuous"
              background-color="#ffffff" opacity=(id < 3 ? 1 : 0) translate=`0px ${0 - id * 5}px`
              scale=(1 - id * 0.05)
              box-shadow=`0px -3px ${2 * max(10 - id, 2)}px rgba(0, 0, 0, ${id > 3 ? 0.1 - id * 0.01 : 0.08})`
              transition=`opacity ${modalSpring()}, translate ${modalSpring()}, scale ${modalSpring()}, box-shadow ${modalSpring()}`
              column flex=1 border-radius=10 corner-shape="-exact-continuous" overflow="hidden"
                column flex=1 animation="contentPow 1s linear both" animation-timeline="--active"
                  animation-range="0px 100px"
                  // The content is rendered for id <= MAX_VISIBLE_MODALS × 1.5.
                  if id <= 4
                    ModalContent(index=modalOf(entry), confirm=confirm, dismiss=dismiss)

component ModalContent
  props
    index: number
    confirm: action
    dismiss: action
  inject
    pressto: PressablesConfig
  // pressto: the pressed button (0 Dismiss, 1 Confirm) and the press parity.
  state pressing = pressNone()
  action pressIn(key: number)
    pressing = pressDown(pressing, key)
  action pressOut
    pressing = pressUp(pressing)
  view
    column flex=1
      // styles.container: white, radius 12 continuous, flex 1, padding 16; header a row,
      // marginBottom 8; title #333 18 bold; message #666 14, marginBottom 12.
      column flex=1 background-color="#ffffff" border-radius=12 corner-shape="-exact-continuous" padding=16
        row align-items="center" margin-bottom=8
          // No lineHeight in RN: TextKit's SF line height, (1950 + 494) / 2048 × size, its
          // baseline at 1950 / 2048 × size (17.14 at 18, 13.33 at 14). Exact puts an authored
          // line's baseline at its rounded ascent plus the floored half-leading (17 and 13), and
          // RN rounds each Text box up to the device pixel (the title 21.48 → 21.67): the
          // relative tops put both baselines back (0.14, which RN's pixel-aligned baseline rounds
          // up to one device pixel, measured; 0.33 + 0.19).
          text titleOf(index) color="#333333" font-size=18 font-weight=700 line-height="21.48046875px"
            position="relative" top=(1 / 3)
        text messageOf(index) color="#666666" font-size=14 line-height="16.70703125px" margin-bottom=12
          position="relative" top=0.52
      // styles.buttonContainer: a row at the end, marginBottom 12, marginRight 12; each button
      // paddingHorizontal 12, paddingVertical 8; text #141414 bold. RN sizes a Text to its
      // TextKit width rounded up to the device pixel (bold 14: "Dismiss" 54.1509 → 163 / 3,
      // "Confirm" 55.7197 → 56 at 3×); the buttons hug their text and the row is right-aligned,
      // so an unrounded width put both labels right of RN's (Confirm by 0.28, Dismiss by 0.46).
      row justify-content="flex-end" margin-bottom=12 margin-right=12
        view display="flex" flex-direction="column" padding-left=12 padding-right=12 padding-top=8 padding-bottom=8
          border-radius=8 corner-shape="-exact-continuous"
          background-color=animatedPressableColor(pressing, 0, "color(display-p3 0.8353 0.3255 0.2902 / 0)", "color(display-p3 0.8824 0.3098 0.2667 / 0.5098)")
          pointerdown=pressIn(0) pointerup=pressOut transition=pressTransition("background-color", pressto)
          align-items="center" justify-content="center" press=dismiss role="button"
          testId=`modal-${index}-dismiss`
          text "Dismiss" color="#141414" font-weight=700 font-size=14 width=(163 / 3) white-space="nowrap"
        view display="flex" flex-direction="column" padding-left=12 padding-right=12 padding-top=8 padding-bottom=8
          border-radius=8 corner-shape="-exact-continuous"
          background-color=animatedPressableColor(pressing, 1, "rgba(80, 80, 80, 0)", "rgba(186, 186, 186, 0.6078)")
          pointerdown=pressIn(1) pointerup=pressOut transition=pressTransition("background-color", pressto)
          align-items="center" justify-content="center" press=confirm role="button"
          testId=`modal-${index}-confirm`
          text "Confirm" color="#141414" font-weight=700 font-size=14 width=56 white-space="nowrap"
