at "/demo/action-tray"

test "the + presents the tray; its button steps through three headings and dismisses it"
  expect tree has "action-tray"
  expect tree has "backdrop-idle"
  tap "toggle"
  clock settle
  expect tree has "backdrop"
  expect text "title" == "Heading 1"
  expect text "continue-label" == "Continue"
  expect tree has "step-0"
  tap "continue"
  clock settle
  expect text "title" == "Heading 2"
  expect text "continue-label" == "Accept 1"
  expect tree has "step-1"
  expect tree missing "step-0"
  tap "continue"
  clock settle
  expect text "title" == "Heading 3"
  expect text "continue-label" == "Accept 2"
  expect tree has "step-2"
  tap "continue"
  clock settle
  expect tree has "backdrop-idle"
  tap "toggle"
  clock settle
  expect text "title" == "Heading 1"

test "the close button and the scrim dismiss the tray"
  tap "toggle"
  clock settle
  tap "continue"
  clock settle
  tap "close"
  clock settle
  expect tree has "backdrop-idle"
  tap "toggle"
  clock settle
  expect text "title" == "Heading 1"
  tap "backdrop"
  clock settle
  expect tree has "backdrop-idle"

