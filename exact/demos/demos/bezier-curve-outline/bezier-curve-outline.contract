// Bezier Curve Outline: a chess square that, pressed, grows as it travels along a cubic Bézier
// and blurs on the way. "Outline Mode" crossfades to the curve itself, whose four control points
// can be dragged. The screen blurs while the button is held. The outline, the square and both
// crossfades are a Rust surface (gpu/src/bezier_curve_outline.rs). The button is here.
use DemoEnv from "../env.contract"
use PressableScale from "pressto"

// The label's ink, from #202020 to white, sampled as stops. The hidden box below drives the
// timeline with the same spring (900 / 120 / 4).
keyframes labelInk
  0% color="#202020"
  1% color="#2B2B2B"
  2% color="#343434"
  3% color="#3B3B3B"
  4% color="#414141"
  5% color="#474747"
  6% color="#4C4C4C"
  7% color="#515151"
  8% color="#555555"
  9% color="#595959"
  10% color="#5D5D5D"
  15% color="#6E6E6E"
  20% color="#7D7D7D"
  25% color="#8A8A8A"
  30% color="#959595"
  35% color="#A0A0A0"
  40% color="#A9A9A9"
  45% color="#B2B2B2"
  50% color="#BBBBBB"
  55% color="#C3C3C3"
  60% color="#CBCBCB"
  65% color="#D2D2D2"
  70% color="#D9D9D9"
  75% color="#E0E0E0"
  80% color="#E7E7E7"
  85% color="#EDEDED"
  90% color="#F3F3F3"
  95% color="#F9F9F9"
  100% color="#FFFFFF"

component BezierCurveOutline
  props
    env: DemoEnv
  state outline = false
  // `held` is true while the button is pressed. It drives the surface's blur.
  state held = false
  action heard(m: string)
    if m == "haptic:selection"
      haptic("selection")
  action pressIn
    held = true
  action pressOut
    held = false
  action toggle
    outline = not outline
  view
    column position="absolute" inset=0 timeline-scope="--outlineMode" testId="bezier-curve-outline"
      view position="absolute" left=0 top=0 width=0 height=0 pointer-events="none" aria-hidden=true
        translate=(outline ? "100px 0px" : "0px 0px") transition="translate -exact-spring(900, 120, 4)"
        -exact-drag-timeline="--outlineMode x"
      // The surface also draws the full-screen blur: intensity 65 while held, 0 otherwise, over 300 ms.
      canvas surface=bezier_curve_outline(outline, held) message=heard position="absolute" top=0 left=0
        width=env.width height=env.height touch-action="none" testId="bezier-curve-outline-canvas"
        aria-label="Press the square; in outline mode, drag the curve's points"
      // The label's ink follows the outline spring.
      row position="absolute" left=0 right=0 bottom=48 justify-content="center" pointer-events="none"
        // The 14 pt label gets a 44 pt touch target: the press box reaches 14 pt past it on each side.
        view pointer-events="auto" margin=-14
          PressableScale(press=toggle)
            row margin=14 pointerdown=pressIn pointerup=pressOut testId="bezier-curve-outline-toggle" text-align="center"
              aria-label="Outline Mode"
              text "Outline Mode" font-size=14 text-align="center" color="#202020"
                animation="labelInk 1s linear both" animation-timeline="--outlineMode" animation-range="0px 100px"
