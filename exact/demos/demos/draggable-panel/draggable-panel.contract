// Draggable Panel: a white "Spring Animations" panel that a pan throws to the nearest screen
// corner on the chosen spring (Elegant, Springy, Super); its close shrinks it into a settings
// button that grows it back. One canvas draws the panel and handles the pan.
use DemoEnv from "../env.contract"

component DraggablePanel
  props
    env: DemoEnv
  // Haptics: a selection per press, and a light impact when the pan takes the panel.
  action heard(m: string)
    if m == "haptic:selection"
      haptic("selection")
    if m == "haptic:impact-light"
      haptic("impact-light")
  view
    canvas surface=draggable_panel(env.safeTop) message=heard position="absolute" top=0 left=0
      width=env.width height=env.height touch-action="none" testId="draggable-panel"
      aria-label="Spring Animations panel: drag it to a corner, pick a spring, close it"
