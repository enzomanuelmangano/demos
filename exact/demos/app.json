{
  "$schema": "../../../../../../.exact/exact2/730abad161c2a5f6cd1f34ea164cda8d9ad6b358/scripts/app.schema.json",
  "name": "Demos",
  "short_name": "Demos",
  "id": "com.reactiive.demos.exact",
  "start_url": "/",
  "display": "standalone",
  "app": {
    "id": "com.reactiive.demos.exact",
    "name": "Demos"
  },
  "modules": [
    "rolling-count",
    "demo-card",
    "glass-button",
    "mate-haptic",
    "swift-slider",
    "painting-menu",
    "variable-blur",
    "glass-pane",
    "inspiration-sheet",
    "audio-track",
    "system-alert",
    "toggle-sheet"
  ],
  "host": {
    "web": {},
    "ios": {
      "minimumOS": "18.0",
      "deviceFamily": [
        "iphone"
      ],
      "localNetworking": "Sends your feedback on a demo to the Mac you build from.",
      "resources": [
        {
          "from": "feedback-host",
          "to": "Resources/feedback-host"
        }
      ]
    },
    "macos": {
      "minimumOS": "14.0",
      "window": {
        "width": 900,
        "height": 700
      }
    }
  },
  "deploy": {
    "store": {
      "web": "0",
      "ios": "0",
      "macos": "0"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "demos-exact",
      "url": "/open?u=%s"
    }
  ],
  "hatches": {
    "launch-icon": [
      "ios"
    ]
  },
  "data": [
    "slug"
  ],
  "commands": {
    "phone": [
      "bun",
      "tools/phone.mjs"
    ]
  }
}
