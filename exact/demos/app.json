{
  "$schema": ".exact/checkout/scripts/app.schema.json",
  "name": "Demos",
  "short_name": "Demos",
  "id": "com.reactiive.demos.exact",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#141414",
  "theme_color": "#141414",
  "color_scheme_dark": {
    "background_color": "#141414",
    "theme_color": "#141414"
  },
  "app": {
    "id": "com.reactiive.demos.exact",
    "name": "Demos"
  },
  "modules": [
    "rolling-count",
    "demo-card",
    "glass-button",
    "mate-haptic",
    "swift-slider",
    "painting-menu",
    "variable-blur",
    "glass-pane",
    "inspiration-sheet",
    "audio-track",
    "system-alert",
    "toggle-sheet",
    "music-tabbar",
    "native-tabbar",
    "page-dots",
    "search-reveal",
    "still-art",
    "icon-grid",
    "motion-feed"
  ],
  "host": {
    "web": {
      "head": [
        {
          "meta": {
            "name": "apple-mobile-web-app-capable",
            "content": "yes"
          }
        },
        {
          "meta": {
            "name": "mobile-web-app-capable",
            "content": "yes"
          }
        },
        {
          "meta": {
            "name": "apple-mobile-web-app-status-bar-style",
            "content": "black-translucent"
          }
        },
        {
          "meta": {
            "name": "apple-mobile-web-app-title",
            "content": "Demos"
          }
        },
        {
          "meta": {
            "name": "format-detection",
            "content": "telephone=no"
          }
        },
        {
          "script": {
            "text": "(function(){var s=document.createElement('style');s.textContent='html,body{overscroll-behavior:none;touch-action:manipulation;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent;background:#141414}body{height:100dvh;overflow:hidden}input,textarea,[contenteditable]{-webkit-user-select:text;user-select:text}';document.head.appendChild(s);var t=matchMedia('(pointer:coarse)');addEventListener('contextmenu',function(e){if(t.matches)e.preventDefault()});document.addEventListener('gesturestart',function(e){e.preventDefault()});})();"
          }
        }
      ]
    },
    "ios": {
      "minimumOS": "18.0",
      "deviceFamily": [
        "iphone"
      ],
      "localNetworking": "Sends your feedback on a demo to the Mac you build from.",
      "resources": [
        {
          "from": "feedback-host",
          "to": "Resources/feedback-host"
        }
      ]
    },
    "macos": {
      "minimumOS": "14.0",
      "window": {
        "width": 900,
        "height": 700
      }
    }
  },
  "deploy": {
    "store": {
      "web": "0",
      "ios": "0",
      "macos": "0"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "demos-exact",
      "url": "/open?u=%s"
    }
  ],
  "hatches": {
    "page-scroller": [
      "ios"
    ]
  },
  "data": [
    "scroller"
  ],
  "before_build": [
    "bun",
    "tools/gpu-images-web.mjs"
  ],
  "commands": {
    "phone": [
      "bun",
      "tools/phone.mjs"
    ]
  },
  "icons": [
    {
      "src": "assets/icon.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
